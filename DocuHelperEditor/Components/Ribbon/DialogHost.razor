@implements IDisposable

@if (_request != null)
{
    <FormDialog Request="_request" Closed="CloseAsync" />
}

@code {
    private DialogPresenter _presenter;
    private DialogRequest _request;

    [Parameter]
    public DialogPresenter Presenter { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Presenter, _presenter))
            return;

        Detach();
        _presenter = Presenter;
        if (_presenter != null)
            _presenter.Requested += Show;
    }

    public void Dispose() => Detach();

    private void Detach()
    {
        if (_presenter != null)
        {
            _presenter.Requested -= Show;
            _presenter.Cancel();
        }

        _presenter = null;
        _request = null;
    }

    private void Show(DialogRequest request)
    {
        _request = request;
        InvokeAsync(StateHasChanged);
    }

    private Task CloseAsync()
    {
        _request = null;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
