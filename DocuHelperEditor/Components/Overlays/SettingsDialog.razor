@using DocuHelperEditor.Components.Overlays.Settings
@inherits StoreComponentBase
@inject IJSRuntime JS
@inject UpdateStore Updates

@if (Settings.IsDialogOpen)
{
    <div class="overlay">
        <div class="backdrop" aria-hidden="true" @onmousedown:preventDefault="true"></div>
        <span class="sr-only" tabindex="0" @onfocus="FocusLastAsync"></span>
        <div id="settings-dialog" class="dialog" role="dialog" aria-modal="true" aria-labelledby="settings-h" tabindex="-1" data-chrome @onkeydown="OnKeyDownAsync">
            <div class="head">
                <span class="badge" aria-hidden="true"><Icon Name="settings" Size="18" Stroke="2.1" /></span>
                <h1 id="settings-h">설정</h1>
                <span class="autosave">바꾸면 바로 저장돼요</span>
                <IconButton Icon="x" IconSize="20" Stroke="2.2" Label="설정 닫기" Title="닫기 (Esc)" id="settings-close" OnClick="CloseAsync" />
            </div>

            <div class="body">
                <nav class="nav" aria-label="설정 항목">
                    <ul>
                        @foreach (var item in s_sections)
                        {
                            var on = Settings.DialogSection == item.Id;
                            <li @key="item.Id">
                                <button type="button" class="nv @(on ? "on" : null)" aria-current="@(on ? "true" : "false")" @onclick="() => Settings.ShowSection(item.Id)">
                                    @if (item.Icon == null)
                                    {
                                        <span class="han" aria-hidden="true">한</span>
                                    }
                                    else
                                    {
                                        <Icon Name="@item.Icon" Size="18" />
                                    }
                                    @item.Name
                                    @if (item.Id == "update" && UpdateBadge != null)
                                    {
                                        <span class="nv-badge">@UpdateBadge</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                </nav>

                <div class="content">
                    @switch (Settings.DialogSection)
                    {
                        case "ai":
                            <AssistantSection Settings="Settings" OnFocusRequest="FocusAsync" />
                            break;

                        case "folder":
                            <FolderSection Settings="Settings" Workspace="Workspace" RecentsCleared="_recentsCleared" OnClearRecents="ClearRecents" />
                            break;

                        case "hwp":
                            <HwpSection Settings="Settings" />
                            break;

                        case "view":
                            <DisplaySection Settings="Settings" />
                            break;

                        case "update":
                            <UpdateSection Settings="Settings" />
                            break;

                        case "about":
                            <AboutSection />
                            break;

                        default:
                            <KeysSection Settings="Settings" OnFocusRequest="FocusAsync" />
                            break;
                    }
                </div>
            </div>
        </div>
        <span class="sr-only" tabindex="0" @onfocus="FocusFirstAsync"></span>
    </div>
}

@code {
    private static readonly (string Id, string Name, string Icon)[] s_sections =
    {
        ("key", "도우미 열쇠", "key-round"),
        ("ai", "도우미", "highlighter"),
        ("folder", "작업 폴더", "folder"),
        ("hwp", "한글 파일", null),
        ("view", "화면", "type"),
        ("update", "업데이트", "download"),
        ("about", "정보", "info"),
    };

    private bool _shown;
    private bool _recentsCleared;
    private string _scrolledSection;

    private string UpdateBadge => Updates.Phase switch
    {
        UpdatePhase.Available => "새 버전",
        UpdatePhase.Ready or UpdatePhase.OnClose => "받음",
        _ => null,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Settings.IsDialogOpen && Settings.DialogSection != _scrolledSection)
        {
            _scrolledSection = Settings.DialogSection;
            try
            {
                await JS.InvokeVoidAsync("docuHelper.scrollToTop", "#settings-dialog .content");
            }
            catch (JSException)
            {
            }
        }

        if (Settings.IsDialogOpen == _shown)
            return;

        _shown = Settings.IsDialogOpen;
        _recentsCleared = false;
        if (_shown)
            await FocusAsync("#settings-close");
    }

    private void ClearRecents()
    {
        Workspace.ClearRecents();
        _recentsCleared = true;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return;

        var focus = Settings.CancelKeyInteraction();
        if (focus != null)
        {
            await FocusAsync(focus);
            return;
        }

        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        var target = Settings.DialogReturnFocus;
        Settings.CloseDialog();
        if (!string.IsNullOrEmpty(target))
            await FocusAsync(target);
    }

    private Task FocusFirstAsync() => FocusAsync("#settings-close");

    private Task FocusLastAsync() => FocusAsync("#settings-dialog .content button:not([disabled]):last-of-type, #settings-close");

    private async Task FocusAsync(string selector)
    {
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("docuHelper.focus", selector);
        }
        catch (JSException)
        {
        }
    }
}
