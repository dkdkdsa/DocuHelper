@inherits StoreComponentBase
@inject IJSRuntime JS

@if (Workspace.IsClosingApp)
{
    <div class="overlay">
        <div class="backdrop" aria-hidden="true" @onmousedown:preventDefault="true"></div>
        <span class="sr-only" tabindex="0" @onfocus="FocusLastAsync"></span>
        <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="close-q" aria-describedby="close-d" tabindex="-1" @onkeydown="OnKeyDown">
            <h2 id="close-q">@Title</h2>
            <p id="close-d" class="desc">@Description</p>
            <div class="actions">
                <ActionButton Kind="ButtonKind.Ghost" Class="cancel" id="close-cancel" OnClick="Cancel">취소</ActionButton>
                @if (Workspace.UnsavedCount > 0)
                {
                    <ActionButton Kind="ButtonKind.Secondary" id="close-without-save" OnClick="CloseWithoutSave">저장 안 하고 닫기</ActionButton>
                    <ActionButton Kind="ButtonKind.Primary" Class="save" id="close-save" OnClick="SaveAndCloseAsync">모두 저장하고 닫기</ActionButton>
                }
                else
                {
                    <ActionButton Kind="ButtonKind.Primary" Class="save" id="close-save" OnClick="StopAndCloseAsync">도우미 멈추고 닫기</ActionButton>
                }
            </div>
        </div>
        <span class="sr-only" tabindex="0" @onfocus="FocusFirstAsync"></span>
    </div>
}

@code {
    private bool _shown;
    private bool _busy;

    private int UnsavedCount => Workspace.UnsavedCount;

    private string Title => UnsavedCount > 0
        ? $"저장 안 한 파일이 {UnsavedCount}개 있어요"
        : "도우미가 일하는 중이에요";

    private string Description => UnsavedCount > 0
        ? (Assistant.IsRunning
            ? "저장하지 않고 닫으면 이 변경은 없어져요. 도우미가 일하는 중이라 닫기 전에 멈춰요."
            : "저장하지 않고 닫으면 이 변경은 없어져요.")
        : "지금 닫으면 도우미 작업이 멈춰요.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Workspace.IsClosingApp)
        {
            _shown = false;
            return;
        }

        if (_shown)
            return;

        _shown = true;
        await JS.InvokeVoidAsync("docuHelper.focus", "#close-save");
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Cancel();
    }

    private void Cancel()
    {
        if (_busy)
            return;

        Workspace.CancelCloseApp();
    }

    private void CloseWithoutSave()
    {
        if (_busy)
            return;

        StopAssistantIfRunning();
        Workspace.CloseAppWithoutSave();
    }

    private async Task SaveAndCloseAsync()
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            StopAssistantIfRunning();
            await Workspace.CloseAppWithSaveAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void StopAndCloseAsync()
    {
        if (_busy)
            return;

        StopAssistantIfRunning();
        Workspace.CloseAppWithoutSave();
    }

    private void StopAssistantIfRunning()
    {
        if (Assistant.IsRunning)
            Assistant.Stop();
    }

    private async Task FocusFirstAsync() => await JS.InvokeVoidAsync("docuHelper.focus", "#close-cancel");

    private async Task FocusLastAsync() => await JS.InvokeVoidAsync("docuHelper.focus", "#close-save");
}
