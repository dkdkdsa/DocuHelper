@inherits StoreComponentBase
@inject IJSRuntime JS

@if (Workspace.IsHistoryOpen)
{
    var file = Workspace.ActiveFile;
    var history = Workspace.ActiveHistory;
    <section id="history-panel" class="history" aria-labelledby="history-h" data-chrome tabindex="-1" @onkeydown="OnKeyDown">
        <div class="head">
            <h2 id="history-h">저장 기록</h2>
            <IconButton Icon="x" IconSize="16" Stroke="2.2" Label="저장 기록 닫기" OnClick="CloseAsync" />
        </div>
        <p class="lead">저장할 때마다 전 상태를 남겨 둬요. 고르면 그때로 돌아가요.</p>
        @if (file == null)
        {
            <p class="empty">지금 연 파일이 없어요. 파일을 열면 그 파일의 기록이 보여요.</p>
        }
        else
        {
            <div class="file">
                <FileTypeIcon Type="@file.Type" Size="20" />
                <span class="file-name">@file.Name</span>
            </div>
            if (history.Count == 0)
            {
                <p class="empty">아직 기록이 없어요. 저장하면 전 상태가 여기에 남아요.</p>
            }
            else
            {
                <ol class="list">
                    @foreach (var entry in history)
                    {
                        var whenId = $"history-when-{entry.Id}";
                        <li class="item" @key="entry.Id">
                            <span class="dot @(entry.IsCurrent ? "now" : null)" aria-hidden="true"></span>
                            <span class="text">
                                <span class="when" id="@whenId">@entry.When</span>
                                <span class="what">@entry.What</span>
                            </span>
                            @if (entry.IsCurrent)
                            {
                                <span class="now-pill">지금 상태</span>
                            }
                            @if (entry.CanRestore)
                            {
                                <ActionButton Kind="ButtonKind.Secondary" Class="restore" aria-describedby="@whenId" OnClick="() => RestoreAsync(entry.Id)">이때로 되돌리기</ActionButton>
                            }
                        </li>
                    }
                </ol>
            }
        }
    </section>
}

@code {
    private const string TriggerSelector = ".app-header button[aria-expanded]";

    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var open = Workspace.IsHistoryOpen;
        if (open == _wasOpen)
            return;

        _wasOpen = open;
        if (open)
            await JS.InvokeVoidAsync("docuHelper.focus", "#history-panel");
    }

    protected override void OnDispose()
    {
        if (Workspace.IsHistoryOpen)
            Workspace.CloseHistory();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await CloseAsync();
    }

    private async Task CloseAsync()
    {
        Workspace.CloseHistory();
        await JS.InvokeVoidAsync("docuHelper.focus", TriggerSelector);
    }

    private async Task RestoreAsync(string historyId)
    {
        await Workspace.RestoreAsync(historyId);
        await CloseAsync();
    }
}
