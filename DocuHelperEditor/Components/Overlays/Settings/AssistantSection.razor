@using System.Globalization
@using DocuHelper.Agents
<section aria-labelledby="settings-ai-h">
    <h2 id="settings-ai-h">도우미</h2>
    <p class="lead">입력창 아래에서 바꾼 것도 여기에 같이 바뀌어요.</p>

    <div class="row">
        <div class="row-head">
            <span class="row-title">기본 모델</span>
            <span class="row-note">비용은 Sonnet 5.5 기준이에요. 열쇠가 있는 회사의 모델만 보여요.</span>
        </div>
        <fieldset class="row-body options">
            <legend class="sr-only">기본 모델</legend>
            @foreach (var provider in s_groups)
            {
                if (Settings.HasKey(provider))
                {
                    <p class="group-label @(provider == AgentProvider.OpenAi ? "gpt" : null)">@GroupName(provider)</p>
                    @foreach (var model in AssistantModels.For(provider))
                    {
                        <RadioOption @key="model.Id" Group="settings-model" Value="@model.Id" Class="compact" Selected="@(Settings.Model.Id == model.Id)" OnSelect="Settings.SetModel">
                            <span class="opt-line">
                                <span class="opt-name">@model.Name</span>
                                @if (model.IsDefault)
                                {
                                    <span class="default-tag">기본</span>
                                }
                                <span class="opt-cost">@model.Cost</span>
                            </span>
                            <span class="opt-note">@model.Description</span>
                        </RadioOption>
                    }
                }
                else
                {
                    <div class="hint">
                        <span class="hint-text">@HintText(provider)</span>
                        <ActionButton Kind="ButtonKind.Secondary" OnClick="() => OpenKeysAsync(provider)">열쇠 넣으러 가기</ActionButton>
                    </div>
                }
            }
        </fieldset>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title">기본 노력</span>
            <span class="row-note">도우미가 얼마나 깊이 생각할지예요. Claude와 ChatGPT 모두 같은 네 단계로 보내요.</span>
        </div>
        <fieldset class="row-body options">
            <legend class="sr-only">기본 노력</legend>
            @foreach (var effort in AssistantModels.Efforts)
            {
                <RadioOption @key="effort.Id" Group="settings-effort" Value="@effort.Id" Class="compact" Selected="@(Settings.EffortId == effort.Id)" OnSelect="Settings.SetEffort">
                    <span class="opt-line">
                        <span class="opt-name">@effort.Name</span>
                        @if (effort.IsDefault)
                        {
                            <span class="default-tag">기본</span>
                        }
                    </span>
                    <span class="opt-note">@effort.Description</span>
                </RadioOption>
            }
        </fieldset>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title">긴 대화 정리</span>
            <span class="row-note">대화가 길어지면 새 부탁을 시작할 때 지난 작업에서 읽은 내용을 비우고 화면에 보인 글만 남겨요. 도우미는 필요한 파일을 다시 읽고 이어서 해요.</span>
        </div>
        <fieldset class="row-body options">
            <legend class="sr-only">긴 대화 정리</legend>
            @foreach (var tokens in SettingsStore.TrimOptions)
            {
                <RadioOption @key="tokens" Group="settings-trim" Value="@tokens.ToString(CultureInfo.InvariantCulture)" Class="compact" Selected="@(Settings.TrimAbove == tokens)" OnSelect="v => Settings.SetTrimAbove(int.Parse(v, CultureInfo.InvariantCulture))">
                    <span class="opt-line">
                        <span class="opt-name">@TrimName(tokens)</span>
                        @if (tokens == SettingsStore.DefaultTrimAbove)
                        {
                            <span class="default-tag">기본</span>
                        }
                    </span>
                </RadioOption>
            }
        </fieldset>
    </div>

    <div class="row center">
        <div class="row-head">
            <label for="settings-ask" class="row-title">큰 변경은 먼저 물어보기</label>
            <span id="settings-ask-d" class="row-note">한 번에 20곳 넘게 바꿀 때 시작하기 전에 확인해요.</span>
        </div>
        <div class="row-body switch-row">
            <input type="checkbox" role="switch" id="settings-ask" class="switch" checked="@Settings.AskBigChanges" aria-describedby="settings-ask-d" @onchange="e => Settings.SetAskBigChanges(IsOn(e))" />
            <span class="switch-text" aria-hidden="true">@OnOff(Settings.AskBigChanges)</span>
        </div>
    </div>

    <div class="row center">
        <div class="row-head">
            <label for="settings-track" class="row-title">워드 변경 내용 추적으로도 남기기</label>
            <span id="settings-track-d" class="row-note">켜면 도우미가 고친 곳이 워드의 ‘변경 내용 추적’에도 남아요.</span>
        </div>
        <div class="row-body switch-row">
            <input type="checkbox" role="switch" id="settings-track" class="switch" checked="@Settings.TrackChanges" aria-describedby="settings-track-d" @onchange="e => Settings.SetTrackChanges(IsOn(e))" />
            <span class="switch-text" aria-hidden="true">@OnOff(Settings.TrackChanges)</span>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public SettingsStore Settings { get; set; }

    [Parameter]
    public EventCallback<string> OnFocusRequest { get; set; }

    private static readonly AgentProvider[] s_groups = { AgentProvider.Claude, AgentProvider.OpenAi };

    private static string GroupName(AgentProvider provider) => provider == AgentProvider.OpenAi ? "ChatGPT" : "Claude";

    private static string HintText(AgentProvider provider) => provider == AgentProvider.OpenAi
        ? "ChatGPT 열쇠를 넣으면 ChatGPT 모델도 여기에 나와요."
        : "Claude 열쇠를 넣으면 Claude 모델도 여기에 나와요.";

    private async Task OpenKeysAsync(AgentProvider provider)
    {
        Settings.ShowSection("key");
        Settings.BeginKeyEdit(provider);
        await OnFocusRequest.InvokeAsync(provider == AgentProvider.OpenAi ? "#settings-openai-key" : "#settings-claude-key");
    }

    private static bool IsOn(ChangeEventArgs e) => e.Value is bool on ? on : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private static string TrimName(int tokens) => tokens > 0 ? $"입력이 {tokens / 10000}만 토큰을 넘으면" : "정리하지 않기";

    private static string OnOff(bool on) => on ? "켜짐" : "꺼짐";
}
