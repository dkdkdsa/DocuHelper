@implements IDisposable
@inject UpdateStore Updates
@using System.Globalization

<section aria-labelledby="settings-update-h">
    <h2 id="settings-update-h">업데이트</h2>
    <p class="lead">새 버전이 나오면 제목 줄에 알려 드려요. 받는 동안에도 하던 일은 계속하면 돼요.</p>

    <div class="row">
        <div class="row-head">
            <span class="row-title">지금 버전</span>
        </div>
        <p class="row-body text num">@CurrentText</p>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title">새 버전</span>
            <span class="row-note">@NoteText</span>
        </div>
        <div class="row-body stack start">
            @switch (Updates.Phase)
            {
                case UpdatePhase.Checking:
                    <p class="status" role="status"><span class="spinner" aria-hidden="true"></span>새 버전이 있는지 보는 중이에요</p>
                    break;

                case UpdatePhase.Available:
                    <div class="card">
                        @if (Updates.DownloadFailed)
                        {
                            <p class="status" role="status">내려받지 못했어요. 다시 해 볼까요?</p>
                        }
                        <h3>@(Updates.Notice.Version) 버전이 나왔어요</h3>
                        <p class="meta">@(Megabytes(Updates.Notice.SizeBytes)) MB, @(Updates.Notice.EstimatedMinutes)분쯤 걸려요.</p>
                        <div class="actions">
                            <ActionButton Kind="ButtonKind.Primary" id="settings-update-get" OnClick="Get">@(Updates.DownloadFailed ? "다시 받기" : "내려받기")</ActionButton>
                        </div>
                    </div>
                    break;

                case UpdatePhase.Downloading:
                    <div class="card">
                        <p class="status" id="settings-update-bar-label">내려받는 중이에요</p>
                        <ProgressBar Value="Updates.Percent" LabelId="settings-update-bar-label" />
                        <p class="meta" role="status">@(Updates.Percent)%, @(Megabytes(Updates.Notice.SizeBytes)) MB 중 @(Megabytes(Updates.DownloadedBytes)) MB</p>
                        <div class="actions">
                            <ActionButton Kind="ButtonKind.Secondary" OnClick="Cancel">그만 받기</ActionButton>
                        </div>
                    </div>
                    break;

                case UpdatePhase.Ready:
                    <p class="status"><Icon Name="check" Size="18" Stroke="2.4" /> 다 받았어요</p>
                    <p class="text">다시 시작하면 @(Updates.Notice.Version) 버전으로 바뀌어요. 열려 있던 파일과 대화는 그대로 다시 열려요.</p>
                    <div class="actions">
                        @if (Updates.CanRestartNow)
                        {
                            <ActionButton Kind="ButtonKind.Primary" id="settings-update-restart" OnClick="Restart">지금 다시 시작</ActionButton>
                        }
                        <ActionButton Kind="ButtonKind.Secondary" id="settings-update-onclose" OnClick="ScheduleOnClose">닫을 때 바꾸기</ActionButton>
                    </div>
                    break;

                case UpdatePhase.OnClose:
                    <p class="status"><Icon Name="check" Size="18" Stroke="2.4" /> 앱을 닫을 때 @(Updates.Notice.Version) 버전으로 바뀌어요</p>
                    @if (Updates.CanRestartNow)
                    {
                        <div class="actions">
                            <ActionButton Kind="ButtonKind.Secondary" OnClick="Restart">지금 다시 시작</ActionButton>
                        </div>
                    }
                    break;

                case UpdatePhase.Restarting:
                    <p class="status"><span class="spinner" aria-hidden="true"></span>다시 시작하는 중이에요</p>
                    break;

                default:
                    @if (!Updates.IsInstalled)
                    {
                        <p class="text">개발용으로 켜져 있어서 업데이트를 확인하지 않아요.</p>
                    }
                    else if (Updates.CheckFailed)
                    {
                        <p class="status">지금은 확인하지 못했어요. 인터넷을 확인한 다음 다시 눌러 주세요.</p>
                    }
                    else if (Updates.Phase == UpdatePhase.Latest)
                    {
                        <p class="status"><Icon Name="check" Size="18" Stroke="2.4" /> 최신 버전이에요</p>
                    }
                    <div class="actions">
                        <ActionButton Kind="ButtonKind.Secondary" id="settings-update-check" Disabled="!Updates.IsInstalled" aria-disabled="@(CheckBusy ? "true" : "false")" OnClick="Check">지금 확인</ActionButton>
                    </div>
                    break;
            }
        </div>
    </div>

    <div class="row center">
        <div class="row-head">
            <label for="settings-update-check-switch" class="row-title">새 버전 확인하기</label>
            <span id="settings-update-check-d" class="row-note">인터넷이 안 되면 조용히 넘어가요.</span>
        </div>
        <div class="row-body switch-row">
            <input type="checkbox" role="switch" id="settings-update-check-switch" class="switch" checked="@Settings.UpdateCheck" aria-describedby="settings-update-check-d" @onchange="e => Settings.SetUpdateCheck(IsOn(e))" />
            <span class="switch-text" aria-hidden="true">@OnOff(Settings.UpdateCheck)</span>
        </div>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title" id="settings-update-auto-h">받는 방법</span>
        </div>
        <fieldset class="row-body options" aria-labelledby="settings-update-auto-h">
            <RadioOption Group="settings-update-auto" Value="auto" Label="알아서 받아 두고, 닫을 때 바꾸기" Detail="따로 누를 게 없어요. 다음에 켜면 새 버전이에요" Class="compact" Selected="Settings.UpdateAuto" OnSelect="SetAuto" />
            <RadioOption Group="settings-update-auto" Value="notify" Label="새 버전이 있다고 알려만 주기" Detail="받을지는 그때 정해요" Class="compact" Selected="!Settings.UpdateAuto" OnSelect="SetAuto" />
        </fieldset>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title">마지막 확인</span>
        </div>
        <p class="row-body text num">@LastCheckedText</p>
    </div>
</section>

@code {
    [Parameter]
    public SettingsStore Settings { get; set; }

    private static readonly CultureInfo s_korean = CultureInfo.GetCultureInfo("ko-KR");

    private string CurrentText => Updates.IsInstalled ? $"문서 도우미 {Updates.CurrentVersion}" : "개발용";

    private bool CheckBusy => Updates.Phase == UpdatePhase.Checking;

    private string NoteText => Updates.Phase is UpdatePhase.Available or UpdatePhase.Downloading or UpdatePhase.Ready or UpdatePhase.OnClose or UpdatePhase.Restarting
        ? "받는 동안 하던 일을 멈추지 않아요."
        : "켤 때마다 알아서 확인해요.";

    private string LastCheckedText => Updates.LastCheckedAt is DateTime when
        ? when.ToString("yyyy년 M월 d일 tt h:mm", s_korean)
        : "아직 확인하지 않았어요";

    protected override void OnInitialized() => Updates.Changed += OnChanged;

    public void Dispose() => Updates.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private static bool IsOn(ChangeEventArgs e) => e.Value is bool on ? on : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private static string OnOff(bool on) => on ? "켜짐" : "꺼짐";

    private static string Megabytes(long bytes) => (bytes / 1048576.0).ToString("0.0", CultureInfo.InvariantCulture);

    private void SetAuto(string value) => Settings.SetUpdateAuto(value == "auto");

    private void Check()
    {
        if (CheckBusy)
            return;

        _ = Updates.CheckNowAsync();
    }

    private void Get() => _ = Updates.DownloadAsync();

    private void Cancel() => Updates.Cancel();

    private void ScheduleOnClose() => Updates.ScheduleOnClose();

    private void Restart() => Updates.RestartNow();
}
