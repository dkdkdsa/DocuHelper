@using System.Globalization
@using DocuHelper.Agents
<section aria-labelledby="settings-key-h">
    <h2 id="settings-key-h">도우미 열쇠</h2>
    <p class="lead">Claude나 ChatGPT 열쇠 중 하나만 있어도 돼요. 둘 다 넣으면 모델을 골라 쓸 수 있어요.</p>

    <div class="row">
        <div class="row-head">
            <span class="row-title-line">
                <span class="row-title">Claude 열쇠</span>
                <ProviderBadge Text="Anthropic" />
            </span>
            <span class="row-note">@ClaudeNote</span>
        </div>
        <div class="row-body stack">
            @if (ClaudeSlot.HasKey)
            {
                <p class="state" role="status">
                    @switch (ClaudeSlot.State)
                    {
                        case KeyCheckState.Ok:
                            <span class="check" aria-hidden="true"><Icon Name="check" Size="11" Stroke="3.6" /></span>
                            <span>연결됐어요</span>
                            break;
                        case KeyCheckState.Checking:
                            <Spinner Size="16" />
                            <span>연결되는지 확인하고 있어요…</span>
                            break;
                        case KeyCheckState.Failed:
                            <span class="check off" aria-hidden="true"><Icon Name="x" Size="11" Stroke="3.6" /></span>
                            <span>연결이 안 됐어요</span>
                            break;
                        case KeyCheckState.Unverified:
                            <span class="check off" aria-hidden="true"><Icon Name="x" Size="11" Stroke="3.6" /></span>
                            <span>확인하지 못했어요</span>
                            break;
                        default:
                            <span>아직 확인 안 했어요</span>
                            break;
                    }
                </p>
            }

            @if (ClaudeSlot.IsEditing)
            {
                <label class="field-label" for="settings-claude-key">@ClaudeLabel</label>
                <div class="fld">
                    <input id="settings-claude-key" type="password" value="@ClaudeSlot.NewKey" placeholder="sk-ant-로 시작해요" autocomplete="off" spellcheck="false" aria-describedby="settings-claude-msg" @oninput="e => Settings.SetNewKey(AgentProvider.Claude, e.Value?.ToString())" @onkeydown="OnClaudeKeyDownAsync" />
                </div>
                <p id="settings-claude-msg" class="key-msg @(IsWarning(ClaudeSlot.NewState) ? "warn" : null)" role="status">
                    @if (ClaudeSlot.NewState == KeyCheckState.Checking)
                    {
                        <Spinner Size="14" />
                        <span>연결되는지 확인하고 있어요…</span>
                    }
                    else if (ClaudeSlot.NewState == KeyCheckState.Failed)
                    {
                        <span>@ClaudeFailedText</span>
                    }
                    else if (ClaudeSlot.NewState == KeyCheckState.Unverified)
                    {
                        <span>@UnverifiedText</span>
                    }
                </p>
                @if (ClaudeSlot.NewState == KeyCheckState.Unverified)
                {
                    <div class="buttons">
                        <ActionButton Kind="ButtonKind.Secondary" id="settings-claude-save-unverified" OnClick="SaveUnverifiedClaudeAsync">그대로 저장</ActionButton>
                    </div>
                }
                <div class="buttons">
                    <ActionButton Kind="ButtonKind.Primary" id="settings-claude-save" Disabled="@(!CanConfirmClaude(ClaudeSlot))" OnClick="ConfirmClaudeAsync">@(ClaudeSlot.HasKey ? "연결 확인하고 바꾸기" : "연결 확인하고 저장")</ActionButton>
                    <ActionButton Kind="ButtonKind.Ghost" id="settings-claude-cancel" OnClick="CancelClaudeAsync">취소</ActionButton>
                </div>
            }
            else if (ClaudeSlot.HasKey)
            {
                <div class="inline">
                    <p class="masked">@AgentKeys.Mask(ClaudeSlot.Key)</p>
                    <div class="buttons">
                        <ActionButton Kind="ButtonKind.Secondary" id="settings-claude-change" OnClick="BeginClaudeAsync">열쇠 바꾸기</ActionButton>
                        <ActionButton Kind="ButtonKind.Secondary" id="settings-claude-verify" Disabled="@(ClaudeSlot.State == KeyCheckState.Checking)" OnClick="VerifyClaudeAsync">연결 확인</ActionButton>
                    </div>
                </div>
            }
            else
            {
                <p class="none">아직 넣지 않았어요</p>
                <div class="buttons">
                    <ActionButton Kind="ButtonKind.Secondary" id="settings-claude-add" OnClick="BeginClaudeAsync">Claude 열쇠 넣기</ActionButton>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title-line">
                <span class="row-title">ChatGPT 열쇠</span>
                <ProviderBadge Text="OpenAI" />
            </span>
            <span class="row-note">@OpenAiNote</span>
        </div>
        <div class="row-body stack">
            @if (OpenAiSlot.HasKey)
            {
                <p class="state" role="status">
                    @switch (OpenAiSlot.State)
                    {
                        case KeyCheckState.Ok:
                            <span class="check" aria-hidden="true"><Icon Name="check" Size="11" Stroke="3.6" /></span>
                            <span>연결됐어요</span>
                            break;
                        case KeyCheckState.Checking:
                            <Spinner Size="16" />
                            <span>연결되는지 확인하고 있어요…</span>
                            break;
                        case KeyCheckState.Failed:
                            <span class="check off" aria-hidden="true"><Icon Name="x" Size="11" Stroke="3.6" /></span>
                            <span>연결이 안 됐어요</span>
                            break;
                        case KeyCheckState.Unverified:
                            <span class="check off" aria-hidden="true"><Icon Name="x" Size="11" Stroke="3.6" /></span>
                            <span>확인하지 못했어요</span>
                            break;
                        default:
                            <span>아직 확인 안 했어요</span>
                            break;
                    }
                </p>
            }

            @if (OpenAiSlot.IsEditing)
            {
                <label class="field-label" for="settings-openai-key">ChatGPT 열쇠</label>
                <div class="fld">
                    <input id="settings-openai-key" type="password" value="@OpenAiSlot.NewKey" placeholder="sk-proj- 또는 sk-로 시작해요" autocomplete="off" spellcheck="false" aria-describedby="settings-openai-tip" @oninput="e => Settings.SetNewKey(AgentProvider.OpenAi, e.Value?.ToString())" @onkeydown="OnOpenAiKeyDownAsync" />
                </div>
                <p id="settings-openai-tip" class="tip @(IsClaudeText(OpenAiSlot.NewKey) ? "warn" : null)">@OpenAiTip</p>
                <p id="settings-openai-msg" class="key-msg @(IsWarning(OpenAiSlot.NewState) ? "warn" : null)" role="status">
                    @if (OpenAiSlot.NewState == KeyCheckState.Checking)
                    {
                        <Spinner Size="14" />
                        <span>연결되는지 확인하고 있어요…</span>
                    }
                    else if (OpenAiSlot.NewState == KeyCheckState.Failed)
                    {
                        <span>연결이 안 됐어요. 열쇠가 맞는지 다시 봐 주세요.</span>
                    }
                    else if (OpenAiSlot.NewState == KeyCheckState.Unverified)
                    {
                        <span>@UnverifiedText</span>
                    }
                </p>
                @if (OpenAiSlot.NewState == KeyCheckState.Unverified)
                {
                    <div class="buttons">
                        <ActionButton Kind="ButtonKind.Secondary" id="settings-openai-save-unverified" OnClick="SaveUnverifiedOpenAiAsync">그대로 저장</ActionButton>
                    </div>
                }
                <div class="buttons">
                    <ActionButton Kind="ButtonKind.Primary" id="settings-openai-save" Disabled="@(!CanConfirmOpenAi(OpenAiSlot))" OnClick="ConfirmOpenAiAsync">연결 확인하고 저장</ActionButton>
                    <ActionButton Kind="ButtonKind.Ghost" id="settings-openai-cancel" OnClick="CancelOpenAiAsync">취소</ActionButton>
                </div>
            }
            else if (OpenAiSlot.HasKey)
            {
                <div class="inline">
                    <p class="masked">@AgentKeys.Mask(OpenAiSlot.Key)</p>
                    <div class="buttons">
                        <ActionButton Kind="ButtonKind.Secondary" id="settings-openai-verify" Disabled="@(OpenAiSlot.State == KeyCheckState.Checking)" OnClick="VerifyOpenAiAsync">연결 확인</ActionButton>
                        <button type="button" id="settings-openai-delete" class="danger" @onclick="AskDeleteOpenAiAsync">지우기</button>
                    </div>
                </div>

                @if (OpenAiSlot.IsConfirmingDelete)
                {
                    <div class="confirm" role="alertdialog" aria-labelledby="settings-openai-delete-q">
                        <p id="settings-openai-delete-q" class="confirm-q">열쇠를 지울까요? 지금 켜 둔 동안은 계속 쓸 수 있어요.</p>
                        <div class="buttons">
                            <ActionButton Kind="ButtonKind.Ghost" id="settings-openai-delete-cancel" OnClick="CancelDeleteOpenAiAsync">취소</ActionButton>
                            <button type="button" id="settings-openai-delete-confirm" class="danger" @onclick="DeleteOpenAiAsync">지우기</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="none">아직 넣지 않았어요</p>
                <div class="buttons">
                    <ActionButton Kind="ButtonKind.Secondary" id="settings-openai-add" OnClick="BeginOpenAiAsync">ChatGPT 열쇠 넣기</ActionButton>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title">저장 위치</span>
            <span class="row-note">이 컴퓨터의 문서 도우미 설정 폴더</span>
        </div>
        <p class="row-body text icon-text">
            <Icon Name="lock" Size="17" />
            <span>열쇠마다 암호를 걸어 저장해서 이 컴퓨터, 지금 쓰는 윈도우 계정에서만 열려요. 업데이트해도 그대로 남아요.</span>
        </p>
    </div>

    @if (ClaudeSlot.HasKey)
    {
        <div class="row">
            <div class="row-head">
                <span class="row-title">Claude 열쇠 지우기</span>
                <span class="row-note">두 열쇠를 다 지우면 다음에 켤 때 처음 시작 화면이 다시 나와요.</span>
            </div>
            <div class="row-body stack start">
                @if (ClaudeSlot.IsConfirmingDelete)
                {
                    <div class="confirm" role="alertdialog" aria-labelledby="settings-claude-delete-q">
                        <p id="settings-claude-delete-q" class="confirm-q">열쇠를 지울까요? 지금 켜 둔 동안은 계속 쓸 수 있어요.</p>
                        <div class="buttons">
                            <ActionButton Kind="ButtonKind.Ghost" id="settings-claude-delete-cancel" OnClick="CancelDeleteClaudeAsync">취소</ActionButton>
                            <button type="button" id="settings-claude-delete-confirm" class="danger" @onclick="DeleteClaudeAsync">지우기</button>
                        </div>
                    </div>
                }
                else
                {
                    <button type="button" id="settings-claude-delete" class="danger" @onclick="AskDeleteClaudeAsync">Claude 열쇠 지우기</button>
                }
            </div>
        </div>
    }
</section>

@code {
    private static readonly CultureInfo s_korean = CultureInfo.GetCultureInfo("ko-KR");

    private AgentProvider? _savedNow;

    [Parameter]
    public SettingsStore Settings { get; set; }

    [Parameter]
    public EventCallback<string> OnFocusRequest { get; set; }

    private KeySlot ClaudeSlot => Settings.SlotFor(AgentProvider.Claude);

    private KeySlot OpenAiSlot => Settings.SlotFor(AgentProvider.OpenAi);

    private string ClaudeLabel => ClaudeSlot.HasKey ? "새 Claude 열쇠" : "Claude 열쇠";

    private string ClaudeFailedText => ClaudeSlot.HasKey
        ? "연결이 안 됐어요. 열쇠가 맞는지 다시 봐 주세요. 지금 열쇠는 그대로예요."
        : "연결이 안 됐어요. 열쇠가 맞는지 다시 봐 주세요.";

    private string ClaudeNote
    {
        get
        {
            if (_savedNow == AgentProvider.Claude)
                return "방금 새 열쇠로 바꿨어요";

            return ClaudeSlot.HasKey ? CheckedNote(ClaudeSlot) : "Claude 모델을 쓰고 싶을 때 넣어요.";
        }
    }

    private string OpenAiNote
    {
        get
        {
            if (_savedNow == AgentProvider.OpenAi)
                return "방금 연결했어요";

            return OpenAiSlot.HasKey ? CheckedNote(OpenAiSlot) : "ChatGPT 모델을 쓰고 싶을 때만 넣어요";
        }
    }

    private string OpenAiTip => IsClaudeText(OpenAiSlot.NewKey)
        ? "이건 Claude 열쇠예요. 위 Claude 칸에 넣어 주세요."
        : "OpenAI에서 받은 열쇠예요. 연결이 확인되면 저장돼요.";

    private static bool CanConfirmClaude(KeySlot slot)
    {
        var key = slot.NewKey.Trim();
        return key.StartsWith("sk-ant-", StringComparison.Ordinal) && key.Length > 12 && slot.NewState != KeyCheckState.Checking;
    }

    private static bool CanConfirmOpenAi(KeySlot slot)
    {
        var key = slot.NewKey.Trim();
        return key.Length > 8 && !IsClaudeText(key) && slot.NewState != KeyCheckState.Checking;
    }

    private const string UnverifiedText = "열쇠는 맞는 것 같지만 확인 권한이 없어요. 그대로 저장할까요?";

    private static bool IsWarning(KeyCheckState state) => state is KeyCheckState.Failed or KeyCheckState.Unverified;

    private static bool IsClaudeText(string text) => (text ?? string.Empty).Trim().StartsWith("sk-ant-", StringComparison.Ordinal);

    private static string CheckedNote(KeySlot slot) => slot.CheckedAt is DateTime at
        ? $"{FormatWhen(at)}에 확인했어요"
        : "[연결 확인]을 누르면 바로 확인해요.";

    private static string FormatWhen(DateTime time)
    {
        var clock = time.ToString("tt h:mm", s_korean);
        return time.Date == DateTime.Today ? $"오늘 {clock}" : $"{time.Month}월 {time.Day}일 {clock}";
    }

    private async Task BeginClaudeAsync()
    {
        _savedNow = null;
        Settings.BeginKeyEdit(AgentProvider.Claude);
        await OnFocusRequest.InvokeAsync("#settings-claude-key");
    }

    private async Task CancelClaudeAsync()
    {
        Settings.CancelKeyEdit(AgentProvider.Claude);
        await OnFocusRequest.InvokeAsync(ClaudeSlot.HasKey ? "#settings-claude-change" : "#settings-claude-add");
    }

    private async Task ConfirmClaudeAsync()
    {
        if (!CanConfirmClaude(ClaudeSlot) || !await Settings.ConfirmNewKeyAsync(AgentProvider.Claude))
            return;

        _savedNow = AgentProvider.Claude;
        await OnFocusRequest.InvokeAsync("#settings-claude-change");
    }

    private async Task OnClaudeKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.IsComposing)
            await ConfirmClaudeAsync();
    }

    private async Task SaveUnverifiedClaudeAsync()
    {
        if (!Settings.SaveUnverifiedKey(AgentProvider.Claude))
            return;

        _savedNow = AgentProvider.Claude;
        await OnFocusRequest.InvokeAsync("#settings-claude-change");
    }

    private async Task SaveUnverifiedOpenAiAsync()
    {
        if (!Settings.SaveUnverifiedKey(AgentProvider.OpenAi))
            return;

        _savedNow = AgentProvider.OpenAi;
        await OnFocusRequest.InvokeAsync("#settings-openai-delete");
    }

    private async Task VerifyClaudeAsync()
    {
        _savedNow = null;
        await Settings.VerifyKeyAsync(AgentProvider.Claude);
    }

    private async Task AskDeleteClaudeAsync()
    {
        _savedNow = null;
        Settings.AskDeleteKey(AgentProvider.Claude);
        await OnFocusRequest.InvokeAsync("#settings-claude-delete-cancel");
    }

    private async Task CancelDeleteClaudeAsync()
    {
        Settings.CancelDeleteKey(AgentProvider.Claude);
        await OnFocusRequest.InvokeAsync("#settings-claude-delete");
    }

    private async Task DeleteClaudeAsync()
    {
        var deleted = Settings.DeleteKey(AgentProvider.Claude);
        await OnFocusRequest.InvokeAsync(deleted ? "#settings-claude-add" : "#settings-claude-change");
    }

    private async Task BeginOpenAiAsync()
    {
        _savedNow = null;
        Settings.BeginKeyEdit(AgentProvider.OpenAi);
        await OnFocusRequest.InvokeAsync("#settings-openai-key");
    }

    private async Task CancelOpenAiAsync()
    {
        Settings.CancelKeyEdit(AgentProvider.OpenAi);
        await OnFocusRequest.InvokeAsync(OpenAiSlot.HasKey ? "#settings-openai-delete" : "#settings-openai-add");
    }

    private async Task ConfirmOpenAiAsync()
    {
        if (!CanConfirmOpenAi(OpenAiSlot) || !await Settings.ConfirmNewKeyAsync(AgentProvider.OpenAi))
            return;

        _savedNow = AgentProvider.OpenAi;
        await OnFocusRequest.InvokeAsync("#settings-openai-delete");
    }

    private async Task OnOpenAiKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.IsComposing)
            await ConfirmOpenAiAsync();
    }

    private async Task VerifyOpenAiAsync()
    {
        _savedNow = null;
        await Settings.VerifyKeyAsync(AgentProvider.OpenAi);
    }

    private async Task AskDeleteOpenAiAsync()
    {
        _savedNow = null;
        Settings.AskDeleteKey(AgentProvider.OpenAi);
        await OnFocusRequest.InvokeAsync("#settings-openai-delete-cancel");
    }

    private async Task CancelDeleteOpenAiAsync()
    {
        Settings.CancelDeleteKey(AgentProvider.OpenAi);
        await OnFocusRequest.InvokeAsync("#settings-openai-delete");
    }

    private async Task DeleteOpenAiAsync()
    {
        var deleted = Settings.DeleteKey(AgentProvider.OpenAi);
        await OnFocusRequest.InvokeAsync(deleted ? "#settings-openai-add" : "#settings-openai-delete");
    }
}
