<section aria-labelledby="settings-hwp-h">
    <h2 id="settings-hwp-h">한글 파일</h2>
    <p class="lead">한글(.hwp, .hwpx) 파일을 고치고 저장하는 방법이에요.</p>

    <div class="row">
        <div class="row-head">
            <span class="row-title">이 컴퓨터의 한글</span>
            <span class="row-note">켤 때마다 알아서 찾아봐요.</span>
        </div>
        <div class="row-body stack">
            @if (Settings.IsHancomInstalled)
            {
                <p class="state"><span class="check" aria-hidden="true"><Icon Name="check" Size="11" Stroke="3.6" /></span>한글이 깔려 있어요</p>
                <span class="row-note">그래서 .hwp 파일도 고친 뒤 .hwp 그대로 저장할 수 있어요.</span>
            }
            else
            {
                <p class="state"><span class="check off" aria-hidden="true"><Icon Name="x" Size="11" Stroke="3.6" /></span>한글을 찾지 못했어요</p>
                <span class="row-note">.hwp 파일은 읽고 고칠 수 있지만, 저장은 .hwpx로 따로 해요. 원래 .hwp 파일은 그대로 있어요.</span>
            }
        </div>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title">저장하면 빠지는 것</span>
            <span class="row-note">@DocuHelper.Importers.Hwp.HwpLimits.SettingsNote()</span>
        </div>
    </div>
    <div class="row">
        <div class="row-head">
            <span class="row-title">고친 한글 파일 저장</span>
            <span class="row-note">저장 기록에는 늘 원래 형식으로 남아요.</span>
        </div>
        <fieldset class="row-body options">
            <legend class="sr-only">고친 한글 파일 저장</legend>
            <RadioOption Group="settings-hwp-save" Value="same" Class="compact" Selected="@(!Settings.HwpAlwaysHwpx)" OnSelect="_ => Settings.SetHwpAlwaysHwpx(false)">
                <span class="opt-line">
                    <span class="opt-name">받은 형식 그대로</span>
                    <span class="default-tag">기본</span>
                </span>
                <span class="opt-note">.hwp는 .hwp로, .hwpx는 .hwpx로</span>
            </RadioOption>
            <RadioOption Group="settings-hwp-save" Value="hwpx" Class="compact" Selected="@Settings.HwpAlwaysHwpx" OnSelect="_ => Settings.SetHwpAlwaysHwpx(true)">
                <span class="opt-line">
                    <span class="opt-name">늘 .hwpx로</span>
                </span>
                <span class="opt-note">새 형식이에요. 한글 2010 이후에서 열려요</span>
            </RadioOption>
        </fieldset>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title">새로 만드는 한글 파일</span>
            <span class="row-note">[새 파일]로 만들 때 쓰는 형식이에요.</span>
        </div>
        <fieldset class="row-body options">
            <legend class="sr-only">새로 만드는 한글 파일</legend>
            <RadioOption Group="settings-hwp-new" Value="hwpx" Class="compact" Selected="@(!Settings.HwpNewAsHwp)" OnSelect="_ => Settings.SetHwpNewAsHwp(false)">
                <span class="opt-line">
                    <span class="opt-name">.hwpx</span>
                    <span class="default-tag">기본</span>
                </span>
                <span class="opt-note">요즘 한글이 기본으로 저장하는 형식이에요</span>
            </RadioOption>
            <RadioOption Group="settings-hwp-new" Value="hwp" Class="compact" Selected="@Settings.HwpNewAsHwp" OnSelect="_ => Settings.SetHwpNewAsHwp(true)">
                <span class="opt-line">
                    <span class="opt-name">.hwp</span>
                </span>
                <span class="opt-note">@(Settings.IsHancomInstalled ? "아주 옛날 한글을 쓰는 곳에 보낼 때" : "아주 옛날 한글을 쓰는 곳에 보낼 때. 한글이 깔려 있어야 해요")</span>
            </RadioOption>
        </fieldset>
    </div>

    <div class="row">
        <div class="row-head">
            <span class="row-title">화면에 보이는 모양</span>
        </div>
        <p class="row-body text">표, 글자, 문단은 그대로 보이고 그림, 수식, 머리말 같은 건 화면에 안 보여요. 정확한 모양은 문서 위 [한글에서 열기]로 볼 수 있어요.</p>
    </div>
</section>

@code {
    [Parameter]
    public SettingsStore Settings { get; set; }
}
