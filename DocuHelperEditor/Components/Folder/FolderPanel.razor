@inherits StoreComponentBase
@inject IFileDialogService FileDialog
@inject IJSRuntime JS
@inject NavigationManager Navigation

<aside class="folder" aria-label="작업 폴더" data-region="folder" data-chrome>
    <div class="head">
        <div class="title">
            <span class="kicker">작업 폴더</span>
            <span class="folder-name">@Workspace.FolderName</span>
        </div>
        <IconButton Icon="chevrons-up-down" IconSize="18" Label="다른 작업 폴더 열기" Title="다른 작업 폴더 열기" OnClick="SwitchFolder" />
        <IconButton Icon="panel-left-close" IconSize="18" Label="파일 목록 접기" id="folder-files-close" aria-expanded="true" OnClick="Collapse" />
    </div>
    @if (HasFiles)
    {
        var focusId = RegionFocusId;
        <p class="count">파일 @(Workspace.Files.Count)개</p>
        <ul class="list" aria-label="파일">
            @foreach (var file in Workspace.Files)
            {
                <FileListItem @key="file.Id"
                              File="file"
                              Active="@IsActive(file)"
                              MenuOpen="@(file.Id == _menuFileId)"
                              RegionFocus="@(file.Id == focusId)"
                              OnMenuOpen="OpenMenu"
                              OnMenuClose="CloseMenu" />
            }
        </ul>
    }
    else
    {
        <div class="empty">
            <p class="empty-title">아직 파일이 없어요</p>
            <p class="empty-text">가운데로 끌어다 놓거나 아래 버튼으로 새로 만들어 주세요. 파일은 여기에 쌓여요.</p>
        </div>
    }
    <div class="foot">
        <div class="foot-row">
            <button type="button" id="folder-new-file" class="import" @onclick="NewFile">
                <Icon Name="file-plus" Size="18" />
                새 파일
            </button>
            <button type="button" class="import" @onclick="ImportAsync">
                <Icon Name="import" Size="18" />
                파일 넣기
            </button>
        </div>
        @if (HasFiles)
        {
            <span class="hint">여기로 끌어다 놓아도 돼요</span>
        }
    </div>
</aside>

@code {
    private string _menuFileId;
    private bool _importing;

    private bool HasFiles => Workspace.Files.Count > 0;

    private string RegionFocusId
    {
        get
        {
            var active = Workspace.ActiveFile;
            if (active != null && Workspace.FindFile(active.Id) != null)
                return active.Id;

            return Workspace.Files.Count > 0 ? Workspace.Files[0].Id : null;
        }
    }

    private bool IsActive(WorkspaceFile file) => Workspace.ActiveFile != null && Workspace.ActiveFile.Id == file.Id;

    private void Collapse() => Workspace.ToggleFolderWithFocus();

    private void SwitchFolder()
    {
        if (Workspace.CanLeaveWorkspace())
            Navigation.NavigateTo("home");
    }

    private void NewFile() => Workspace.OpenNewFile("#folder-new-file");

    private void OpenMenu(string fileId) => _menuFileId = fileId;

    private void CloseMenu() => _menuFileId = null;

    private async Task ImportAsync()
    {
        if (_importing)
            return;

        _importing = true;
        try
        {
            var paths = await FileDialog.PickDocumentsAsync();
            if (paths != null && paths.Count > 0)
                await Workspace.ImportAsync(paths);
        }
        finally
        {
            _importing = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Workspace.TakeFolderToggleFocus())
            await JS.InvokeVoidAsync("docuHelper.focus", "#folder-files-close");
    }
}
