@inherits StoreComponentBase
@inject IFileDialogService FileDialog
@inject IJSRuntime JS

<aside class="rail" aria-label="작업 폴더, 접힘" data-region="folder" data-chrome>
    <IconButton Icon="panel-left-open" IconSize="18" Label="파일 목록 펼치기" id="folder-files-open" aria-expanded="false" OnClick="Expand" />
    <span class="divider" aria-hidden="true"></span>
    @if (Workspace.Files.Count > 0)
    {
        var focusId = RegionFocusId;
        <ul class="files" aria-label="파일">
            @foreach (var file in Workspace.Files)
            {
                var active = IsActive(file);
                <li @key="file.Id">
                    <button type="button"
                            class="@(active ? "file on" : "file")"
                            aria-current="@(active ? "page" : null)"
                            aria-label="@FileLabel(file)"
                            title="@file.Name"
                            data-region-focus="@(file.Id == focusId ? "true" : null)"
                            @onclick="() => Workspace.Open(file.Id)">
                        <FileTypeIcon Type="@file.Type" Size="28" />
                        @if (file.Activity == FileActivity.Asking)
                        {
                            <span class="badge ask" aria-hidden="true">?</span>
                        }
                        else if (file.Activity == FileActivity.Editing)
                        {
                            <span class="badge busy" aria-hidden="true"><Spinner Size="13" Stroke="3" /></span>
                        }
                        else if (file.Changes.Count > 0)
                        {
                            <span class="badge mark" aria-hidden="true"></span>
                        }
                    </button>
                </li>
            }
        </ul>
    }
    <IconButton Icon="file-plus" IconSize="18" Label="새 파일" Title="새 파일" Class="add" id="folder-rail-new-file" OnClick="NewFile" />
    <IconButton Icon="import" IconSize="18" Label="파일 넣기" Title="파일 넣기" OnClick="ImportAsync" />
</aside>

@code {
    private bool _importing;

    private void NewFile() => Workspace.OpenNewFile("#folder-rail-new-file");

    private string RegionFocusId
    {
        get
        {
            var active = Workspace.ActiveFile;
            if (active != null && Workspace.FindFile(active.Id) != null)
                return active.Id;

            return Workspace.Files.Count > 0 ? Workspace.Files[0].Id : null;
        }
    }

    private bool IsActive(WorkspaceFile file) => Workspace.ActiveFile != null && Workspace.ActiveFile.Id == file.Id;

    private static string FileLabel(WorkspaceFile file)
    {
        var status = file.StatusText;
        return string.IsNullOrEmpty(status) ? file.Name : $"{file.Name}, {status}";
    }

    private void Expand() => Workspace.ToggleFolderWithFocus();

    private async Task ImportAsync()
    {
        if (_importing)
            return;

        _importing = true;
        try
        {
            var paths = await FileDialog.PickDocumentsAsync();
            if (paths != null && paths.Count > 0)
                await Workspace.ImportAsync(paths);
        }
        finally
        {
            _importing = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Workspace.TakeFolderToggleFocus())
            await JS.InvokeVoidAsync("docuHelper.focus", "#folder-files-open");
    }
}
