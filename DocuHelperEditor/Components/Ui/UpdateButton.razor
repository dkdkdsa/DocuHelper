@implements IDisposable
@inject UpdateStore Updates
@inject IJSRuntime JS

@if (IsPillVisible)
{
    <div class="update-wrap" @onkeydown="OnKeyDown">
        <button type="button" id="update-pill" class="update-pill" aria-expanded="@ExpandedText" aria-controls="update-pop" @onclick="Toggle">
            <Icon Name="@PillIcon" Size="16" Stroke="2.2" />
            <span>@PillText</span>
        </button>
        <span class="sr-only" role="status">@_announcement</span>
        @if (_open)
        {
            <UpdatePopover AlignEnd="AlignEnd" OnClose="Close" />
        }
    </div>
}

@code {
    [Parameter]
    public bool AlignEnd { get; set; }

    private bool _open;
    private string _announcement = string.Empty;
    private string _focusTarget;
    private UpdatePhase _lastPhase;

    private bool IsPillVisible => Updates.Notice != null
        && Updates.Phase is UpdatePhase.Available or UpdatePhase.Downloading or UpdatePhase.Ready or UpdatePhase.OnClose;

    private string ExpandedText => _open ? "true" : "false";

    private string PillIcon => Updates.Phase is UpdatePhase.Ready or UpdatePhase.OnClose ? "check" : "download";

    private string PillText => Updates.Phase switch
    {
        UpdatePhase.Downloading => $"받는 중 {Updates.Percent}%",
        UpdatePhase.Ready => "새 버전 받음",
        UpdatePhase.OnClose => $"닫으면 {Updates.Notice.Version} 버전으로 바뀌어요",
        _ => $"새 버전 {Updates.Notice.Version}",
    };

    protected override void OnInitialized()
    {
        _lastPhase = Updates.Phase;
        Updates.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTarget == null)
            return;

        var target = _focusTarget;
        _focusTarget = null;
        await JS.InvokeVoidAsync("docuHelper.focus", target);
    }

    public void Dispose() => Updates.Changed -= OnChanged;

    private void OnChanged()
    {
        var phase = Updates.Phase;
        if (phase == UpdatePhase.Downloading && _lastPhase != UpdatePhase.Downloading)
            _announcement = string.Empty;

        if (_lastPhase == UpdatePhase.Downloading)
        {
            if (phase == UpdatePhase.Ready)
                _announcement = "새 버전을 다 받았어요";
            else if (phase == UpdatePhase.OnClose)
                _announcement = "새 버전을 다 받았어요. 앱을 닫을 때 바뀌어요";
            else if (phase == UpdatePhase.Available && Updates.DownloadFailed)
                _announcement = "새 버전을 내려받지 못했어요";
        }

        if (phase == UpdatePhase.Ready && _lastPhase == UpdatePhase.Downloading && _open)
            _focusTarget = Updates.CanRestartNow ? "#update-restart" : "#update-onclose";

        if (!IsPillVisible)
            _open = false;

        _lastPhase = phase;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Toggle() => _open = !_open;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_open && e.Key == "Escape")
            await Close();
    }

    private async Task Close()
    {
        _open = false;
        await JS.InvokeVoidAsync("docuHelper.focus", "#update-pill");
    }
}
