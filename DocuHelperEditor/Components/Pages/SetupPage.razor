@page "/setup"
@inherits StoreComponentBase
@inject NavigationManager NavigationManager

<div class="setup">
    <header class="setup-header">
        <BrandMark Size="26" />
        <span class="brand-name">문서 도우미</span>
    </header>

    <main class="setup-main">
        <section class="card" aria-labelledby="setup-h">
            <div class="form">
                <div class="intro">
                    <h1 id="setup-h">처음 한 번만 설정해요</h1>
                    <p class="lead">이 컴퓨터에서 도우미를 쓰려면 열쇠 하나만 넣으면 돼요. 작업 폴더는 다음 화면에서 만들거나 골라요.</p>
                </div>

                <div class="key">
                    <label for="setup-key" class="key-title">도우미 열쇠 (API 키)</label>
                    <div class="row">
                        <div class="fld">
                            <input id="setup-key" type="@KeyInputType" value="@Settings.ApiKey" autocomplete="off" spellcheck="false" aria-describedby="setup-key-status setup-key-tip" @oninput="OnKeyInput" />
                            <IconButton Icon="eye" IconSize="18" Label="열쇠 보이기" Pressed="@Settings.IsKeyVisible" OnClick="Settings.ToggleKeyVisible" />
                        </div>
                        <ActionButton Kind="ButtonKind.Secondary" Class="tall" Disabled="@VerifyDisabled" OnClick="Settings.VerifyKeyAsync">연결 확인</ActionButton>
                    </div>
                    <p id="setup-key-status" class="key-status @KeyStateClass" role="status">
                        @switch (Settings.KeyState)
                        {
                            case KeyCheckState.Ok:
                                <span class="badge" aria-hidden="true"><Icon Name="check" Size="11" Stroke="3.6" /></span>
                                <span>연결됐어요</span>
                                break;
                            case KeyCheckState.Checking:
                                <Spinner Size="16" />
                                <span>연결되는지 확인하고 있어요…</span>
                                break;
                            case KeyCheckState.Failed:
                                <span class="badge" aria-hidden="true"><Icon Name="x" Size="11" Stroke="3.6" /></span>
                                <span>연결이 안 됐어요. 열쇠가 맞는지 다시 봐 주세요.</span>
                                break;
                            default:
                                <span>열쇠를 붙여 넣고 [연결 확인]을 눌러 주세요.</span>
                                break;
                        }
                    </p>
                    <p id="setup-key-tip" class="tip">sk-ant-로 시작하는 열쇠예요. 없으면 앱을 깔아 준 분께 받아 주세요.</p>
                </div>

                <div class="info">
                    <Icon Name="lock" Size="18" Stroke="2" />
                    <p class="info-text">
                        <span class="info-title">열쇠는 이 컴퓨터에만 저장돼요</span>
                        <span class="info-note">암호를 걸어 저장해서 이 컴퓨터, 지금 쓰는 윈도우 계정에서만 열려요.</span>
                    </p>
                </div>

                @if (_saveFailed)
                {
                    <p class="save-error" role="alert">열쇠를 저장하지 못했어요. 문서 도우미를 사용자 폴더(%LocalAppData%\Programs\문서도우미)에 다시 설치해 주세요.</p>
                }

                <div class="foot">
                    <ActionButton Kind="ButtonKind.Primary" Class="start" Disabled="@(!Settings.CanStart || _starting)" OnClick="Start">저장하고 계속하기</ActionButton>
                </div>
            </div>

            <aside class="guide" aria-labelledby="setup-guide-h">
                <h2 id="setup-guide-h">이렇게 써요</h2>
                <ul class="howto">
                    <li>
                        <span class="pic" aria-hidden="true">
                            <span class="sheet-back"></span>
                            <span class="sheet-front"></span>
                            <span class="sheet-line"></span>
                            <span class="sheet-line short"></span>
                        </span>
                        <span class="how-text">
                            <span class="how-title">파일을 작업 폴더에 넣어요</span>
                            <span class="how-detail">엑셀, 워드, 파워포인트를 여러 개 넣어도 돼요</span>
                        </span>
                    </li>
                    <li>
                        <span class="pic" aria-hidden="true">
                            <span class="bubble-me"></span>
                            <span class="bubble-you"></span>
                        </span>
                        <span class="how-text">
                            <span class="how-title">도우미에게 말로 부탁해요</span>
                            <span class="how-detail">보고 있는 파일과 고른 칸은 알아서 같이 봐요</span>
                        </span>
                    </li>
                    <li>
                        <span class="pic" aria-hidden="true">
                            <span class="pic-page"></span>
                            <span class="pic-hl"></span>
                            <span class="pic-bar"></span>
                        </span>
                        <span class="how-text">
                            <span class="how-title">형광펜 친 곳을 보고 저장해요</span>
                            <span class="how-detail">마음에 안 들면 되돌리거나 직접 고치면 돼요</span>
                        </span>
                    </li>
                </ul>
                <div class="marks">
                    <h3>종이에 생기는 표시</h3>
                    <p class="mark"><span class="swatch-hl" aria-hidden="true"></span>형광펜: 도우미가 바꾼 곳</p>
                    <p class="mark"><span class="swatch-pencil" aria-hidden="true"></span>연필 동그라미: 도우미가 물어보는 곳</p>
                    <p class="mark"><span class="swatch-bar" aria-hidden="true"><span class="bar"></span></span>왼쪽 막대: 바뀐 줄</p>
                </div>
            </aside>
        </section>
    </main>

    @if (DevMode.Enabled && string.IsNullOrEmpty(Bare))
    {
        <DevScenarioPicker Current="setup" />
    }
</div>

@code {
    private bool _starting;
    private bool _saveFailed;

    [SupplyParameterFromQuery(Name = "scenario")]
    public string Scenario { get; set; }

    [SupplyParameterFromQuery(Name = "bare")]
    public string Bare { get; set; }

    private string KeyInputType => Settings.IsKeyVisible ? "text" : "password";

    private bool VerifyDisabled => string.IsNullOrWhiteSpace(Settings.ApiKey) || Settings.KeyState == KeyCheckState.Checking;

    private string KeyStateClass => Settings.KeyState switch
    {
        KeyCheckState.Ok => "ok",
        KeyCheckState.Checking => "checking",
        KeyCheckState.Failed => "failed",
        _ => "idle",
    };

    protected override void OnParametersSet()
    {
        if (DevMode.Enabled && !string.IsNullOrEmpty(Scenario))
        {
            if (Scenario != SampleScenarios.Current)
                SampleScenarios.Apply(Scenario, Workspace, Assistant, Settings);

            return;
        }

        if (SampleScenarios.Current != null)
        {
            SampleScenarios.Leave();
            Settings.Reload();
        }

        Settings.EnsureLoaded();
    }

    private void OnKeyInput(ChangeEventArgs e) => Settings.SetApiKey(e.Value?.ToString());

    private void Start()
    {
        if (_starting || !Settings.CanStart)
            return;

        _starting = true;
        try
        {
            _saveFailed = !Settings.SaveKey();
            if (!_saveFailed)
                NavigationManager.NavigateTo("home");
        }
        finally
        {
            _starting = false;
        }
    }
}
