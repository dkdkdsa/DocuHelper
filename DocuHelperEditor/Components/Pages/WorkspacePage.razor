@page "/"
@inherits StoreComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="workspace">
    <div class="workspace-main" inert="@IsBlocked">
        <AppHeader />
        <div class="workspace-body">
            @if (Workspace.IsFolderCollapsed)
            {
                <FolderRail />
            }
            else
            {
                <FolderPanel />
            }
            <PaperPanel />
            @if (Assistant.IsPanelCollapsed)
            {
                <AssistantRail />
            }
            else
            {
                <AssistantPanel />
            }
            <DropOverlay />
        </div>
    </div>
    <HistoryPanel />
    <UnsavedDialog />
    @if (Workspace.IsNewFileOpen)
    {
        <NewFileDialog />
    }
    @if (DevMode.Enabled && string.IsNullOrEmpty(Bare))
    {
        <DevScenarioPicker Current="@(SampleScenarios.Current ?? SampleScenarios.Real)" />
    }
</div>

@code {
    private const string FilesModulePath = "./js/attachments.js";

    private DotNetObjectReference<WorkspacePage> _self;
    private IJSObjectReference _files;

    [SupplyParameterFromQuery(Name = "scenario")]
    public string Scenario { get; set; }

    [SupplyParameterFromQuery(Name = "bare")]
    public string Bare { get; set; }

    private bool IsBlocked => Workspace.PendingClose != null || Workspace.IsNewFileOpen || Settings.IsDialogOpen;

    protected override void OnParametersSet()
    {
        if (DevMode.Enabled && !string.IsNullOrEmpty(Scenario) && Scenario != SampleScenarios.Real)
        {
            if (Scenario != SampleScenarios.Current)
                SampleScenarios.Apply(Scenario, Workspace, Assistant, Settings);

            return;
        }

        if (SampleScenarios.Current != null)
        {
            SampleScenarios.Leave();
            Settings.Reload();
            Assistant.NewConversation();
        }

        Settings.EnsureLoaded();
        if (!Settings.IsConfigured)
        {
            Navigation.NavigateTo("setup");
            return;
        }

        if (!Workspace.IsReady && !(Settings.OpenLastFolder && Workspace.OpenLastFolderOnce()))
            Navigation.NavigateTo("home");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("docuHelper.registerShortcuts", _self);

        try
        {
            _files = await JS.InvokeAsync<IJSObjectReference>("import", FilesModulePath);
            await _files.InvokeVoidAsync("start", _self, new
            {
                maxEdge = AssistantStore.MaxImageEdge,
                imageBytes = AssistantStore.MaxImageBytes,
                imageSourceBytes = AssistantStore.MaxImageSourceBytes,
                pdfBytes = AssistantStore.MaxPdfBytes,
                textBytes = AssistantStore.MaxTextBytes,
            });
        }
        catch (JSException e)
        {
            AppLog.Write("File intake failed to start", e);
        }
    }

    [JSInvokable]
    public Task OnSaveShortcut() => Workspace.SaveAllAsync();

    [JSInvokable]
    public Task OnUndoShortcut() => Workspace.UndoAsync();

    [JSInvokable]
    public Task OnRedoShortcut() => Workspace.RedoAsync();

    [JSInvokable]
    public void OnFilesDragEnter(string[] kinds)
    {
        if (Workspace.CanTakeFiles)
            Workspace.ShowDrag(kinds);
    }

    [JSInvokable]
    public void OnFilesDragLeave() => Workspace.ClearDrop();

    [JSInvokable]
    public string OnFileAttached(IncomingFile file) => Workspace.CanTakeFiles ? Assistant.AddAttachment(file) : "blocked";

    [JSInvokable]
    public void OnFileProblems(IncomingFile[] problems)
    {
        if (Workspace.CanTakeFiles)
            Assistant.ReportFileProblems(problems);
    }

    protected override void OnDispose()
    {
        _ = JS.InvokeVoidAsync("docuHelper.unregisterShortcuts").AsTask();
        if (_files != null)
            _ = StopFilesAsync(_files);

        _self?.Dispose();
    }

    private static async Task StopFilesAsync(IJSObjectReference files)
    {
        try
        {
            await files.InvokeVoidAsync("stop");
            await files.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}
