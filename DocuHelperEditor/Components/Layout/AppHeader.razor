@inherits StoreComponentBase

<header class="app-header" data-chrome>
    <div class="brand">
        <BrandMark Size="26" />
        <span class="brand-name">문서 도우미</span>
    </div>
    <div class="actions">
        <UpdateButton />
        <span class="save-status" role="status">
            @if (Workspace.UnsavedCount > 0)
            {
                <span class="dot" aria-hidden="true"></span>
            }
            @Workspace.SaveStatusText
        </span>
        <button type="button" class="save-all" disabled="@(!Workspace.CanSaveAll)" @onclick="Workspace.SaveAllAsync">모두 저장</button>
        <ActionButton Kind="ButtonKind.Ghost" Icon="history" aria-expanded="@HistoryExpanded" OnClick="Workspace.ToggleHistory">기록</ActionButton>
        <ActionButton Kind="ButtonKind.Ghost" Icon="settings" id="header-settings" aria-haspopup="dialog" OnClick="OpenSettings">설정</ActionButton>
    </div>
</header>

@code {
    private string HistoryExpanded => Workspace.IsHistoryOpen ? "true" : "false";

    private void OpenSettings() => Settings.OpenDialog("#header-settings");
}
