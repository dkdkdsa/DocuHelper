@if (Levels > 0)
{
    <span class="levels" role="group" aria-label="윤곽 수준">
        @for (var level = 1; level <= Levels; level++)
        {
            var number = level;
            <button type="button" class="lv" aria-label="윤곽 수준 @number" title="윤곽 수준 @(number)까지 보기" @onclick="() => OnLevel.InvokeAsync(number)" @onmousedown:stopPropagation="true">@number</button>
        }
    </span>
}

@code {
    [Parameter]
    public int Levels { get; set; }

    [Parameter]
    public EventCallback<int> OnLevel { get; set; }
}
