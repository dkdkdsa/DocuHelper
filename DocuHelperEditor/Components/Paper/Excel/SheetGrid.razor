@using System.Globalization
@using System.Linq
@using Microsoft.AspNetCore.Components.Rendering
@using DocuHelperEditor.State.Papers
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="grid @(Locked ? "locked" : null) @(Sheet?.ShowGridlines == false ? "nogrid" : null) @(Sheet?.ShowHeadings == false ? "nohead" : null)" @ref="_grid">
    @if (Sheet != null)
    {
        <table class="sheet @(Sheet.FreezeColumns > 0 ? "fzcols" : null)" style="@ZoomStyle" aria-label="@TableLabel">
            <colgroup>
                <col class="rh" />
                @foreach (var column in Sheet.Columns)
                {
                    if (column.Hidden)
                    {
                        continue;
                    }

                    <col style="@WidthStyle(column)" />
                }
            </colgroup>
            <thead>
                <tr>
                    <th scope="col" title="모두 고르기"><span class="sr-only">행</span>@CornerDecorations</th>
                    @for (var c = 0; c < Sheet.Columns.Count; c++)
                    {
                        var columnIndex = c;
                        if (Sheet.Columns[columnIndex].Hidden)
                        {
                            continue;
                        }

                        <th scope="col" data-c="@columnIndex" class="@ColumnHeadClass(columnIndex)" style="@FrozenLeft(columnIndex)">@ColumnName(columnIndex)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _order.Count; i++)
                {
                    var rowIndex = _order[i];
                    if (rowIndex < 0)
                    {
                        <tr @key="rowIndex" class="spacer" style="height: @Px(_spacers[-rowIndex - 1])px" aria-hidden="true"><td colspan="@(Sheet.Columns.Count + 1)"></td></tr>
                        continue;
                    }

                    var row = Sheet.FindRow(rowIndex);
                    if (row?.Hidden == true)
                    {
                        continue;
                    }

                    var barId = BarChangeId(row);
                    <tr @key="rowIndex" class="@RowClass(rowIndex, row)" style="@HeightStyle(row)" data-r="@rowIndex" data-change="@barId">
                        <th scope="row" class="@RowHeadClass(rowIndex, barId)">
                            @(rowIndex + 1)
                            @if (RowDecorations != null)
                            {
                                @RowDecorations(new SheetRowContext(Sheet, row, rowIndex))
                            }
                        </th>
                        @for (var c = 0; c < Sheet.Columns.Count; c++)
                        {
                            var columnIndex = c;
                            if (Sheet.Columns[columnIndex].Hidden)
                            {
                                continue;
                            }

                            var merge = Sheet.MergeAt(rowIndex, columnIndex);
                            if (merge.HasValue && !IsAnchor(merge.Value, rowIndex, columnIndex))
                            {
                                continue;
                            }

                            var area = merge ?? new SheetRegion(rowIndex, columnIndex, rowIndex, columnIndex);
                            var cell = Sheet.FindCell(area.Top, area.Left);
                            var cellRef = SheetRef.Make(area.Left, area.Top);
                            var active = area.Contains(_selectedRow, _selectedColumn);
                            var context = new SheetCellContext(Sheet, row, cell, rowIndex, columnIndex, area, active);
                            <td data-c="@columnIndex" rowspan="@Span(merge, true)" colspan="@Span(merge, false)" class="@WithExtra(CellClass(cell, row, area, columnIndex, active), CellClassHook, context, " ")" style="@WithExtra(CellStyle(cell, merge, columnIndex), CellStyleHook, context, "; ")" data-x="@(cellRef == ExtentRef ? "1" : null)" @ondblclick="() => OnCellDoubleClick.InvokeAsync(cellRef)">
                                @if (active)
                                {
                                    var sinkKey = cellRef + "-" + Version;
                                    <input id="@SinkId" @key="sinkKey" class="sink @(EditingInCell ? "on" : null)" value="@(EditingInCell ? SinkSeed : string.Empty)" readonly="@Locked" autocomplete="off" spellcheck="false" aria-label="@SinkLabel(cellRef, cell)" @oninput="HandleSinkInput" @onkeydown="HandleSinkKeyDown" @onblur="HandleSinkBlur" />
                                }
                                @if (active && EditingInBar)
                                {
                                    @Draft
                                }
                                else if (cell != null && !string.IsNullOrEmpty(cell.Text))
                                {
                                    if (cell.OverflowWidth.HasValue)
                                    {
                                        <span class="ov" style="@("width: " + cell.OverflowWidth.Value + "px")">@{ RenderText(__builder, cell, rowIndex); }</span>
                                    }
                                    else
                                    {
                                        RenderText(__builder, cell, rowIndex);
                                    }
                                }
                                @if (ShowFillHandle && area.Contains(Selection.Bottom, Selection.Right))
                                {
                                    <span class="fh" title="끌어서 채우기" aria-hidden="true"></span>
                                }
                                @if (CellDecorations != null)
                                {
                                    @CellDecorations(context)
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (Overlay != null)
        {
            <div class="overlay">@Overlay(Sheet)</div>
        }
    }
</div>

@code {
    private const string ModulePath = "./Components/Paper/Excel/SheetGrid.razor.js";
    private const double PixelsPerPoint = 14.0 / 11.0;
    private const double DefaultRowPx = 30;
    private const double DefaultViewHeight = 900;
    private const int Overscan = 20;

    private ElementReference _grid;
    private IJSObjectReference _module;
    private DotNetObjectReference<SheetGrid> _self;
    private int _rowCount;
    private int _selectedRow = -1;
    private int _selectedColumn = -1;
    private int _firstMarkedRow;
    private int _lastFrozenRow = -1;
    private readonly List<int> _order = new();
    private readonly List<double> _spacers = new();
    private double[] _tops = Array.Empty<double>();
    private double _rowPx = DefaultRowPx;
    private double _viewTop;
    private double _viewHeight = DefaultViewHeight;

    [Parameter]
    public Sheet Sheet { get; set; }

    [Parameter]
    public string SinkId { get; set; }

    [Parameter]
    public string SelectedRef { get; set; }

    [Parameter]
    public SheetRegion Selection { get; set; }

    [Parameter]
    public string ExtentRef { get; set; }

    [Parameter]
    public SheetRegion? PointRegion { get; set; }

    [Parameter]
    public SheetRegion? CutRegion { get; set; }

    [Parameter]
    public SheetRegion? FillPreview { get; set; }

    [Parameter]
    public bool ShowFillHandle { get; set; }

    [Parameter]
    public bool Locked { get; set; }

    [Parameter]
    public int Zoom { get; set; } = 100;

    [Parameter]
    public bool EditingInCell { get; set; }

    [Parameter]
    public bool EditingInBar { get; set; }

    [Parameter]
    public string Draft { get; set; }

    [Parameter]
    public string SinkSeed { get; set; }

    [Parameter]
    public int Version { get; set; }

    [Parameter]
    public string HighlightChangeId { get; set; }

    [Parameter]
    public HashSet<string> LiveChangeIds { get; set; }

    [Parameter]
    public bool ShowAsking { get; set; }

    [Parameter]
    public RenderFragment<SheetCellContext> CellDecorations { get; set; }

    [Parameter]
    public RenderFragment<SheetRowContext> RowDecorations { get; set; }

    [Parameter]
    public RenderFragment CornerDecorations { get; set; }

    [Parameter]
    public RenderFragment<Sheet> Overlay { get; set; }

    [Parameter]
    public Func<SheetCellContext, string> CellClassHook { get; set; }

    [Parameter]
    public Func<SheetCellContext, string> CellStyleHook { get; set; }

    [Parameter]
    public EventCallback<SheetPointer> OnPointer { get; set; }

    [Parameter]
    public EventCallback<string> OnPaste { get; set; }

    [Parameter]
    public EventCallback<SheetResize> OnResize { get; set; }

    [Parameter]
    public EventCallback<SheetMenuRequest> OnMenu { get; set; }

    [Parameter]
    public EventCallback<string> OnCellDoubleClick { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnSinkKeyDown { get; set; }

    [Parameter]
    public EventCallback<string> OnSinkInput { get; set; }

    [Parameter]
    public EventCallback OnSinkBlur { get; set; }

    private string TableLabel => Sheet.Name + " 시트";

    private string ZoomStyle => Zoom == 100 ? null : "zoom: " + (Zoom / 100.0).ToString("0.##", CultureInfo.InvariantCulture);

    private bool IsMulti => !Selection.IsSingle;

    protected override void OnParametersSet()
    {
        _rowCount = Sheet?.DisplayRowCount ?? 0;
        if (!SheetRef.TryParse(SelectedRef, out _selectedColumn, out _selectedRow))
        {
            _selectedColumn = -1;
            _selectedRow = -1;
        }

        _firstMarkedRow = FindFirstMarkedRow();
        _lastFrozenRow = -1;
        for (var r = Math.Min(Sheet?.FreezeRows ?? 0, _rowCount) - 1; r >= 0; r--)
        {
            if (!Sheet.IsRowHidden(r))
            {
                _lastFrozenRow = r;
                break;
            }
        }

        RebuildLayout();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _self = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
                await _module.InvokeVoidAsync("attach", _grid, _self);
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("refresh", _grid);
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_module != null && Sheet != null && (Sheet.FreezeRows > 0 || Sheet.FreezeColumns > 0))
        {
            try
            {
                await _module.InvokeVoidAsync("layout", _grid, Sheet.FreezeRows, Sheet.FreezeColumns);
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    [JSInvokable]
    public void Viewport(double top, double height, double rowPx)
    {
        var before = _order.ToArray();
        var beforeSpacers = _spacers.ToArray();
        _viewTop = top;
        _viewHeight = height > 0 ? height : DefaultViewHeight;
        if (rowPx > 0 && Math.Abs(rowPx - _rowPx) > 0.01)
        {
            _rowPx = rowPx;
            RebuildTops();
        }

        BuildOrder();
        if (!before.SequenceEqual(_order) || !beforeSpacers.SequenceEqual(_spacers))
            StateHasChanged();
    }

    [JSInvokable]
    public Task Pointer(string phase, int row, int column, bool shift, bool ctrl) => OnPointer.InvokeAsync(new SheetPointer(phase, row, column, shift, ctrl));

    [JSInvokable]
    public Task Paste(string text) => OnPaste.InvokeAsync(text);

    [JSInvokable]
    public Task Resize(bool rows, int index, int pixels) => OnResize.InvokeAsync(new SheetResize(rows, index, pixels));

    [JSInvokable]
    public Task Menu(string kind, int row, int column, double x, double y) => OnMenu.InvokeAsync(new SheetMenuRequest(kind, row, column, x, y));

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach", _grid);
                await _module.DisposeAsync();
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    private void RenderText(RenderTreeBuilder __builder, SheetCell cell, int rowIndex)
    {
        var marked = cell.HasChange(HighlightChangeId);
        var asking = ShowAsking && cell.IsAsking;
        if (marked)
        {
            <span class="mk on" data-change="@HighlightChangeId" style="@DelayStyle(rowIndex)" @key="HighlightChangeId">
                @if (asking)
                {
                    <span class="pc">@cell.Text</span>
                }
                else
                {
                    @cell.Text
                }
            </span>
        }
        else if (asking)
        {
            <span class="pc">@cell.Text</span>
        }
        else
        {
            @cell.Text
        }
    }

    private int FindFirstMarkedRow()
    {
        if (Sheet == null || string.IsNullOrEmpty(HighlightChangeId))
            return 0;

        var index = Sheet.Rows.FindIndex(r => r.Cells.Any(c => c.HasChange(HighlightChangeId)));
        return index < 0 ? 0 : index;
    }

    private string ColumnName(int index)
    {
        var letter = Sheet.Columns[index].Letter;
        return string.IsNullOrEmpty(letter) ? SheetRef.ColumnName(index) : letter;
    }

    private static string WithExtra(string value, Func<SheetCellContext, string> hook, SheetCellContext context, string separator)
    {
        var extra = hook?.Invoke(context);
        if (string.IsNullOrEmpty(extra))
            return value;

        return string.IsNullOrEmpty(value) ? extra : value + separator + extra;
    }

    private static string WidthStyle(SheetColumn column) => column.Width.HasValue ? "width: " + column.Width.Value + "px" : null;

    private void RebuildLayout()
    {
        RebuildTops();
        BuildOrder();
    }

    private void RebuildTops()
    {
        _tops = new double[_rowCount + 1];
        for (var r = 0; r < _rowCount; r++)
        {
            _tops[r + 1] = _tops[r] + RowHeight(r);
        }
    }

    private double RowHeight(int rowIndex)
    {
        var row = Sheet.FindRow(rowIndex);
        if (row?.Hidden == true)
        {
            return 0;
        }

        return row?.Height ?? _rowPx;
    }

    private void BuildOrder()
    {
        _order.Clear();
        _spacers.Clear();
        if (_rowCount == 0)
        {
            return;
        }

        var frozen = Math.Min(Sheet?.FreezeRows ?? 0, _rowCount);
        for (var r = 0; r < frozen; r++)
        {
            _order.Add(r);
        }

        var ranges = new List<(int First, int Last)>();
        var start = Math.Max(frozen, RowAt(_viewTop) - Overscan);
        var end = Math.Min(_rowCount - 1, RowAt(_viewTop + _viewHeight) + Overscan);
        if (start <= end)
        {
            ranges.Add((start, end));
        }

        if (_selectedRow >= frozen && _selectedRow < _rowCount)
        {
            ranges.Add((_selectedRow, _selectedRow));
        }

        var cursor = frozen;
        foreach (var range in ranges.OrderBy(range => range.First))
        {
            if (range.Last < cursor)
            {
                continue;
            }

            var first = Math.Max(range.First, cursor);
            AddSpacer(_tops[first] - _tops[cursor]);
            for (var r = first; r <= range.Last; r++)
            {
                _order.Add(r);
            }

            cursor = range.Last + 1;
        }

        AddSpacer(_tops[_rowCount] - _tops[cursor]);
    }

    private void AddSpacer(double height)
    {
        if (height <= 0)
        {
            return;
        }

        _spacers.Add(height);
        _order.Add(-_spacers.Count);
    }

    private int RowAt(double y)
    {
        var low = 0;
        var high = _rowCount - 1;
        while (low < high)
        {
            var middle = (low + high + 1) / 2;
            if (_tops[middle] <= y)
            {
                low = middle;
            }
            else
            {
                high = middle - 1;
            }
        }

        return low;
    }

    private static string Px(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string HeightStyle(SheetRow row) => row?.Height is int height ? "--rh: " + height + "px" : null;

    private bool IsAnchor(SheetRegion merge, int rowIndex, int columnIndex)
    {
        var firstRow = merge.Top;
        while (firstRow < merge.Bottom && Sheet.IsRowHidden(firstRow))
            firstRow++;

        var firstColumn = merge.Left;
        while (firstColumn < merge.Right && Sheet.IsColumnHidden(firstColumn))
            firstColumn++;

        return rowIndex == firstRow && columnIndex == firstColumn;
    }

    private int? Span(SheetRegion? merge, bool rows)
    {
        if (!merge.HasValue)
            return null;

        var region = merge.Value;
        var count = rows
            ? Enumerable.Range(region.Top, region.RowCount).Count(r => r < _rowCount && !Sheet.IsRowHidden(r))
            : Enumerable.Range(region.Left, region.ColumnCount).Count(c => !Sheet.IsColumnHidden(c));
        return count > 1 ? count : null;
    }

    private string FrozenLeft(int columnIndex) => columnIndex < Sheet.FreezeColumns ? "left: var(--fz-l" + columnIndex + ")" : null;

    private string BarChangeId(SheetRow row)
    {
        if (row == null || LiveChangeIds == null || LiveChangeIds.Count == 0)
            return null;

        if (!string.IsNullOrEmpty(row.ChangeId) && LiveChangeIds.Contains(row.ChangeId))
            return row.ChangeId;

        if (row.Cells == null)
            return null;

        return row.Cells
            .Where(c => c?.ChangeIds != null)
            .SelectMany(c => c.ChangeIds)
            .FirstOrDefault(id => !string.IsNullOrEmpty(id) && LiveChangeIds.Contains(id));
    }

    private string RowClass(int rowIndex, SheetRow row)
    {
        var classes = new List<string>();
        if (row?.Kind == SheetRowKind.Total)
            classes.Add("tot");
        else if (Sheet.FindRow(rowIndex + 1)?.Kind == SheetRowKind.Total)
            classes.Add("pre-tot");

        if (row?.Height != null)
            classes.Add("hx");

        if (row?.OutlineLevel > 0)
            classes.Add("ol");

        if (rowIndex < Sheet.FreezeRows)
            classes.Add(rowIndex == _lastFrozenRow ? "fz fz-end" : "fz");

        return classes.Count == 0 ? null : string.Join(" ", classes);
    }

    private string ColumnHeadClass(int columnIndex)
    {
        var classes = new List<string>();
        if (columnIndex >= Selection.Left && columnIndex <= Selection.Right)
            classes.Add("sel");

        if (Sheet.IsColumnHidden(columnIndex + 1))
            classes.Add("gap");

        if (columnIndex < Sheet.FreezeColumns)
            classes.Add(columnIndex == Sheet.FreezeColumns - 1 ? "fzc fzc-end" : "fzc");

        return classes.Count == 0 ? null : string.Join(" ", classes);
    }

    private string RowHeadClass(int rowIndex, string barId)
    {
        var classes = new List<string>();
        if (rowIndex >= Selection.Top && rowIndex <= Selection.Bottom)
            classes.Add("sel");

        if (barId != null)
            classes.Add("bar");

        if (Sheet.IsRowHidden(rowIndex + 1))
            classes.Add("gap");

        return classes.Count == 0 ? null : string.Join(" ", classes);
    }

    private string CellClass(SheetCell cell, SheetRow row, SheetRegion area, int columnIndex, bool active)
    {
        var kind = row?.Kind ?? SheetRowKind.Normal;
        var classes = new List<string>();
        var bold = cell != null ? cell.IsBoldIn(kind) : kind != SheetRowKind.Normal;
        if (bold)
            classes.Add("b");

        if (cell != null)
        {
            if (cell.Italic)
                classes.Add("i");

            if (cell.IsPending)
                classes.Add("pend");

            if (cell.Underline)
                classes.Add("u");

            if (cell.Align == SheetAlign.Center)
                classes.Add("al-c");
            else if (cell.Align == SheetAlign.Right || (cell.Align == SheetAlign.Auto && cell.IsNumber))
                classes.Add("al-r");

            if (cell.Wrap)
                classes.Add("wr");

            if (cell.VAlign == "top")
                classes.Add("va-t");
            else if (cell.VAlign == "center")
                classes.Add("va-m");
            else if (cell.VAlign == "bottom")
                classes.Add("va-b");

            if (cell.OverflowWidth.HasValue)
                classes.Add("ovf");
        }

        if (columnIndex < Sheet.FreezeColumns)
            classes.Add(area.Right >= Sheet.FreezeColumns - 1 ? "fzc fzc-end" : "fzc");

        if (active)
            classes.Add(IsMulti ? "sel act" : "sel");

        if (IsMulti && Selection.Contains(area.Top, area.Left))
            AddEdges(classes, "in", "e", Selection, area);

        var (mark, region) = MarkAt(area.Top, area.Left);
        if (mark != null)
            AddEdges(classes, "mark " + mark, "m", region, area);

        return classes.Count == 0 ? null : string.Join(" ", classes);
    }

    private (string Mark, SheetRegion Region) MarkAt(int rowIndex, int columnIndex)
    {
        if (PointRegion is { } point && point.Contains(rowIndex, columnIndex))
            return ("m-pt", point);

        if (FillPreview is { } fill && fill.Contains(rowIndex, columnIndex))
            return ("m-fp", fill);

        if (CutRegion is { } cut && cut.Contains(rowIndex, columnIndex))
            return ("m-ct", cut);

        return (null, default);
    }

    private static void AddEdges(List<string> classes, string name, string prefix, SheetRegion region, SheetRegion area)
    {
        classes.Add(name);
        if (area.Top == region.Top)
            classes.Add(prefix + "-t");

        if (area.Bottom == region.Bottom)
            classes.Add(prefix + "-b");

        if (area.Left == region.Left)
            classes.Add(prefix + "-l");

        if (area.Right == region.Right)
            classes.Add(prefix + "-r");
    }

    private string CellStyle(SheetCell cell, SheetRegion? merge, int columnIndex)
    {
        var parts = new List<string>();
        if (cell != null)
        {
            if (cell.FillColor != null)
                parts.Add("background-color: #" + cell.FillColor);

            if (cell.FontColor != null)
                parts.Add("color: #" + cell.FontColor);

            if (cell.FontFamily != null)
                parts.Add("font-family: '" + cell.FontFamily.Replace("'", string.Empty) + "', var(--font-body)");

            if (cell.FontSize.HasValue)
                parts.Add("font-size: " + (cell.FontSize.Value * PixelsPerPoint).ToString("0.#", CultureInfo.InvariantCulture) + "px");
        }

        var right = merge.HasValue ? Sheet.FindCell(merge.Value.Top, merge.Value.Right) : cell;
        var bottom = merge.HasValue ? Sheet.FindCell(merge.Value.Bottom, merge.Value.Left) : cell;
        AddBorder(parts, "top", cell?.BorderTop);
        AddBorder(parts, "left", cell?.BorderLeft);
        AddBorder(parts, "right", right?.BorderRight);
        AddBorder(parts, "bottom", bottom?.BorderBottom);
        var left = FrozenLeft(columnIndex);
        if (left != null)
            parts.Add(left);

        return parts.Count == 0 ? null : string.Join("; ", parts);
    }

    private static void AddBorder(List<string> parts, string side, string border)
    {
        if (border != null)
            parts.Add("border-" + side + ": " + border);
    }

    private string DelayStyle(int rowIndex)
    {
        var step = rowIndex - _firstMarkedRow;
        return step > 0 ? "animation-delay: calc(var(--dur-hl-step) * " + step + ")" : null;
    }

    private string SinkLabel(string cellRef, SheetCell cell)
    {
        var label = IsMulti ? Selection.ToRef() + " 고름, " : string.Empty;
        if (cell == null || string.IsNullOrEmpty(cell.Text))
            return label + cellRef + " 칸";

        label += cellRef + " 칸, " + cell.Text;
        if (ShowAsking && cell.IsAsking)
            label += ", 도우미가 물어보는 칸";

        if (LiveChangeIds != null && cell.ChangeIds != null && cell.ChangeIds.Any(id => LiveChangeIds.Contains(id)))
            label += ", 도우미가 바꾼 곳";

        return label;
    }

    private Task HandleSinkInput(ChangeEventArgs e) => OnSinkInput.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private Task HandleSinkKeyDown(KeyboardEventArgs e) => OnSinkKeyDown.InvokeAsync(e);

    private Task HandleSinkBlur() => OnSinkBlur.InvokeAsync();
}
