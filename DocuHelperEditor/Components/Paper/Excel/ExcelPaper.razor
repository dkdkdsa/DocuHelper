@inherits StoreComponentBase
@using System.Text.RegularExpressions
@using DocuHelper.Tools.Excel
@using DocuHelperEditor.State.Papers
@using DocuHelperEditor.Components.Paper
@using Microsoft.Maui.ApplicationModel.DataTransfer
@inject IJSRuntime JS

<div class="excel-paper @PaintingClass" id="@_uid">
    <ExcelRibbon Router="_router" />
    @if (ShowFormulaBar)
    {
        <FormulaBar RefId="@RefId"
                    ContentId="@ContentId"
                    CellRef="@SelectedRef"
                    Range="@SelectionText"
                    Text="@BarText"
                    Version="@_editVersion"
                    Locked="@IsLocked"
                    Editing="@IsEditing"
                    OnFunction="InsertFunctionAsync"
                    OnGoTo="GoTo"
                    OnEdit="HandleBarEdit"
                    OnCommit="HandleBarCommit"
                    OnCancel="HandleBarCancel"
                    OnLeave="HandleBarLeave" />
    }
    @if (_findOpen)
    {
        <SheetFindBar Id="@FindId"
                      Replace="@_findReplace"
                      Query="@_findQuery"
                      Replacement="@_replaceWith"
                      Status="@FindStatus"
                      Note="@_findNote"
                      HasMatches="@(_matches.Count > 0)"
                      FocusVersion="@_findFocus"
                      OnQuery="SetFindQuery"
                      OnReplacementChanged="SetReplacement"
                      OnNext="() => FindStep(1)"
                      OnPrevious="() => FindStep(-1)"
                      OnReplaceOne="ReplaceOne"
                      OnReplaceAll="ReplaceAll"
                      OnToggleReplace="ToggleReplace"
                      OnClose="CloseFind" />
    }
    @if (!string.IsNullOrEmpty(_editError))
    {
        <p class="edit-error" role="alert">@_editError</p>
    }
    @if (_confirm != null)
    {
        <div class="confirm" role="alertdialog" aria-label="확인">
            <p class="confirm-text">@_confirm.Text</p>
            <button type="button" class="confirm-go" @onclick="AcceptConfirm">@_confirm.Button</button>
            <button type="button" class="confirm-no" @onclick="DismissConfirm">취소</button>
        </div>
    }
    <SheetGrid @key="CurrentSheet.Name"
               Sheet="@CurrentSheet"
               SinkId="@SinkId"
               SelectedRef="@SelectedRef"
               Selection="@Selection"
               ExtentRef="@ExtentRef"
               PointRegion="@(IsEditing ? _pointRegion : null)"
               CutRegion="@ClipRegion"
               FillPreview="@_fillPreview"
               ShowFillHandle="@(!IsLocked && !IsEditing)"
               Locked="@IsLocked"
               Zoom="@ZoomValue"
               CellDecorations="@CellDecorations"
               RowDecorations="@RowDecorations"
               CornerDecorations="@CornerDecorations"
               Overlay="@ObjectOverlay"
               CellClassHook="@CellClassHook"
               CellStyleHook="@CellStyleHook"
               EditingInCell="@_editInCell"
               EditingInBar="@_editInBar"
               Draft="@_draft"
               SinkSeed="@_sinkSeed"
               Version="@_editVersion"
               HighlightChangeId="@HighlightChangeId"
               LiveChangeIds="@LiveChangeIds"
               ShowAsking="@IsAskingFile"
               OnPointer="HandlePointer"
               OnPaste="HandlePaste"
               OnResize="HandleResize"
               OnMenu="OpenMenu"
               OnCellDoubleClick="EditFromGrid"
               OnSinkKeyDown="HandleGridKeyAsync"
               OnSinkInput="HandleSinkInput"
               OnSinkBlur="HandleSinkBlur" />
    <ChangeNavigator File="File" />
    <SheetTabs @ref="_tabs"
               Sheets="@Model.Sheets"
               ActiveIndex="@ActiveIndex"
               LiveChangeIds="@LiveChangeIds"
               HighlightChangeId="@HighlightChangeId"
               CanAdd="@(!IsLocked)"
               CanEdit="@(!IsLocked)"
               ShowAskLegend="@ShowAskLegend"
               OnSelect="SelectSheet"
               OnAdd="AddSheet"
               OnMenu="OpenMenu"
               OnRename="RenameSheet" />
    <SheetStatusBar StateText="@StatusText"
                    Stats="@SelectionStats"
                    Range="@SelectionText"
                    ViewMode="@ViewModeValue"
                    PageModesReady="@PageModesReady"
                    Protected="@CurrentSheet.IsProtected"
                    FilterText="@FilterStatus"
                    Zoom="@ZoomValue"
                    OnCommand="RunStatusCommandAsync"
                    OnZoom="SetZoomAsync" />
    @if (_filterMenu is { } filterMenu)
    {
        <FilterMenu Header="@filterMenu.Header"
                    X="@filterMenu.X"
                    Y="@filterMenu.Y"
                    Values="@filterMenu.Values"
                    Checked="@filterMenu.Checked"
                    Active="@filterMenu.Active"
                    Truncated="@filterMenu.Truncated"
                    OnSort="SortFilterMenu"
                    OnClear="ClearFilterMenu"
                    OnApply="ApplyFilterMenu"
                    OnClose="CloseFilterMenu" />
    }
    @if (_menu != null)
    {
        <SheetMenu Label="@MenuLabel" X="@_menu.X" Y="@_menu.Y" Items="@_menuItems" OnPick="PickMenuAsync" OnClose="CloseMenu" />
    }
</div>
