@inherits StoreComponentBase
@using System.Text.RegularExpressions
@using DocuHelper.Tools.Excel
@using DocuHelperEditor.State.Papers
@using DocuHelperEditor.Components.Paper
@using DocuHelperEditor.Components.Paper.Excel.Dialogs
@using DocuHelperEditor.State.Ribbon.Excel
@using Microsoft.Maui.ApplicationModel.DataTransfer
@inject IJSRuntime JS

<div class="excel-paper @PaintingClass" id="@_uid" @ref="_root">
    <ExcelRibbon Router="_router" />
    @if (ShowFormulaBar)
    {
        <FormulaBar RefId="@RefId"
                    ContentId="@ContentId"
                    CellRef="@SelectedRef"
                    Range="@SelectionText"
                    Text="@BarText"
                    Version="@_editVersion"
                    Locked="@IsLocked"
                    Editing="@IsEditing"
                    OnFunction="InsertFunctionAsync"
                    OnGoTo="GoTo"
                    OnEdit="HandleBarEdit"
                    OnCommit="HandleBarCommit"
                    OnCancel="HandleBarCancel"
                    OnLeave="HandleBarLeave" />
    }
    @if (_findOpen)
    {
        <SheetFindBar Id="@FindId"
                      Replace="@_findReplace"
                      Query="@_findQuery"
                      Replacement="@_replaceWith"
                      Status="@FindStatus"
                      Note="@_findNote"
                      HasMatches="@(_matches.Count > 0)"
                      FocusVersion="@_findFocus"
                      OnQuery="SetFindQuery"
                      OnReplacementChanged="SetReplacement"
                      OnNext="() => FindStep(1)"
                      OnPrevious="() => FindStep(-1)"
                      OnReplaceOne="ReplaceOne"
                      OnReplaceAll="ReplaceAll"
                      OnToggleReplace="ToggleReplace"
                      OnClose="CloseFind" />
    }
    @if (CurrentSheet.IsClipped)
    {
        <p class="clip-note" role="status">이 시트에는 100열을 넘는 칸이 있어요. 그 칸은 이 화면에 나타나지 않아요.</p>
    }
    @if (!string.IsNullOrEmpty(_editError))
    {
        <p class="edit-error" role="alert">@_editError</p>
    }
    @if (_confirm != null)
    {
        <div class="confirm" role="alertdialog" aria-label="확인">
            <p class="confirm-text">@_confirm.Text</p>
            <button type="button" class="confirm-go" @onclick="AcceptConfirm">@_confirm.Button</button>
            <button type="button" class="confirm-no" @onclick="DismissConfirm">취소</button>
        </div>
    }
    <SheetPageFrame ViewMode="@ViewModeValue" Setup="@CurrentSheet.Page" Plan="@CurrentPagePlan" Sheet="@CurrentSheet" Zoom="@ZoomValue" SheetName="@CurrentSheet.Name" FileName="@File?.Name">
        <SheetGrid @key="CurrentSheet.Name"
                   Sheet="@CurrentSheet"
                   RenderAllRows="@_renderAllRows"
                   SinkId="@SinkId"
                   SelectedRef="@SelectedRef"
                   Selection="@Selection"
                   ExtentRef="@ExtentRef"
                   PointRegion="@(IsEditing ? _pointRegion : null)"
                   CutRegion="@ClipRegion"
                   FillPreview="@_fillPreview"
                   ShowFillHandle="@(!IsLocked && !IsEditing)"
                   Locked="@IsLocked"
                   Zoom="@ZoomValue"
                   FontName="@Model.DefaultFontName"
                   FontSize="@Model.DefaultFontSize"
                   OnNeedRows="GrowRows"
                   CellDecorations="@CellDecorations"
                   RowDecorations="@RowDecorations"
                   CornerDecorations="@CornerDecorations"
                   Overlay="@ObjectOverlay"
                   CellClassHook="@CellClassHook"
                   CellStyleHook="@CellStyleHook"
                   EditingInCell="@_editInCell"
                   EditingInBar="@_editInBar"
                   Draft="@_draft"
                   SinkSeed="@_sinkSeed"
                   Version="@_editVersion"
                   HighlightChangeId="@HighlightChangeId"
                   LiveChangeIds="@LiveChangeIds"
                   ShowAsking="@IsAskingFile"
                   OnPointer="HandlePointer"
                   OnPaste="HandlePaste"
                   OnResize="HandleResize"
                   OnMenu="OpenMenu"
                   OnCellDoubleClick="EditFromGrid"
                   OnSinkKeyDown="HandleGridKeyAsync"
                   OnSinkInput="HandleSinkInput"
                   OnSinkBlur="HandleSinkBlur" />
    </SheetPageFrame>
    <ChangeNavigator File="File" />
    <SheetTabs @ref="_tabs"
               Sheets="@Model.Sheets"
               ActiveIndex="@ActiveIndex"
               LiveChangeIds="@LiveChangeIds"
               HighlightChangeId="@HighlightChangeId"
               CanAdd="@(!IsLocked)"
               CanEdit="@(!IsLocked)"
               ShowAskLegend="@ShowAskLegend"
               OnSelect="SelectSheet"
               OnAdd="AddSheet"
               OnMenu="OpenMenu"
               OnRename="RenameSheet" />
    <SheetStatusBar StateText="@StatusText"
                    Stats="@SelectionStats"
                    Range="@SelectionText"
                    ViewMode="@ViewModeValue"
                    PageModesReady="@PageModesReady"
                    Protected="@CurrentSheet.IsProtected"
                    FilterText="@FilterStatus"
                    UnreadObjects="@CurrentSheet.UnreadObjects"
                    Zoom="@ZoomValue"
                    OnCommand="RunStatusCommandAsync"
                    OnZoom="SetZoomAsync" />
    @if (_filterMenu is { } filterMenu)
    {
        <FilterMenu Header="@filterMenu.Header"
                    X="@filterMenu.X"
                    Y="@filterMenu.Y"
                    AnchorId="@filterMenu.AnchorId"
                    Values="@filterMenu.Values"
                    Checked="@filterMenu.Checked"
                    Active="@filterMenu.Active"
                    Truncated="@filterMenu.Truncated"
                    OnSort="SortFilterMenu"
                    OnClear="ClearFilterMenu"
                    OnApply="ApplyFilterMenu"
                    OnClose="CloseFilterMenu" />
    }
    <CascadingValue Name="DialogReturnFocus" Value="@DialogReturn">
    @switch (_router.State.ActiveDialog)
    {
        case ExcelDialogIds.ConditionalFormat:
            <ConditionalRuleDialog SheetName="@CurrentSheet.Name" Range="@SelectionText" Apply="ApplyDialog" Close="CloseDialog" />
            break;
        case ExcelDialogIds.Validation:
            <ValidationDialog SheetName="@CurrentSheet.Name" Range="@SelectionText" Apply="ApplyDialog" Close="CloseDialog" />
            break;
        case ExcelDialogIds.ProtectSheet:
            <ProtectSheetDialog SheetName="@CurrentSheet.Name" Apply="ApplyDialog" Close="CloseDialog" />
            break;
        case ExcelDialogIds.Sort:
            <SortDialog SheetName="@CurrentSheet.Name" Range="@SelectionText" Apply="ApplyDialog" Close="CloseDialog" />
            break;
        case ExcelDialogIds.Chart:
            <ChartDialog SheetName="@CurrentSheet.Name" Range="@SelectionText" Apply="ApplyDialog" Close="CloseDialog" />
            break;
        case ExcelDialogIds.Paste:
            <PasteSpecialDialog ClipSheet="@_clip?.Sheet" ClipRef="@_clip?.Region.ToRef()" ClipIsCut="@(_clip?.IsCut == true)" TargetSheet="@CurrentSheet.Name" Target="@SheetRef.Make(Selection.Left, Selection.Top)" Apply="ApplyPaste" Close="CloseDialog" />
            break;
        case ExcelDialogIds.NameManager:
            <NameManagerDialog SheetName="@CurrentSheet.Name" Range="@SelectionText" Names="@Model.Names" Apply="ApplyDialog" Close="CloseDialog" />
            break;
    }
    @if (_router.State.ActiveDialog is { } namedDialog && ExcelNamedDialogs.Has(namedDialog))
    {
        <ExcelFormDialog @key="namedDialog" Id="@namedDialog" Context="@DialogContext" Commit="ApplyDialog" Done="CloseDialog" />
    }
    </CascadingValue>
    @if (_menu != null)
    {
        <SheetMenu Label="@MenuLabel" X="@_menu.X" Y="@_menu.Y" Items="@_menuItems" OnPick="PickMenuAsync" OnClose="CloseMenu" />
    }
</div>
