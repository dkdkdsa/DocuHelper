@using System
@using System.Linq
@using DocuHelperEditor.State.Papers
@if (ViewMode == SheetViewMode.PageLayout)
{
    <div class="pf pf-layout" data-view="pageLayout">
        <div class="pf-sheet" style="@WidthStyle">
            <div class="pf-tag pf-head" aria-hidden="true">머리글 추가</div>
            <div class="pf-paper" style="@PaddingStyle">
                @ChildContent
            </div>
            <div class="pf-tag pf-foot" aria-hidden="true">바닥글 추가</div>
        </div>
    </div>
}
else if (ViewMode == SheetViewMode.PageBreak)
{
    <div class="pf pf-break" data-view="pageBreak">
        @ChildContent
        <div class="pf-watermark" aria-hidden="true">1 페이지</div>
    </div>
}
else
{
    @ChildContent
}

@code {
    private const double CentimetersPerPaperWidth = 21.0;
    private const double PaperWidthPixels = 700.0;
    private const double PixelsPerCentimeter = 37.8;

    private static readonly (int Size, double Width, double Height)[] s_papers =
    {
        (1, 21.59, 27.94),
        (5, 21.59, 35.56),
        (9, 21.0, 29.7),
    };

    [Parameter]
    public string ViewMode { get; set; } = SheetViewMode.Normal;

    [Parameter]
    public SheetPageSetup Setup { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    private string WidthStyle => FormattableString.Invariant($"width: {Width:0.#}px;");

    private string PaddingStyle
    {
        get
        {
            var setup = Setup ?? new SheetPageSetup();
            var factor = Factor;
            var top = setup.MarginTop * PixelsPerCentimeter * factor;
            var right = setup.MarginRight * PixelsPerCentimeter * factor;
            var bottom = setup.MarginBottom * PixelsPerCentimeter * factor;
            var left = setup.MarginLeft * PixelsPerCentimeter * factor;
            return FormattableString.Invariant($"padding: {top:0.#}px {right:0.#}px {bottom:0.#}px {left:0.#}px;");
        }
    }

    private double Width => PaperWidthPixels * Factor;

    private double Factor
    {
        get
        {
            var setup = Setup ?? new SheetPageSetup();
            var paper = s_papers.FirstOrDefault(p => p.Size == setup.PaperSize);
            if (paper.Size == 0)
                paper = s_papers[^1];

            var landscape = setup.Orientation == SheetOrientation.Landscape;
            var widthCm = landscape ? paper.Height : paper.Width;
            return widthCm / CentimetersPerPaperWidth;
        }
    }
}
