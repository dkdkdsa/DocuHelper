@using DocuHelper.Docus
@using DocuHelper.Importers.Hwp
@using DocuHelperEditor.Components.Ui
@using DocuHelperEditor.State
@using DocuHelperEditor.State.Papers
@using DocuHelperEditor.State.Ribbon
@inherits StoreComponentBase
@inject IJSRuntime JS

@if (File != null && Ribbon != null && Ribbon.NavOpen && Model != null)
{
    <aside class="task" aria-label="@Title">
        <div class="head">
            <h2>@Title</h2>
            <IconButton Icon="x" IconSize="18" Label="작업 창 닫기" Title="작업 창 닫기" OnClick="CloseAsync" />
        </div>
        @if (Find)
        {
            var hits = Hits;
            <p class="empty" role="status">@FindCount(hits.Count)</p>
            <ul class="outline">
                @for (var i = 0; i < hits.Count; i++)
                {
                    var hit = hits[i];
                    <li>
                        <button type="button" class="link" aria-label="@($"{hit.Page}쪽, 찾은 곳 {i + 1}")" @onclick="() => GoToHitAsync(hit)">@hit.Before<mark>@hit.Match</mark>@hit.After</button>
                    </li>
                }
            </ul>
        }
        else if (Outline)
        {
            <ul class="outline">
                @foreach (var item in Headings)
                {
                    <li style="@IndentOf(item.Level)">
                        <button type="button" class="link" aria-label="@($"{item.Text}, {Model.FindBlock(item.BlockId)?.Page}쪽으로 이동")" @onclick="() => GoToBlockAsync(item.BlockId)">@item.Text</button>
                    </li>
                }
            </ul>
            @if (Headings.Count == 0)
            {
                <p class="empty">제목 스타일이 있는 문단이 없어요. 제목 1, 제목 2를 쓰면 여기에 나와요.</p>
            }
        }
        else
        {
            <PageThumbnails Model="Model" Current="Ribbon.CurrentPage" OnPick="GoToPageAsync" />
        }
    </aside>
}

@code {
    private WordPaperModel _paper;
    private IReadOnlyList<HwpOutlineItem> _headings = Array.Empty<HwpOutlineItem>();

    [Parameter]
    public WorkspaceFile File { get; set; }

    private HwpRibbonState Ribbon => HwpRibbonState.Of(File);

    private WordPaperModel Model => File?.Paper as WordPaperModel;

    private bool Outline => Ribbon?.NavPane == "outline";

    private bool Find => Ribbon?.NavPane == "find";

    private string Title => Find ? "찾기 결과" : Outline ? "개요 보기" : "쪽 모양 보기";

    private IReadOnlyList<WordNavHit> Hits => WordNavResults.Find(Model, Ribbon?.FindQuery, Ribbon?.FindMatchCase ?? false, Ribbon?.FindWholeWord ?? false);

    private static string FindCount(int count) => count == 0 ? "찾은 곳이 없어요." : $"{count}곳에서 찾았어요.";

    private IReadOnlyList<HwpOutlineItem> Headings
    {
        get
        {
            if (!ReferenceEquals(_paper, File?.Paper))
            {
                _paper = File?.Paper as WordPaperModel;
                _headings = File?.Docu is WordDocu word ? HwpOutline.Detect(word) : Array.Empty<HwpOutlineItem>();
            }

            return _headings;
        }
    }

    private static string IndentOf(int level) => $"padding-left: {Math.Max(0, level - 1) * 14}px";

    private async Task GoToPageAsync(int page)
    {
        Ribbon.CurrentPage = page;
        Ribbon.Touch();
        await ScrollAsync($"article[aria-label=\"{page}쪽\"]");
    }

    private async Task GoToBlockAsync(string blockId)
    {
        var block = Model.FindBlock(blockId);
        if (block == null)
            return;

        Ribbon.CurrentPage = block.Page;
        Ribbon.Touch();
        await ScrollAsync($"[data-block=\"{blockId}\"]");
    }

    private async Task GoToHitAsync(WordNavHit hit)
    {
        Model.SelectedBlockId = hit.BlockId;
        Model.Selection = new WordSelection(WordSelectionKind.Text, null, new[] { new WordSelectionRange(hit.BlockId, hit.Start, hit.End) });
        Ribbon.CurrentPage = hit.Page;
        Ribbon.Touch();
        Workspace.SetSelection(Model.Describe(Model.FindBlock(hit.BlockId)));
        Workspace.Notify();
        await WordSelectionService.RestoreAsync(JS, Model.Selection);
        await ScrollAsync($"[data-block=\"{hit.BlockId}\"]");
    }

    private Task CloseAsync()
    {
        Ribbon.NavOpen = false;
        Ribbon.Touch();
        Workspace.Notify();
        return Task.CompletedTask;
    }

    private async Task ScrollAsync(string selector)
    {
        try
        {
            await JS.InvokeVoidAsync("docuHelper.scrollIntoView", selector);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
