@using DocuHelper.Dash.Elements
@using DocuHelper.Dash.Runtime

@if (Result != null && Result.Visible)
{
    <div class="el @KindClass @(Context.IsLive(Result.Source?.Id) ? "live" : null)" style="@(Placement + (Result is ShapeResult or LineResult ? DashCss.Opacity(Result.Style) : DashCss.Box(Result.Style, Context.PageWidth)))" data-el="@Result.Source?.Id" data-key="@Result.Key">
        @switch (Result)
        {
            case RepeatResult repeat:
                <DashRepeatView Result="repeat" />
                break;
            case ShapeResult shape:
                <DashShapeView Result="shape" />
                break;
            case TextResult text:
                <DashTextView Result="text" />
                break;
            case LineResult line:
                <DashLineView Result="line" />
                break;
            case ChartResult chart:
                <DashChartView Result="chart" />
                break;
            case TableResult table:
                <DashTableView Result="table" />
                break;
            case MeterResult meter:
                <DashMeterView Result="meter" />
                break;
            case SliderResult slider:
                <DashSliderView Result="slider" />
                break;
            case RangeSliderResult range:
                <DashRangeSliderView Result="range" />
                break;
            case ToggleResult toggle:
                <DashToggleView Result="toggle" />
                break;
            case ChoiceResult choice when choice.Source is SelectElement:
                <DashSelectView Result="choice" />
                break;
            case ChoiceResult choice:
                <DashSegmentedView Result="choice" />
                break;
            case ButtonResult button:
                <DashButtonView Result="button" />
                break;
            default:
                @if (Result.Source is FlowElement flow)
                {
                    <div class="flow" style="@DashCss.Flow(Result.Style, flow is RowElement ? "row" : "column", Context.PageWidth)">
                        @foreach (var child in Result.Children)
                        {
                            <DashElementView @key="child.Key" Result="child" Placement="@DashCss.FlowItem(child.Style, Context.PageWidth)" />
                        }
                    </div>
                }
                else if (Result.Source is CanvasElement)
                {
                    <div class="canvas">
                        @foreach (var child in Result.Children)
                        {
                            <DashElementView @key="child.Key" Result="child" Placement="@DashCss.Absolute(child.Style, Result.Style?.W ?? DashCss.DefaultWidth, Result.Style?.H ?? DashCss.DefaultHeight)" />
                        }
                    </div>
                }
                break;
        }
        @if (Context.IsEditing && !string.IsNullOrEmpty(Result.Problem))
        {
            <span class="problem" title="@Result.Problem">@Result.Problem</span>
        }
    </div>
}

@code {
    [Parameter]
    public ElementResult Result { get; set; }

    [Parameter]
    public string Placement { get; set; }

    [CascadingParameter]
    public DashRenderContext Context { get; set; }

    private string KindClass => "k-" + (Result?.Source?.Kind ?? "unknown");
}
