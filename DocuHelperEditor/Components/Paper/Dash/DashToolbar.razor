@using System.Globalization
@using System.IO
@using DocuHelper.Dash
@using DocuHelper.Dash.Logic
@using DocuHelperEditor.State.Papers
@inherits StoreComponentBase

@if (Model != null && Commands != null)
{
    <div class="bar @(IsView ? "view" : null)" role="toolbar" aria-label="대시보드 도구">
        @if (IsView)
        {
            <div class="head">
                <h1 class="title">@Title</h1>
                <p class="status" aria-live="polite">@StatusText</p>
            </div>
            <button type="button" class="btn" @onclick="ReloadAsync">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path d="M8 16H3v5" /></svg>엑셀 다시 읽기
            </button>
            @ModeControl
            <button type="button" class="btn" @onclick="ExportAsync">PDF로 저장</button>
        }
        else
        {
            @ModeControl
            @if (IsEdit)
            {
                <span class="vsep" aria-hidden="true"></span>
                @foreach (var tool in s_tools)
                {
                    var current = tool;
                    <button type="button" class="tool" title="@current.Tip" disabled="@Blocked(current.Id)" @onclick="() => InsertAsync(current)">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@current.Icon" /></svg>@current.Label
                    </button>
                }
                <div class="drop">
                    <button type="button" class="tool" aria-expanded="@(_open ? "true" : "false")" aria-haspopup="menu" title="단추, 슬라이더 같은 조절 장치 넣기" disabled="@Blocked(DashToolbarItems.ControlId)" @onclick="() => _open = !_open">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M2 14h4 M10 8h4 M18 16h4" /></svg>조절 장치<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    @if (_open)
                    {
                        <div class="shield" @onclick="() => _open = false"></div>
                        <ul class="menu" aria-label="조절 장치 넣기" @onkeydown="MenuKey">
                            @foreach (var control in s_controls)
                            {
                                var current = control;
                                <li>
                                    <button type="button" class="item" @onclick="() => InsertAsync(current)">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@current.Icon" /></svg>
                                        <span><b>@current.Label</b><small>@current.Tip</small></span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <span class="vsep" aria-hidden="true"></span>
                <button type="button" class="icon" aria-label="되돌리기" title="@TitleOf(DashRibbonCommands.UndoId, "되돌리기 (Ctrl+Z)")" disabled="@Commands.IsDisabled(DashRibbonCommands.UndoId)" @onclick="() => RunAsync(DashRibbonCommands.UndoId)">
                    <Icon Name="undo" Size="18" />
                </button>
                <button type="button" class="icon" aria-label="다시 하기" title="@TitleOf(DashRibbonCommands.RedoId, "다시 하기 (Ctrl+Y)")" disabled="@Commands.IsDisabled(DashRibbonCommands.RedoId)" @onclick="() => RunAsync(DashRibbonCommands.RedoId)">
                    <Icon Name="redo" Size="18" />
                </button>
                <span class="vsep" aria-hidden="true"></span>
                <button type="button" class="icon" aria-label="작게 보기" title="작게 보기" @onclick="() => ZoomAsync(-10)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /></svg>
                </button>
                <span class="zoom" aria-live="polite">@ZoomText</span>
                <button type="button" class="icon" aria-label="크게 보기" title="크게 보기" @onclick="() => ZoomAsync(10)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                </button>
                <button type="button" class="tool" @onclick="() => RunAsync(DashToolbarItems.FitId)">화면에 맞추기</button>
            }
        }
    </div>
}

@code {
    private static readonly DashToolbarItem[] s_tools = DashToolbarItems.Tools;
    private static readonly DashToolbarItem[] s_controls = DashToolbarItems.Controls;

    private bool _open;

    [Parameter]
    public WorkspaceFile File { get; set; }

    [Parameter]
    public DashPaperModel Model { get; set; }

    [Parameter]
    public DashViewState State { get; set; }

    [Parameter]
    public DashRibbonCommands Commands { get; set; }

    [Parameter]
    public EventCallback<int> OnZoom { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string Mode => State?.Mode ?? DashViewState.ViewMode;

    private bool IsView => Mode == DashViewState.ViewMode;

    private bool IsEdit => Mode == DashViewState.EditMode;

    private string Title => Path.GetFileNameWithoutExtension(File?.Name ?? string.Empty);

    private string ZoomText => State == null || State.FitRequested ? "맞춤" : State.Zoom.ToString(CultureInfo.InvariantCulture) + "%";

    private string StatusText
    {
        get
        {
            var files = Model?.Document?.Sources
                .Where(source => source != null && !string.IsNullOrWhiteSpace(source.File))
                .Select(source => source.File)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ?? new List<string>();
            var text = files.Count == 0
                ? "읽는 엑셀이 아직 없어요."
                : "읽는 파일: " + string.Join(", ", files.Select(file => $"‘{file}’")) + ".";
            return Model?.IsPreviewing == true ? text + " 바꿔 보는 중이에요. 파일에는 적히지 않아요." : text;
        }
    }

    private bool Blocked(string id) => Commands == null || Commands.IsDisabled(id);

    private string TitleOf(string id, string title)
    {
        var reason = Commands.DisabledReasonOf(id);
        return string.IsNullOrEmpty(reason) ? title : $"{title} · {reason}";
    }

    private RenderFragment ModeControl => __builder =>
    {
        <div class="seg" role="group" aria-label="대시보드 모드">
            <button type="button" aria-pressed="@(IsView ? "true" : "false")" @onclick="() => RunAsync(DashToolbarItems.ViewId)">보기</button>
            <button type="button" aria-pressed="@(IsEdit ? "true" : "false")" @onclick="() => RunAsync(DashToolbarItems.EditId)">고치기</button>
            <button type="button" aria-pressed="@(Mode == DashViewState.DataMode ? "true" : "false")" @onclick="() => RunAsync(DashToolbarItems.DataId)">데이터</button>
        </div>
    };

    private async Task RunAsync(string id)
    {
        _open = false;
        await Commands.InvokeAsync(id, null);
        await OnChanged.InvokeAsync();
    }

    private async Task InsertAsync(DashToolbarItem item)
    {
        _open = false;
        if (item.ValueName)
        {
            var name = Model.Document.Values.FirstOrDefault(value => value != null && value is not StepsTable && !string.IsNullOrWhiteSpace(value.Name))?.Name;
            if (name == null)
                Commands.Notify("글자로 넣을 값이 아직 없어요. 데이터에서 값을 먼저 만들어 주세요.");
            else
                Commands.InsertValue(name);
        }
        else
        {
            await Commands.InvokeAsync(item.Id, item.Arg);
        }

        await OnChanged.InvokeAsync();
    }

    private Task ReloadAsync()
    {
        Model?.Reload();
        return OnChanged.InvokeAsync();
    }

    private Task ExportAsync() => Commands.ExportPdfFromPageAsync();

    private Task ZoomAsync(int step) => OnZoom.InvokeAsync((State?.Zoom ?? 100) + step);

    private void MenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _open = false;
    }
}
