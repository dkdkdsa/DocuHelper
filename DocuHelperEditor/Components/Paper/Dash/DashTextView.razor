@using DocuHelper.Dash.Runtime

<p class="text" style="@DashCss.Text(Result.Style, Context.PageWidth)">
    <span class="@(Mark == null ? null : "mark")" style="@(Mark == null ? null : "--mark: " + Mark)">
        @foreach (var run in Result.Runs)
        {
            switch (run.Kind)
            {
                case TextRunKind.Value:
                    <span class="@(Context.IsEditing ? "bound" : null)">@run.Text</span>
                    break;
                case TextRunKind.Missing:
                    <span class="missing" title="@($"‘{run.Name}’ 값을 찾을 수 없어요")">@run.Text</span>
                    break;
                default:
                    @run.Text
                    break;
            }
        }
    </span>
</p>

@code {
    [Parameter]
    public TextResult Result { get; set; }

    [CascadingParameter]
    public DashRenderContext Context { get; set; }

    private string Mark => DashCss.Color(Result?.Style?.Mark);
}
