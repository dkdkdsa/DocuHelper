@using System.Globalization
@using DocuHelper.Dash.Logic
@using DocuHelper.Dash.Runtime
@using DocuHelperEditor.Components.Paper
@using DocuHelperEditor.Components.Paper.Ppt
@using DocuHelperEditor.State.Papers
@inherits StoreComponentBase
@inject IJSRuntime JS

@if (File?.Paper is DashPaperModel model)
{
    <div class="dash" @ref="_root">
        <DashRibbon @ref="_ribbonHost" File="File" State="_state" OnChanged="Redraw" />
        <div class="body @(Locked ? "locked" : null)">
            @if (Mode == DashViewState.DataMode)
            {
                <DashDataView Model="model" State="_state" Commands="_ribbonHost?.Commands" Locked="Locked" OnChanged="Redraw" OnOpenElement="OpenElement" />
            }
            else
            {
                if (Mode == DashViewState.EditMode)
                {
                    <DashSidePane Model="model" State="_state" Commands="_ribbonHost?.Commands" Locked="Locked" OnSelect="pick => PickFromPane(pick.Id, pick.Additive)" OnEditText="StartText" />
                }

                <div class="stage">
                    <div class="frame" style="--page-max: @PageMax">
                        <CascadingValue Value="ContextOf(model)">
                            <DashCanvas Model="model" State="_state" Label="@File.Name" Locked="Locked" OnGesture="g => GestureAsync(model, g)" OnEditText="StartText" />
                        </CascadingValue>
                    </div>
                </div>
            }
        </div>
        <DashStatusBar Model="model" State="_state" Commands="_ribbonHost?.Commands" OnZoom="SetZoom" />
        <DialogHost Presenter="_presenter" />
        <ChangeNavigator File="File" />
    </div>
}

@code {
    private const int BaseWidth = 760;

    private readonly DialogPresenter _presenter = new();
    private ElementReference _root;
    private WheelZoom _wheel;
    private DashRibbon _ribbonHost;

    [Parameter]
    public WorkspaceFile File { get; set; }

    private DashViewState _state => DashViewState.Of(File) ?? new DashViewState();

    private bool Locked => File?.Activity == FileActivity.Editing;

    private string Mode => _state.Mode ?? DashViewState.ViewMode;

    private string PageMax => _state.FitRequested ? "100%" : (BaseWidth * _state.Zoom / 100).ToString(CultureInfo.InvariantCulture) + "px";

    protected override void OnInitialized() => _state.Dialogs = _presenter;

    protected override void OnParametersSet()
    {
        if (_state.Mode == null && File?.Paper is DashPaperModel model)
            _state.Mode = model.IsBlank ? DashViewState.EditMode : DashViewState.ViewMode;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_root.Id != null)
        {
            _wheel ??= new WheelZoom(JS, ZoomStepAsync);
            await _wheel.AttachAsync(_root);
        }

        if (firstRender && _ribbonHost != null)
            StateHasChanged();

        var selected = Workspace.SelectedChangeId;
        if (selected == _seenChangeId && Workspace.ChangePickVersion == _seenPickVersion)
            return;

        _seenChangeId = selected;
        _seenPickVersion = Workspace.ChangePickVersion;
        if (string.IsNullOrEmpty(selected) || File?.Docu?.Changes.Any(change => change.Id == selected) != true)
            return;

        try
        {
            await JS.InvokeVoidAsync("docuHelper.scrollIntoView", $"[data-change=\"{selected}\"]");
        }
        catch (JSException)
        {
        }
    }

    private string _seenChangeId;
    private int _seenPickVersion = -1;

    protected override void OnDispose() => _ = _wheel?.Detach();

    private DashRenderContext ContextOf(DashPaperModel model) => new()
    {
        PageWidth = model.PageWidth,
        PageHeight = model.PageHeight,
        Mode = Mode,
        IsLocked = Locked,
        Selected = _state.Selected,
        LiveChanges = (File.Docu?.Changes ?? new List<DocuChange>()).SelectMany(change => change.Anchors).ToHashSet(StringComparer.Ordinal),
        ChangeIds = ChangeIdsOf(File.Docu),
        EditingId = _state.EditingId,
        CommitText = (id, text) => CommitTextAsync(model, id, text),
        CancelText = CancelTextAsync,
        SetParam = (name, value) => SetParamAsync(model, name, value),
        RunAction = (action, item) => RunActionAsync(model, action, item),
    };

    private Task GestureAsync(DashPaperModel model, SlideGesture gesture)
    {
        if (gesture == null || Locked || Mode != DashViewState.EditMode)
            return Task.CompletedTask;

        if (gesture.Kind == "select")
        {
            Select(gesture.Id, gesture.Additive);
            StateHasChanged();
            return Task.CompletedTask;
        }

        var commands = DashCanvasEdits.Plan(gesture, model, _state.Selected);
        if (commands.Count == 0)
            return Task.CompletedTask;

        var result = commands.Count == 1 ? Workspace.ApplyEdit(File, commands[0]) : Workspace.ApplyEdits(File, commands);
        if (result.IsError)
            _ribbonHost?.Commands?.Notify(result.Content);
        else if (gesture.Kind == "key" && gesture.Key is "Delete" or "Backspace")
            _state.Selected.Clear();

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Select(string id, bool additive)
    {
        if (string.IsNullOrEmpty(id))
        {
            _state.Selected.Clear();
            return;
        }

        if (!additive)
        {
            _state.Selected.Clear();
            _state.Selected.Add(id);
            return;
        }

        if (!_state.Selected.Remove(id))
            _state.Selected.Add(id);
    }

    private void PickFromPane(string id, bool additive)
    {
        if (Locked || Mode != DashViewState.EditMode)
            return;

        Select(id, additive);
    }

    private Task OpenElement(string id)
    {
        _state.Mode = DashViewState.EditMode;
        _state.EditingId = null;
        _state.Selected.Clear();
        if (!string.IsNullOrEmpty(id))
            _state.Selected.Add(id);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void StartText(string id)
    {
        if (Locked || Mode != DashViewState.EditMode)
            return;

        Select(id, false);
        _state.EditingId = id;
        StateHasChanged();
    }

    private Task CommitTextAsync(DashPaperModel model, string id, string text)
    {
        _state.EditingId = null;
        var current = model.Document.Find(id) switch
        {
            DocuHelper.Dash.Elements.TextElement element => element.Text,
            DocuHelper.Dash.Elements.ShapeElement shape => shape.Text,
            _ => null,
        };
        if (!string.Equals(current ?? string.Empty, text ?? string.Empty, StringComparison.Ordinal))
        {
            var result = Workspace.ApplyEdit(File, DashCanvasEdits.Text(id, text));
            if (result.IsError)
                _ribbonHost?.Commands?.Notify(result.Content);
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task CancelTextAsync()
    {
        _state.EditingId = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task SetParamAsync(DashPaperModel model, string name, object value)
    {
        model.SetParam(name, value);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RunActionAsync(DashPaperModel model, DashAction action, IReadOnlyDictionary<string, object> item)
    {
        switch (action)
        {
            case SetAction:
            case ResetAction:
                model.RunAction(action, item);
                break;
            case RefreshAction:
                model.Reload();
                break;
            case AskAction ask:
                var text = FillAsk(model, ask.Text, item);
                if (_ribbonHost?.Commands != null)
                    await _ribbonHost.Commands.PrefillAsync(text);
                break;
            case OpenAction open:
                var target = Workspace.Files.FirstOrDefault(file => string.Equals(file.Name, open.File, StringComparison.OrdinalIgnoreCase));
                if (target != null)
                    Workspace.Open(target.Id);
                else
                    _ribbonHost?.Commands?.Notify($"‘{open.File}’ 파일을 작업 폴더에서 찾을 수 없어요.");
                break;
            case PdfAction:
                if (_ribbonHost?.Commands != null)
                    await _ribbonHost.Commands.ExportPdfFromPageAsync();
                break;
        }

        StateHasChanged();
    }

    private static string FillAsk(DashPaperModel model, string template, IReadOnlyDictionary<string, object> item)
    {
        var text = template ?? string.Empty;
        if (item != null)
        {
            foreach (var pair in item)
                text = text.Replace("«item." + pair.Key + "»", DashFormats.Display(pair.Value, null), StringComparison.Ordinal);
        }

        return new DashScope(model.Runtime).FillText(text);
    }

    private Task ZoomStepAsync(int direction)
    {
        SetZoom(_state.Zoom + direction * 10);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void SetZoom(int value)
    {
        _state.Zoom = Math.Clamp(value, DashViewState.MinZoom, DashViewState.MaxZoom);
        _state.FitRequested = false;
    }

    private void Redraw() => StateHasChanged();

    private static Dictionary<string, string> ChangeIdsOf(Docu docu)
    {
        var ids = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var change in docu?.Changes ?? new List<DocuChange>())
        {
            foreach (var anchor in change.Anchors)
                ids[anchor] = change.Id;
        }

        return ids;
    }
}
