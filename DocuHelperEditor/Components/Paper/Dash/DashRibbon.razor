@inherits StoreComponentBase
@inject IJSRuntime JS
@inject IClipboardService Clipboard
@inject IFileDialogService Dialogs
@inject IPrintService Prints

<Ribbon Tabs="DashRibbonData.Tabs" @bind-ActiveTab="State.Tab" @bind-IsOpen="State.RibbonOpen" FileItems="DashRibbonData.FileItems" Host="_commands" Format="DocuType.Dash" Disabled="_commands.IsLocked">
    <Trailing>
        <IconButton Icon="undo" IconSize="18" Label="실행 취소" Title="@TitleOf(DashRibbonCommands.UndoId, "실행 취소 (Ctrl+Z)")" Disabled="@_commands.IsDisabled(DashRibbonCommands.UndoId)" OnClick="Undo" />
        <IconButton Icon="redo" IconSize="18" Label="다시 실행" Title="@TitleOf(DashRibbonCommands.RedoId, "다시 실행 (Ctrl+Y)")" Disabled="@_commands.IsDisabled(DashRibbonCommands.RedoId)" OnClick="Redo" />
    </Trailing>
</Ribbon>

@code {
    private DashRibbonCommands _commands;

    public DashRibbonCommands Commands => _commands;

    [Parameter]
    public WorkspaceFile File { get; set; }

    [Parameter]
    public DashViewState State { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    protected override void OnInitialized()
    {
        _commands = new DashRibbonCommands(Workspace, Assistant, JS, State, Clipboard, Dialogs, Prints);
        _commands.Changed += OnCommandsChanged;
    }

    protected override void OnParametersSet() => _commands.File = File;

    protected override void OnDispose()
    {
        if (_commands != null)
            _commands.Changed -= OnCommandsChanged;
    }

    private Task Undo() => _commands.InvokeAsync(DashRibbonCommands.UndoId, null);

    private Task Redo() => _commands.InvokeAsync(DashRibbonCommands.RedoId, null);

    private string TitleOf(string id, string title)
    {
        var reason = _commands.DisabledReasonOf(id);
        return string.IsNullOrEmpty(reason) ? title : $"{title} · {reason}";
    }

    private void OnCommandsChanged()
    {
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await OnChanged.InvokeAsync();
        });
    }
}
