@using System.Globalization
@using DocuHelper.Docus
@using DocuHelperEditor.Components.Ribbon
@using DocuHelperEditor.State.Papers

<StatusBar Format="DocuType.Dash" Label="상태 표시줄" Left="Left" Right="Right" />

@code {
    [Parameter]
    public DashPaperModel Model { get; set; }

    [Parameter]
    public DashViewState State { get; set; }

    [Parameter]
    public DashRibbonCommands Commands { get; set; }

    [Parameter]
    public EventCallback<int> OnZoom { get; set; }

    private string Mode => State?.Mode ?? DashViewState.ViewMode;

    private int Zoom => State?.Zoom ?? 100;

    private int ElementCount => Model?.Document == null ? 0 : Model.Document.Walk().Count() - 1;

    private int SelectedCount => State?.Selected.Count ?? 0;

    private int ProblemCount => Model?.Problems.Count ?? 0;

    private bool Previewing => Model?.IsPreviewing == true;

    private static string Text(int value) => value.ToString(CultureInfo.InvariantCulture);

    private Task Command(string id) => Commands?.InvokeAsync(id, null) ?? Task.CompletedTask;

    private Task SetZoomAsync(int value) => OnZoom.InvokeAsync(value);

    private RenderFragment Left => __builder =>
    {
        <StatusButton Tip="페이지에 놓인 것">요소 @Text(ElementCount)개</StatusButton>
        @if (SelectedCount > 0)
        {
            <StatusButton Tip="고른 요소 수">@Text(SelectedCount)개 선택</StatusButton>
        }
        @if (Previewing)
        {
            <RibbonDivider Gap="6" />
            <StatusButton Tip="바꿔 본 조절값을 처음 값으로 돌려요" OnClick='() => Command("dash.data.resetParams")'>미리 보기 중 · 처음 값으로</StatusButton>
        }
        @if (ProblemCount > 0)
        {
            <RibbonDivider Gap="6" />
            <StatusButton Tip="@string.Join("\n", Model.Problems)">확인할 것 @Text(ProblemCount)개</StatusButton>
        }
    };

    private RenderFragment Right => __builder =>
    {
        <span class="views" role="group" aria-label="보기">
            <StatusButton Icon="read" Label="보기" Tip="보기" Pressed="@(Mode == DashViewState.ViewMode)" OnClick='() => Command("dash.view.show")' />
            <StatusButton Icon="normal" Label="고치기" Tip="고치기" Pressed="@(Mode == DashViewState.EditMode)" OnClick='() => Command("dash.view.edit")' />
            <StatusButton Icon="table" Label="데이터" Tip="데이터" Pressed="@(Mode == DashViewState.DataMode)" OnClick='() => Command("dash.view.data")' />
        </span>
        <RibbonDivider Gap="4" />
        <ZoomControl Value="Zoom" ValueChanged="SetZoomAsync" SliderWidth="92" />
        <StatusButton Icon="fit" Label="창에 맞춤" Tip="창에 맞춤" OnClick='() => Command("dash.view.fit")' />
    };
}
