@using DocuHelperEditor.State.Papers
@inherits StoreComponentBase

<div class="toolbar">
    <IconButton Icon="undo" Label="되돌리기" Title="되돌리기 (Ctrl+Z)" IconSize="18" Disabled="@IsLocked" OnClick="UndoAsync" />
    <IconButton Icon="redo" Label="다시 하기" Title="다시 하기 (Ctrl+Y)" IconSize="18" Disabled="@IsLocked" />
    <ToolbarDivider />
    <label for="@StyleId" class="sr-only">문단 모양</label>
    <select id="@StyleId" class="style" value="@StyleValue" disabled="@(!CanStyle)" @onchange="OnStyleChanged" @key="_styleVersion">
        <option value="body">본문</option>
        <option value="h1">제목 1</option>
        <option value="h2">제목 2</option>
    </select>
    <ToolbarDivider />
    <IconButton Icon="bold" Label="굵게" IconSize="18" Stroke="2.4" Pressed="@(Block?.IsBold == true)" Disabled="@(!CanFormat)" OnClick="ToggleBold" />
    <IconButton Icon="italic" Label="기울임" IconSize="18" Pressed="@(Block?.IsItalic == true)" Disabled="@(!CanFormat)" OnClick="ToggleItalic" />
    <IconButton Icon="underline" Label="밑줄" IconSize="18" Pressed="@(Block?.IsUnderline == true)" Disabled="@(!CanFormat)" OnClick="ToggleUnderline" />
    <ToolbarDivider />
    <IconButton Icon="list" Label="글머리 기호" IconSize="18" Pressed="@(Block?.ListKind == WordListKind.Bullet)" Disabled="@(!CanList)" OnClick="ToggleBullets" />
    <IconButton Icon="list-ordered" Label="번호 매기기" IconSize="18" Pressed="@(Block?.ListKind == WordListKind.Number)" Disabled="@(!CanList)" OnClick="ToggleNumbers" />
    <ToolbarDivider />
    <IconButton Icon="align-left" Label="왼쪽 맞춤" IconSize="18" Pressed="@(IsAligned(WordAlignment.Left))" Disabled="@(!CanStyle)" OnClick="AlignLeft" />
    <IconButton Icon="align-center" Label="가운데 맞춤" IconSize="18" Pressed="@(IsAligned(WordAlignment.Center))" Disabled="@(!CanStyle)" OnClick="ToggleCenter" />
    <ToolbarDivider />
    <IconButton Icon="table" Label="표 넣기" IconSize="18" Disabled="@IsLocked" OnClick="InsertTable" />
</div>

@code {
    private const string StyleId = "word-style";
    private const int NewTableSize = 3;

    private int _styleVersion;

    [Parameter]
    public WorkspaceFile File { get; set; }

    private WordPaperModel Model => File?.Paper as WordPaperModel;

    private WordBlockModel Block => Model?.SelectedBlock;

    private bool IsLocked => File?.Activity == FileActivity.Editing;

    private bool CanFormat => Block != null && !IsLocked;

    private bool CanStyle => CanFormat && !Block.IsTable;

    private bool CanList => CanFormat && Block.Kind == WordBlockKind.Body;

    private string StyleValue => Block?.Kind switch
    {
        WordBlockKind.Heading1 => "h1",
        WordBlockKind.Heading2 => "h2",
        _ => "body",
    };

    private bool IsAligned(WordAlignment alignment) => Block != null && !Block.IsTable && Block.Alignment == alignment;

    private Task UndoAsync() => Workspace.UndoAsync();

    private void OnStyleChanged(ChangeEventArgs e)
    {
        _styleVersion++;
        var value = e.Value?.ToString();
        var block = Block;
        if (block == null || !CanStyle || value == StyleValue)
            return;

        var style = value switch
        {
            "h1" => "heading1",
            "h2" => "heading2",
            _ => "body",
        };

        Format(new { id = block.Id, style });
    }

    private void ToggleBold()
    {
        var block = Block;
        if (block != null)
            Format(new { id = block.Id, bold = !block.IsBold });
    }

    private void ToggleItalic()
    {
        var block = Block;
        if (block != null)
            Format(new { id = block.Id, italic = !block.IsItalic });
    }

    private void ToggleUnderline()
    {
        var block = Block;
        if (block != null)
            Format(new { id = block.Id, underline = !block.IsUnderline });
    }

    private void ToggleBullets() => ToggleList(WordListKind.Bullet);

    private void ToggleNumbers() => ToggleList(WordListKind.Number);

    private void ToggleList(WordListKind style)
    {
        var block = Block;
        if (block == null || block.Kind != WordBlockKind.Body)
            return;

        var next = block.ListStyle == style ? "body" : style == WordListKind.Bullet ? "bullet" : "number";
        Format(new { id = block.Id, style = next });
    }

    private void AlignLeft()
    {
        var block = Block;
        if (block != null && !block.IsTable && block.Alignment != WordAlignment.Left)
            Format(new { id = block.Id, align = "left" });
    }

    private void ToggleCenter()
    {
        var block = Block;
        if (block != null && !block.IsTable)
            Format(new { id = block.Id, align = block.Alignment == WordAlignment.Center ? "left" : "center" });
    }

    private void InsertTable()
    {
        if (File == null || IsLocked)
            return;

        var rows = Enumerable.Range(0, NewTableSize).Select(_ => Enumerable.Repeat(string.Empty, NewTableSize).ToArray()).ToArray();
        var result = Workspace.ApplyEdit(File, EditCommand.Create("insert_table", new { after = Block?.Id ?? "end", rows, header = true }));
        var model = Model;
        var table = result.IsError ? null : model?.FindBlock(result.Change?.Anchors.FirstOrDefault());
        if (table == null)
        {
            Workspace.Notify();
            return;
        }

        model.SelectedBlockId = table.Id;
        Workspace.SetSelection(model.Describe(table));
    }

    private void Format(object arguments)
    {
        var block = Block;
        if (block == null || IsLocked || File == null)
            return;

        var id = block.Id;
        Workspace.ApplyEdit(File, EditCommand.Create("format_paragraph", arguments));
        var model = Model;
        var updated = model?.FindBlock(id);
        if (updated != null)
            Workspace.SetSelection(model.Describe(updated));
        else
            Workspace.Notify();
    }
}
