@using DocuHelperEditor.Components.Paper
@using DocuHelperEditor.Components.Paper.Hwp
@using DocuHelperEditor.Components.Paper.Word.Dialogs
@using DocuHelperEditor.State.Papers
@using DocuHelperEditor.State.Ribbon
@inherits StoreComponentBase

<div class="word">
    @if (File?.Type == DocuType.Hwp)
    {
        @if (HwpRibbonState.Of(File)?.FullScreen != true)
        {
            <HwpRibbonHost File="File" />
        }
    }
    else
    {
        <WordRibbonHost File="File" />
    }

    <WordPage File="File" />
    <WordDialogHost File="File" />
    @if (File?.Type == DocuType.Hwp)
    {
        <HwpStatusBar File="File" />
    }
    else
    {
        <WordStatusBar File="File" />
    }
</div>

@code {
    private WorkspaceFile _boundFile;

    [Parameter]
    public WorkspaceFile File { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_boundFile, File))
            return;

        _boundFile = File;
        if (File?.Paper is WordPaperModel model && string.IsNullOrEmpty(Workspace.SelectionLabel))
            model.SelectedBlockId = null;
    }
}
