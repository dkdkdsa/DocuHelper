@inject WorkspaceStore Workspace
@inject IFileDialogService FileDialog

<section class="drop" aria-labelledby="start-drop-title">
    <div class="art" aria-hidden="true">
        <div class="card slide">
            <span class="slide-title"></span>
            <span class="bars">
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
                <span class="bar bar-4"></span>
            </span>
        </div>
        <div class="card doc">
            <span class="doc-title"></span>
            <span class="line line-1"></span>
            <span class="line line-2"></span>
            <span class="line line-3"></span>
            <span class="line line-4"></span>
            <span class="line line-5"></span>
        </div>
        <div class="sheet">
            <span class="head edge-r edge-b"></span>
            <span class="head edge-r edge-b"></span>
            <span class="head edge-b"></span>
            <span class="edge-r edge-b"></span>
            <span class="edge-r edge-b"></span>
            <span class="edge-b"></span>
            <span class="marked edge-r edge-b"><span class="cell-mark"></span></span>
            <span class="edge-r edge-b"></span>
            <span class="edge-b"></span>
            <span class="edge-r edge-b"></span>
            <span class="edge-r edge-b"></span>
            <span class="edge-b"></span>
            <span class="edge-r"></span>
            <span class="edge-r"></span>
            <span></span>
        </div>
    </div>
    <h1 id="start-drop-title" class="drop-title">작업할 파일을 여기에 끌어다 놓으세요</h1>
    <p class="drop-lead">엑셀, 워드, 파워포인트 파일을 여러 개 같이 넣어도 돼요. 원래 파일은 그대로 두고 복사본으로 작업해요.</p>
    <div class="drop-actions">
        <button type="button" class="pick" @onclick="PickFilesAsync">
            <Icon Name="file-plus" Size="17" Stroke="2.2" />
            파일 고르기
        </button>
        <button type="button" class="pick-folder" @onclick="PickFolderAsync">
            <Icon Name="folder" Size="17" Stroke="2.2" />
            폴더째 넣기
        </button>
    </div>
    <p class="drop-formats">열 수 있는 파일: .xlsx, .docx, .pptx, 옛날 형식 .xls, .doc, .ppt<br />한글 파일(.hwp)은 아직 못 열어요</p>
</section>

@code {
    private bool _picking;

    private async Task PickFilesAsync()
    {
        if (_picking)
            return;

        _picking = true;
        try
        {
            var paths = await FileDialog.PickDocumentsAsync();
            if (paths != null && paths.Count > 0)
                await Workspace.ImportAsync(paths);
        }
        finally
        {
            _picking = false;
        }
    }

    private async Task PickFolderAsync()
    {
        if (_picking)
            return;

        _picking = true;
        try
        {
            var folder = await FileDialog.PickFolderAsync();
            if (!string.IsNullOrEmpty(folder))
                await Workspace.ImportAsync(new[] { folder });
        }
        finally
        {
            _picking = false;
        }
    }
}
