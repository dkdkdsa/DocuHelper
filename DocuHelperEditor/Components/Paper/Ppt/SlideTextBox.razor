@using System.Globalization
@using DocuHelperEditor.State.Papers
@inject IJSRuntime JS

@switch (Tag)
{
    case "ul":
        <ul @key="_epoch" @ref="_element" class="@RootClass" style="@Style" contenteditable="@EditableValue" spellcheck="false" @onfocus="HandleFocus" @oninput="HandleInput" @onblur="HandleBlur" @attributes="Attributes">
            @for (var i = 0; i < ShownLines.Count; i++)
            {
                var index = i;
                if (Styled)
                {
                    <li class="ln" style="@LineCss(index)" data-b="@BulletOf(index)">@Content(index)</li>
                }
                else
                {
                    <li style="@LegacyCss(index, true)">
                        @if (ShownLit)
                        {
                            <span class="mk on" data-change="@ShownChangeId" style="@DelayStyle(index)">@ShownLines[index]</span>
                        }
                        else
                        {
                            @ShownLines[index]
                        }
                    </li>
                }
            }
        </ul>
        break;
    case "h2":
        <h2 @key="_epoch" @ref="_element" class="@RootClass" style="@Style" contenteditable="@EditableValue" spellcheck="false" @onfocus="HandleFocus" @oninput="HandleInput" @onblur="HandleBlur" @attributes="Attributes">
            @Body
        </h2>
        break;
    default:
        <p @key="_epoch" @ref="_element" class="@RootClass" style="@Style" contenteditable="@EditableValue" spellcheck="false" @onfocus="HandleFocus" @oninput="HandleInput" @onblur="HandleBlur" @attributes="Attributes">
            @Body
        </p>
        break;
}

@code {
    private static readonly List<string> s_noLines = new();

    private ElementReference _element;
    private int _epoch;
    private bool _dirty;
    private List<string> _frozenLines;
    private List<SlideLineStyle> _frozenStyles;
    private bool _frozenLit;
    private string _frozenChangeId;

    [Parameter]
    public string Tag { get; set; } = "p";

    [Parameter]
    public List<string> Lines { get; set; }

    [Parameter]
    public List<SlideLineStyle> LineStyles { get; set; }

    [Parameter]
    public bool Highlighted { get; set; }

    [Parameter]
    public string ChangeId { get; set; }

    [Parameter]
    public string Class { get; set; }

    [Parameter]
    public string Style { get; set; }

    [Parameter]
    public bool Framed { get; set; }

    [Parameter]
    public bool Editable { get; set; } = true;

    [Parameter]
    public EventCallback OnFocus { get; set; }

    [Parameter]
    public EventCallback<List<string>> OnEdit { get; set; }

    [Parameter]
    public EventCallback<List<string>> OnCommit { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Attributes { get; set; }

    private List<string> ShownLines => _dirty ? _frozenLines : (Lines ?? s_noLines);

    private List<SlideLineStyle> ShownStyles => _dirty ? _frozenStyles : LineStyles;

    private bool Styled => ShownStyles != null && ShownStyles.Count == ShownLines.Count && ShownLines.Count > 0;

    private bool ShownLit => _dirty ? _frozenLit : IsLit;

    private string ShownChangeId => _dirty ? _frozenChangeId : ChangeId;

    private bool IsLit => Highlighted && !string.IsNullOrEmpty(ChangeId);

    private string EditableValue => Editable ? "plaintext-only" : "false";

    private string RootClass
    {
        get
        {
            var css = "text";
            if (!string.IsNullOrEmpty(Class))
                css += " " + Class;

            if (Framed)
                css += " framed";

            if (Styled)
                css += " styled";

            if (_dirty && _frozenLit && !IsLit)
                css += " cleared";

            return css;
        }
    }

    private RenderFragment Body => __builder =>
    {
        for (var i = 0; i < ShownLines.Count; i++)
        {
            var index = i;
            if (Styled)
            {
                <span class="ln" style="@LineCss(index)" data-b="@BulletOf(index)">@Content(index)</span>
            }
            else
            {
                if (index > 0)
                {
                    <br />
                }
                if (ShownLit)
                {
                    <span class="mk on" data-change="@ShownChangeId" style="@DelayStyle(index)">@ShownLines[index]</span>
                }
                else if (LegacyCss(index, false) != null)
                {
                    <span style="@LegacyCss(index, false)">@ShownLines[index]</span>
                }
                else
                {
                    @ShownLines[index]
                }
            }
        }
    };

    private RenderFragment Content(int index) => __builder =>
    {
        if (ShownLit)
        {
            <span class="mk on" data-change="@ShownChangeId" style="@DelayStyle(index)">@Runs(index)</span>
        }
        else
        {
            @Runs(index)
        }
    };

    private RenderFragment Runs(int index) => __builder =>
    {
        var line = ShownLines[index];
        var style = ShownStyles[index];
        if (!SlideTextCss.RunsMatch(style, line))
        {
            @line
            return;
        }

        foreach (var run in style.Runs)
        {
            <span style="@SlideTextCss.Run(run)">@run.Text</span>
        }
    };

    public async Task FocusAsync()
    {
        if (!Editable)
            return;

        try
        {
            await _element.FocusAsync();
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static string DelayStyle(int index) => $"--i: {index}; ";

    private string BulletOf(int index) => SlideTextCss.BulletOf(ShownStyles[index]);

    private string LineCss(int index) => SlideTextCss.Line(ShownStyles[index], index == 0, index == ShownLines.Count - 1);

    private string LegacyCss(int index, bool block)
    {
        var styles = ShownStyles;
        if (styles == null || styles.Count != ShownLines.Count || index >= styles.Count)
            return null;

        var style = styles[index];
        var css = new List<string>();
        if (style.FontCqw > 0)
            css.Add("font-size: " + Num(style.FontCqw) + "cqw");

        css.Add("font-weight: " + (style.Bold ? 700 : 400));
        if (style.Italic)
            css.Add("font-style: italic");

        if (style.Color != null)
            css.Add("color: " + style.Color);

        if (block)
        {
            if (style.IndentCqw > 0)
                css.Add("margin-left: " + Num(style.IndentCqw) + "cqw");

            css.Add("list-style-type: " + (style.Bullet == "number" ? "decimal" : style.Bullet == "bullet" ? "disc" : "none"));
            css.Add("text-align: " + SlideTextCss.Align(style.Align));
        }

        return string.Join("; ", css);
    }

    private static string Num(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private Task HandleFocus() => OnFocus.InvokeAsync();

    private Task HandleInput()
    {
        if (!_dirty)
        {
            _frozenLines = (Lines ?? s_noLines).ToList();
            _frozenStyles = LineStyles;
            _frozenLit = IsLit;
            _frozenChangeId = ChangeId;
            _dirty = true;
        }

        return PushTextAsync();
    }

    private async Task HandleBlur()
    {
        if (!_dirty)
            return;

        var lines = await ReadLinesAsync();
        _dirty = false;
        _frozenLines = null;
        _frozenStyles = null;
        _frozenChangeId = null;
        _epoch++;
        await OnCommit.InvokeAsync(lines);
    }

    private async Task PushTextAsync()
    {
        var lines = await ReadLinesAsync();
        if (lines != null)
            await OnEdit.InvokeAsync(lines);
    }

    private async Task<List<string>> ReadLinesAsync()
    {
        string text;
        try
        {
            text = await JS.InvokeAsync<string>("Reflect.get", _element, "innerText");
        }
        catch (JSException)
        {
            return null;
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
        catch (TaskCanceledException)
        {
            return null;
        }

        return text == null ? null : Parse(text);
    }

    private static List<string> Parse(string text) => text
        .Replace((char)0xA0, ' ')
        .Replace(((char)0x200B).ToString(), string.Empty)
        .Replace("\r", string.Empty)
        .Split('\n')
        .Select(line => line.Trim())
        .Where(line => line.Length > 0)
        .ToList();
}
