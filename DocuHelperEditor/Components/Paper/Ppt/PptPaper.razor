@using System.Globalization
@using DocuHelperEditor.Components.Paper
@using DocuHelperEditor.State.Papers
@inherits StoreComponentBase
@inject IJSRuntime JS

@if (File != null && _model != null)
{
    var slide = _model.ActiveSlide;
    <div class="ppt" @ref="_root">
        <PptRibbon @ref="_ribbonHost" File="File" State="_ribbon" OnChanged="Redraw" />
        <div class="body @(Locked ? "locked" : null)">
            <SlideStrip Slides="_model.Slides" ActiveIndex="_model.ActiveIndex" AspectRatio="_model.AspectRatio" HighlightId="@_highlightId" LiveChanges="_live" Sorter="Sorter" OnToggleSorter="ToggleSorter" OnSelect="SelectSlide" OnSlideAction="SlideAction" />
            <div class="stage">
                @if (Sorter)
                {
                    <SlideSorter Slides="_model.Slides" Sections="_model.Sections" ActiveIndex="_model.ActiveIndex" AspectRatio="_model.AspectRatio" OnPick="PickSlide" />
                }
                else if (Outline)
                {
                    <SlideOutline Slides="_model.Slides" ActiveIndex="_model.ActiveIndex" OnPick="PickSlide" />
                }
                else if (Show)
                {
                    <SlideShowOverlay Slides="ShowSlides()" AspectRatio="_model.AspectRatio" StartIndex="ShowStart()" Reading="@(_ribbon.View == "read")" OnExit="ExitShow" />
                }
                else
                {
                    <div class="frame @(_ribbon.Rulers ? "rulers" : null)" style="--slide-max: @SlideMax">
                        @if (_ribbon.Rulers)
                        {
                            <span class="corner" aria-hidden="true"></span>
                            <RulerBar Horizontal="true" Cm="_model.SlideWidthCm" Marks="SelectedMarks(true)" />
                            <RulerBar Horizontal="false" Cm="_model.SlideHeightCm" Marks="SelectedMarks(false)" />
                        }
                        <div class="slide-wrap @(_previewing ? "play-" + (slide?.Transition ?? "none") : null)">
                            <SlideCanvas Slide="slide" AspectRatio="_model.AspectRatio" Snap="@SnapMode()" WidthCm="_model.SlideWidthCm" HeightCm="_model.SlideHeightCm" SelectedShapeIds="_model.SelectedShapeIds" HighlightId="@_highlightId" LiveChanges="_live" Locked="ReadOnly" OnGesture="Gesture" OnBoxEdited="BoxEdited" OnBoxCommitted="BoxCommitted" />
                            @if (_ribbon.Gridlines)
                            {
                                <div class="grid-layer" style="@GridStyle()" aria-hidden="true"></div>
                            }
                            @if (_ribbon.Guides)
                            {
                                <span class="guide x" aria-hidden="true"></span>
                                <span class="guide y" aria-hidden="true"></span>
                            }
                        </div>
                    </div>
                    @if (slide != null && slide.Animations.Count > 0)
                    {
                        <details class="pane">
                            <summary>애니메이션 @slide.Animations.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)개</summary>
                            <AnimationPane Items="slide.Animations" />
                        </details>
                    }
                    @if (slide != null && slide.Comments.Count > 0)
                    {
                        <details class="pane">
                            <summary>메모 @slide.Comments.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)개</summary>
                            <CommentsPane Items="slide.Comments" />
                        </details>
                    }
                }
            </div>
        </div>
        @if (_ribbon.View == "normal" && _ribbon.NotesOpen)
        {
            <SpeakerNotes Slide="slide" Height="_notesHeight" OnResize="SetNotesHeight" HighlightId="@_highlightId" LiveChanges="_live" Locked="ReadOnly" OnFocus="FocusNotes" OnEdited="NotesEdited" OnCommitted="NotesCommitted" />
        }
        <PptStatusBar Model="_model" State="_ribbon" Commands="_ribbonHost?.Commands" SorterOpen="Sorter" OnToggleSorter="ToggleSorter" OnZoom="SetZoom" />
        <PptDialogHost Presenter="_presenter" />
        <ChangeNavigator File="File" />
    </div>
}

@code {
    private PptRibbonState _ribbon => PptRibbonState.Of(File) ?? new PptRibbonState();
    private ElementReference _root;
    private WheelZoom _wheel;
    private bool Sorter => _ribbon.View == "sorter";

    private bool Outline => _ribbon.View == "outline";

    private string SnapMode() => string.Join(" ", new[] { _ribbon.Gridlines ? "grid" : null, _ribbon.Guides ? "guides" : null }.Where(mode => mode != null));

    private bool Show => _ribbon.View is "show" or "read";

    private List<SlideModel> ShowSlides() => _model.Slides.Where(slide => !slide.IsHidden).ToList();

    private int ShowStart()
    {
        if (_ribbon.ShowFrom == "1")
            return 0;

        var index = ShowSlides().IndexOf(_model.ActiveSlide);
        return index < 0 ? 0 : index;
    }

    private void ExitShow(int index)
    {
        _ribbon.View = "normal";
        var visible = ShowSlides();
        var target = index >= 0 && index < visible.Count ? _model.Slides.IndexOf(visible[index]) : -1;
        SelectSlide(target < 0 ? _model.ActiveIndex : target);
    }

    private void ToggleSorter() => SetSorter(!Sorter);

    private PptRibbon _ribbonHost;
    private readonly PptDialogPresenter _presenter = new();
    private int _notesHeight = 92;
    private bool _previewing;
    private System.Threading.CancellationTokenSource _previewCts;
    private const int TransitionPreviewMs = 900;

    private WorkspaceFile _file;
    private PptPaperModel _model;
    private PptPaperModel _fallback;
    private HashSet<string> _live = new();
    private string _highlightId;
    private string _seenChangeId;
    private int _seenPickVersion;
    private string _scrollChangeId;
    private string _reported;
    private bool _notesFocused;
    private string _draftSlideId;
    private string _draftBoxId;
    private List<string> _draftLines;

    [Parameter]
    public WorkspaceFile File { get; set; }

    private bool Locked => File != null && File.Activity == FileActivity.Editing;

    private bool ReadOnly => Locked || File?.Docu == null;

    private bool IsActive => File != null && Workspace.ActiveFile != null && Workspace.ActiveFile.Id == File.Id;

    protected override void OnInitialized()
    {
        _ribbon.ModelSource = () => File?.Paper as PptPaperModel ?? _model;
        _ribbon.CommitDraft = CommitDraft;
        _ribbon.ActivateSlide = ActivateSlide;
        _ribbon.Dialogs = _presenter;
    }

    protected override void OnParametersSet() => Sync();

    protected override bool ShouldRender()
    {
        Sync();
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_root.Id != null)
        {
            _wheel ??= new WheelZoom(JS, ZoomStepAsync);
            await _wheel.AttachAsync(_root);
        }

        if (firstRender && _ribbonHost != null)
            StateHasChanged();

        if (_model == null)
            return;

        if (IsActive)
        {
            var label = CurrentLabel();
            if (label != _reported || Workspace.SelectionLabel == null)
            {
                _reported = label;
                if (Workspace.SelectionLabel != label)
                    Workspace.SetSelection(label);
            }
        }

        if (_scrollChangeId != null)
        {
            var selector = $"[data-change=\"{_scrollChangeId}\"]";
            _scrollChangeId = null;
            await JS.InvokeVoidAsync("docuHelper.scrollIntoView", selector);
        }
    }

    protected override void OnDispose()
    {
        _previewCts?.Cancel();
        _ = _wheel?.Detach();
        CommitDraft();
    }

    private void Sync()
    {
        if (File == null)
        {
            _model = null;
            return;
        }

        if (!ReferenceEquals(File, _file))
        {
            CommitDraft();
            _file = File;
            _fallback = null;
            _seenChangeId = null;
            _reported = null;
            _notesFocused = false;
        }

        _model = ResolveModel();
        _live = new HashSet<string>((File.Changes ?? new List<ChangeItem>())
            .Where(c => c != null && !string.IsNullOrEmpty(c.Id))
            .Select(c => c.Id));

        var selected = Workspace.SelectedChangeId;
        _highlightId = !string.IsNullOrEmpty(selected) && _live.Contains(selected) ? selected : null;
        if (selected == _seenChangeId && Workspace.ChangePickVersion == _seenPickVersion)
            return;

        _seenChangeId = selected;
        _seenPickVersion = Workspace.ChangePickVersion;
        if (_highlightId == null)
            return;

        var index = _model.IndexOfChange(_highlightId);
        if (index >= 0 && index != _model.ActiveIndex)
        {
            _model.ActiveIndex = index;
            _model.SelectShape(null, false);
            _notesFocused = false;
        }

        _scrollChangeId = _highlightId;
    }

    private PptPaperModel ResolveModel()
    {
        var model = File.Paper as PptPaperModel;
        if (model == null && File.Paper == null)
        {
            model = PptPaperModel.CreateEmpty();
            File.Paper = model;
        }

        if (model == null)
        {
            _fallback ??= PptPaperModel.CreateEmpty();
            model = _fallback;
        }

        model.EnsureSlide();
        return model;
    }

    private string CurrentLabel()
    {
        var number = _model.ActiveIndex + 1;
        if (_model.SelectedBox != null)
            return $"{number}번 슬라이드 글상자";

        return _notesFocused && _ribbon.NotesOpen ? $"{number}번 슬라이드 노트" : $"{number}번 슬라이드";
    }

    private void Report()
    {
        if (IsActive)
        {
            _reported = CurrentLabel();
            Workspace.SetSelection(_reported);
        }
        else
        {
            Workspace.Notify();
        }
    }

    private IEnumerable<(double From, double To)> SelectedMarks(bool horizontal)
    {
        var id = _model?.SelectedShapeIds?.FirstOrDefault();
        var shape = _model?.ActiveSlide?.FindShape(id);
        if (shape == null)
            yield break;

        var extent = horizontal ? _model.SlideWidthCm : _model.SlideHeightCm;
        var start = horizontal ? shape.Left : shape.Top;
        var size = horizontal ? shape.Width : shape.Height;
        yield return (start / 100 * extent, (start + size) / 100 * extent);
    }

    private string GridStyle()
    {
        var width = 100 / Math.Max(_model.SlideWidthCm, 1);
        var height = 100 / Math.Max(_model.SlideHeightCm, 1);
        return string.Format(CultureInfo.InvariantCulture, "background-size: {0:0.###}% 100%, 100% {1:0.###}%", width, height);
    }

    private void SetNotesHeight(int height) => _notesHeight = Math.Clamp(height, SpeakerNotes.MinHeight, SpeakerNotes.MaxHeight);

    private void ToggleNotes() => _ribbon.NotesOpen = !_ribbon.NotesOpen;

    private void SetSorter(bool on)
    {
        CommitDraft();
        _ribbon.View = on ? "sorter" : "normal";
    }

    private Task ZoomStepAsync(int direction)
    {
        SetZoom(_ribbon.Zoom + direction * 10);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void SetZoom(int value)
    {
        _ribbon.Zoom = Math.Clamp(value, PptRibbonState.MinZoom, PptRibbonState.MaxZoom);
        _ribbon.FitRequested = false;
    }

    private string SlideMax => _ribbon.FitRequested ? "100%" : (560 * _ribbon.Zoom / 100).ToString(CultureInfo.InvariantCulture) + "px";

    private void PickSlide(int index)
    {
        _ribbon.View = "normal";
        SelectSlide(index);
    }

    private void SlideAction((string Action, int Index) request)
    {
        CommitDraft();
        if (File?.Docu == null || _model == null || request.Index < 0 || request.Index >= _model.Slides.Count)
            return;

        var number = request.Index + 1;
        var count = _model.Slides.Count;
        var target = request.Index;
        var changed = request.Action switch
        {
            "new" => Edit(File, "add_slide", new { after = number }),
            "duplicate" => Edit(File, "arrange_slides", new { action = "duplicate", slides = new[] { number } }),
            "up" => Edit(File, "arrange_slides", new { action = "move", slides = new[] { number }, to = number - 2 }),
            "down" => Edit(File, "arrange_slides", new { action = "move", slides = new[] { number }, to = number + 1 }),
            "delete" => Edit(File, "arrange_slides", new { action = "delete", slides = new[] { number } }),
            _ => false,
        };
        if (!changed)
            return;

        target = request.Action switch
        {
            "new" => request.Index + 1,
            "duplicate" => request.Index + 1,
            "up" => request.Index - 1,
            "down" => request.Index + 1,
            "delete" => Math.Min(request.Index, count - 2),
            _ => target,
        };
        SelectSlide(Math.Clamp(target, 0, Math.Max(0, _model.Slides.Count - 1)));
    }

    private void SelectSlide(int index)
    {
        CommitDraft();
        if (_model == null || index < 0 || index >= _model.Slides.Count)
            return;

        _model.ActiveIndex = index;
        _model.SelectShape(null, false);
        _notesFocused = false;
        Report();
    }

    private void Gesture(SlideGesture gesture)
    {
        if (_model == null || gesture == null)
            return;

        if (gesture.SlideId != null && gesture.SlideId != _model.ActiveSlide?.Id)
            return;

        if (gesture.Kind == "select")
        {
            SelectShape(gesture.Id, gesture.Additive);
            return;
        }

        if (gesture.Kind == "key" && gesture.Key == "Escape")
        {
            SelectShape(null, false);
            return;
        }

        if (ReadOnly || _model.ActiveSlide == null || !IsRealSlide(_model.ActiveSlide))
            return;

        CommitDraft();
        foreach (var edit in PptCanvasEdits.Plan(gesture, _model, _model.ActiveIndex + 1))
            Edit(File, edit.Tool, edit.Arguments);
    }

    private void SelectShape(string shapeId, bool additive)
    {
        CommitDraft();
        if (_model == null)
            return;

        _model.SelectShape(shapeId, additive);
        _ribbonHost?.Commands?.SelectionChanged();
        _notesFocused = false;
        Report();
    }

    private void FocusNotes()
    {
        if (_draftLines != null && _draftBoxId != null)
            CommitDraft();

        if (_model == null || (_model.SelectedBoxId == null && _notesFocused))
            return;

        _model.SelectShape(null, false);
        _notesFocused = true;
        Report();
    }

    private void BoxEdited(SlideBoxModel box)
    {
        if (_model == null || box == null || ReadOnly)
            return;

        if (_draftLines != null && _draftBoxId != box.Id)
            CommitDraft();

        var slide = SlideOfBox(box.Id);
        var current = slide?.FindBox(box.Id);
        if (current == null)
            return;

        _draftSlideId = slide.Id;
        _draftBoxId = box.Id;
        _draftLines = (box.Lines ?? new List<string>()).ToList();
        current.Lines = _draftLines.ToList();
        current.MarkCleared = true;
        slide.FitChecked = false;
    }

    private void BoxCommitted(SlideBoxModel box)
    {
        BoxEdited(box);
        CommitDraft();
    }

    private void NotesEdited(SlideModel slide)
    {
        if (_model == null || slide == null || ReadOnly)
            return;

        if (_draftLines != null && (_draftBoxId != null || _draftSlideId != slide.Id))
            CommitDraft();

        var current = _model.Slides.FirstOrDefault(s => s.Id == slide.Id);
        if (current == null)
            return;

        _draftSlideId = slide.Id;
        _draftBoxId = null;
        _draftLines = (slide.Notes ?? new List<string>()).ToList();
        current.Notes = _draftLines.ToList();
        current.NotesMarkCleared = true;
    }

    private void NotesCommitted(SlideModel slide)
    {
        NotesEdited(slide);
        CommitDraft();
    }

    private void CommitDraft()
    {
        if (_draftLines == null)
            return;

        var slideId = _draftSlideId;
        var boxId = _draftBoxId;
        var lines = _draftLines;
        _draftSlideId = null;
        _draftBoxId = null;
        _draftLines = null;

        var file = _file ?? File;
        var model = file?.Paper as PptPaperModel;
        var index = model?.Slides.FindIndex(s => s.Id == slideId) ?? -1;
        if (file?.Docu == null || index < 0)
            return;

        var slide = model.Slides[index];
        if (boxId == null)
        {
            if (IsRealSlide(slide))
                Edit(file, "set_notes", new { slide = index + 1, text = string.Join("\n", lines) });

            return;
        }

        var box = slide.FindBox(boxId);
        if (box == null)
            return;

        if (!IsRealSlide(slide))
        {
            if (box.Kind == SlideBoxKind.Title)
                Edit(file, "add_slide", new { after = 0, title = string.Join(" ", lines) });
            else
                Edit(file, "add_slide", new { after = 0, lines });

            return;
        }

        if (!string.IsNullOrEmpty(box.ShapeKey))
            Edit(file, "set_slide_text", new { slide = index + 1, shape = box.ShapeKey, lines });
    }

    private void Redraw()
    {
        if (string.Equals(_ribbon.Preview, "transition", StringComparison.Ordinal))
        {
            _ribbon.Preview = null;
            if (!_previewing)
            {
                _previewing = true;
                _ = EndPreviewAsync();
            }
        }

        StateHasChanged();
    }

    private async Task EndPreviewAsync()
    {
        var cts = _previewCts = new System.Threading.CancellationTokenSource();
        try
        {
            await Task.Delay(TransitionPreviewMs, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
            return;

        await InvokeAsync(() =>
        {
            _previewing = false;
            StateHasChanged();
        });
    }

    private void ActivateSlide(int index)
    {
        _model = ResolveModel();
        if (_model == null || _model.Slides.Count == 0)
            return;

        _model.ActiveIndex = Math.Clamp(index, 0, _model.Slides.Count - 1);
        _model.SelectShape(null, false);
        _notesFocused = false;
        Report();
    }

    private bool Edit(WorkspaceFile file, string tool, object arguments)
    {
        if (file == null)
            return false;

        var result = Workspace.ApplyEdit(file, EditCommand.Create(tool, arguments));
        if (ReferenceEquals(file, File))
            _model = ResolveModel();

        return !result.IsError;
    }

    private SlideModel SlideOfBox(string boxId) => _model?.Slides.FirstOrDefault(s => s.FindBox(boxId) != null);

    private static bool IsRealSlide(SlideModel slide) => slide?.Id != null && slide.Id.StartsWith("s:", StringComparison.Ordinal);
}
