@using DocuHelperEditor.Components.Paper
@using DocuHelperEditor.State.Papers
@inherits StoreComponentBase
@inject IJSRuntime JS

@if (File != null && _model != null)
{
    var slide = _model.ActiveSlide;
    <div class="ppt">
        <SlideToolbar Box="_model.SelectedBox" Locked="ReadOnly" OnSmaller="() => ChangeFontSize(-1)" OnBigger="() => ChangeFontSize(1)" OnBold="ToggleBold" OnItalic="ToggleItalic" OnUnderline="ToggleUnderline" OnAlign="SetAlign" OnNewSlide="AddSlide" />
        <div class="body @(Locked ? "locked" : null)">
            <SlideStrip Slides="_model.Slides" ActiveIndex="_model.ActiveIndex" HighlightId="@_highlightId" LiveChanges="_live" OnSelect="SelectSlide" />
            <div class="stage">
                <SlideCanvas Slide="slide" Number="_model.ActiveIndex + 1" Footer="@_model.Footer" SelectedBoxId="@_model.SelectedBoxId" HighlightId="@_highlightId" LiveChanges="_live" Locked="ReadOnly" OnSelectBox="SelectBox" OnClearSelection="ClearSelection" OnBoxEdited="BoxEdited" OnBoxCommitted="BoxCommitted" />
                <SpeakerNotes Slide="slide" HighlightId="@_highlightId" LiveChanges="_live" Locked="ReadOnly" OnFocus="FocusNotes" OnEdited="NotesEdited" OnCommitted="NotesCommitted" />
            </div>
        </div>
        <ChangeNavigator File="File" />
    </div>
}

@code {
    private static readonly double[] s_fontSizes = { 8, 9, 10, 10.5, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 40, 44, 48, 54, 60, 66, 72, 80, 88, 96 };

    private WorkspaceFile _file;
    private PptPaperModel _model;
    private PptPaperModel _fallback;
    private HashSet<string> _live = new();
    private string _highlightId;
    private string _seenChangeId;
    private int _seenPickVersion;
    private string _scrollChangeId;
    private string _reported;
    private bool _notesFocused;
    private string _draftSlideId;
    private string _draftBoxId;
    private List<string> _draftLines;

    [Parameter]
    public WorkspaceFile File { get; set; }

    private bool Locked => File != null && File.Activity == FileActivity.Editing;

    private bool ReadOnly => Locked || File?.Docu == null;

    private bool IsActive => File != null && Workspace.ActiveFile != null && Workspace.ActiveFile.Id == File.Id;

    protected override void OnParametersSet() => Sync();

    protected override bool ShouldRender()
    {
        Sync();
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_model == null)
            return;

        if (IsActive)
        {
            var label = CurrentLabel();
            if (label != _reported || Workspace.SelectionLabel == null)
            {
                _reported = label;
                if (Workspace.SelectionLabel != label)
                    Workspace.SetSelection(label);
            }
        }

        if (_scrollChangeId != null)
        {
            var selector = $"[data-change=\"{_scrollChangeId}\"]";
            _scrollChangeId = null;
            await JS.InvokeVoidAsync("docuHelper.scrollIntoView", selector);
        }
    }

    protected override void OnDispose() => CommitDraft();

    private void Sync()
    {
        if (File == null)
        {
            _model = null;
            return;
        }

        if (!ReferenceEquals(File, _file))
        {
            CommitDraft();
            _file = File;
            _fallback = null;
            _seenChangeId = null;
            _reported = null;
            _notesFocused = false;
        }

        _model = ResolveModel();
        _live = new HashSet<string>((File.Changes ?? new List<ChangeItem>())
            .Where(c => c != null && !string.IsNullOrEmpty(c.Id))
            .Select(c => c.Id));

        var selected = Workspace.SelectedChangeId;
        _highlightId = !string.IsNullOrEmpty(selected) && _live.Contains(selected) ? selected : null;
        if (selected == _seenChangeId && Workspace.ChangePickVersion == _seenPickVersion)
            return;

        _seenChangeId = selected;
        _seenPickVersion = Workspace.ChangePickVersion;
        if (_highlightId == null)
            return;

        var index = _model.IndexOfChange(_highlightId);
        if (index >= 0 && index != _model.ActiveIndex)
        {
            _model.ActiveIndex = index;
            _model.SelectedBoxId = null;
            _notesFocused = false;
        }

        _scrollChangeId = _highlightId;
    }

    private PptPaperModel ResolveModel()
    {
        var model = File.Paper as PptPaperModel;
        if (model == null && File.Paper == null)
        {
            model = PptPaperModel.CreateEmpty();
            File.Paper = model;
        }

        if (model == null)
        {
            _fallback ??= PptPaperModel.CreateEmpty();
            model = _fallback;
        }

        model.EnsureSlide();
        return model;
    }

    private string CurrentLabel()
    {
        var number = _model.ActiveIndex + 1;
        if (_model.SelectedBox != null)
            return $"{number}번 슬라이드 글상자";

        return _notesFocused ? $"{number}번 슬라이드 발표 메모" : $"{number}번 슬라이드";
    }

    private void Report()
    {
        if (IsActive)
        {
            _reported = CurrentLabel();
            Workspace.SetSelection(_reported);
        }
        else
        {
            Workspace.Notify();
        }
    }

    private void SelectSlide(int index)
    {
        CommitDraft();
        if (_model == null || index < 0 || index >= _model.Slides.Count)
            return;

        _model.ActiveIndex = index;
        _model.SelectedBoxId = null;
        _notesFocused = false;
        Report();
    }

    private void SelectBox(SlideBoxModel box)
    {
        if (box != null && _draftLines != null && _draftBoxId != box.Id)
            CommitDraft();

        var slide = _model?.ActiveSlide;
        if (slide == null || box == null || slide.FindBox(box.Id) == null)
            return;

        if (_model.SelectedBoxId == box.Id && !_notesFocused)
            return;

        _model.SelectedBoxId = box.Id;
        _notesFocused = false;
        Report();
    }

    private void ClearSelection()
    {
        CommitDraft();
        if (_model == null || (_model.SelectedBoxId == null && !_notesFocused))
            return;

        _model.SelectedBoxId = null;
        _notesFocused = false;
        Report();
    }

    private void FocusNotes()
    {
        if (_draftLines != null && _draftBoxId != null)
            CommitDraft();

        if (_model == null || (_model.SelectedBoxId == null && _notesFocused))
            return;

        _model.SelectedBoxId = null;
        _notesFocused = true;
        Report();
    }

    private void BoxEdited(SlideBoxModel box)
    {
        if (_model == null || box == null || ReadOnly)
            return;

        if (_draftLines != null && _draftBoxId != box.Id)
            CommitDraft();

        var slide = SlideOfBox(box.Id);
        var current = slide?.FindBox(box.Id);
        if (current == null)
            return;

        _draftSlideId = slide.Id;
        _draftBoxId = box.Id;
        _draftLines = (box.Lines ?? new List<string>()).ToList();
        current.Lines = _draftLines.ToList();
        current.MarkCleared = true;
        slide.FitChecked = false;
    }

    private void BoxCommitted(SlideBoxModel box)
    {
        BoxEdited(box);
        CommitDraft();
    }

    private void NotesEdited(SlideModel slide)
    {
        if (_model == null || slide == null || ReadOnly)
            return;

        if (_draftLines != null && (_draftBoxId != null || _draftSlideId != slide.Id))
            CommitDraft();

        var current = _model.Slides.FirstOrDefault(s => s.Id == slide.Id);
        if (current == null)
            return;

        _draftSlideId = slide.Id;
        _draftBoxId = null;
        _draftLines = (slide.Notes ?? new List<string>()).ToList();
        current.Notes = _draftLines.ToList();
        current.NotesMarkCleared = true;
    }

    private void NotesCommitted(SlideModel slide)
    {
        NotesEdited(slide);
        CommitDraft();
    }

    private void CommitDraft()
    {
        if (_draftLines == null)
            return;

        var slideId = _draftSlideId;
        var boxId = _draftBoxId;
        var lines = _draftLines;
        _draftSlideId = null;
        _draftBoxId = null;
        _draftLines = null;

        var file = _file ?? File;
        var model = file?.Paper as PptPaperModel;
        var index = model?.Slides.FindIndex(s => s.Id == slideId) ?? -1;
        if (file?.Docu == null || index < 0)
            return;

        var slide = model.Slides[index];
        if (boxId == null)
        {
            if (IsRealSlide(slide))
                Edit(file, "set_notes", new { slide = index + 1, text = string.Join("\n", lines) });

            return;
        }

        var box = slide.FindBox(boxId);
        if (box == null)
            return;

        if (!IsRealSlide(slide))
        {
            if (box.Kind == SlideBoxKind.Title)
                Edit(file, "add_slide", new { after = 0, title = string.Join(" ", lines) });
            else
                Edit(file, "add_slide", new { after = 0, lines });

            return;
        }

        if (!string.IsNullOrEmpty(box.ShapeKey))
            Edit(file, "set_slide_text", new { slide = index + 1, shape = box.ShapeKey, lines });
    }

    private void ChangeFontSize(int direction)
    {
        var target = EditableTarget();
        if (target == null)
            return;

        var (number, box) = target.Value;
        var current = box.PointSize > 0 ? box.PointSize : 18;
        var next = direction > 0
            ? s_fontSizes.FirstOrDefault(s => s > current + 0.01)
            : s_fontSizes.LastOrDefault(s => s < current - 0.01);

        if (next > 0)
            Edit("set_font", new { slide = number, shape = box.ShapeKey, size = next });
    }

    private void ToggleBold()
    {
        var target = EditableTarget();
        if (target != null)
            Edit("set_font", new { slide = target.Value.Number, shape = target.Value.Box.ShapeKey, bold = !target.Value.Box.Bold });
    }

    private void ToggleItalic()
    {
        var target = EditableTarget();
        if (target != null)
            Edit("set_font", new { slide = target.Value.Number, shape = target.Value.Box.ShapeKey, italic = !target.Value.Box.Italic });
    }

    private void ToggleUnderline()
    {
        var target = EditableTarget();
        if (target != null)
            Edit("set_font", new { slide = target.Value.Number, shape = target.Value.Box.ShapeKey, underline = !target.Value.Box.Underline });
    }

    private void SetAlign(SlideTextAlign align)
    {
        var target = EditableTarget();
        if (target == null)
            return;

        var box = target.Value.Box;
        var next = box.Align == align ? SlideTextAlign.Left : align;
        if (next != box.Align)
            Edit("set_font", new { slide = target.Value.Number, shape = box.ShapeKey, align = next == SlideTextAlign.Center ? "center" : "left" });
    }

    private void AddSlide()
    {
        if (_model == null || ReadOnly)
            return;

        CommitDraft();
        if (_model == null)
            return;

        var after = Math.Clamp(_model.ActiveIndex + 1, 0, _model.Slides.Count(IsRealSlide));
        if (!Edit("add_slide", new { after, layout = "title_content" }) || _model == null)
            return;

        _model.ActiveIndex = Math.Clamp(after, 0, _model.Slides.Count - 1);
        _model.SelectedBoxId = null;
        _notesFocused = false;
        Report();
    }

    private (int Number, SlideBoxModel Box)? EditableTarget()
    {
        if (_model == null || ReadOnly || string.IsNullOrEmpty(_model.SelectedBoxId))
            return null;

        CommitDraft();
        var slide = _model?.ActiveSlide;
        var box = slide?.FindBox(_model.SelectedBoxId);
        if (box == null || !IsRealSlide(slide) || string.IsNullOrEmpty(box.ShapeKey))
            return null;

        return (_model.Slides.IndexOf(slide) + 1, box);
    }

    private bool Edit(string tool, object arguments) => Edit(File, tool, arguments);

    private bool Edit(WorkspaceFile file, string tool, object arguments)
    {
        if (file == null)
            return false;

        var result = Workspace.ApplyEdit(file, EditCommand.Create(tool, arguments));
        if (ReferenceEquals(file, File))
            _model = ResolveModel();

        return !result.IsError;
    }

    private SlideModel SlideOfBox(string boxId) => _model?.Slides.FirstOrDefault(s => s.FindBox(boxId) != null);

    private static bool IsRealSlide(SlideModel slide) => slide?.Id != null && slide.Id.StartsWith("s:", StringComparison.Ordinal);
}
