@using DocuHelperEditor.Components.Paper.Word.Dialogs
@using DocuHelperEditor.State.Ribbon
@implements IDisposable

@if (_request != null)
{
    <WordFormDialog Request="_request" Closed="CloseAsync" />
}

@code {
    private PptDialogPresenter _presenter;
    private WordDialogRequest _request;

    [Parameter]
    public PptDialogPresenter Presenter { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Presenter, _presenter))
            return;

        Detach();
        _presenter = Presenter;
        if (_presenter != null)
            _presenter.Requested += Show;
    }

    public void Dispose() => Detach();

    private void Detach()
    {
        if (_presenter != null)
            _presenter.Requested -= Show;

        _presenter = null;
    }

    private void Show(WordDialogRequest request)
    {
        _request = request;
        InvokeAsync(StateHasChanged);
    }

    private Task CloseAsync()
    {
        _request = null;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
