@using System.Globalization

<footer class="sb" aria-label="상태 표시줄">
    <span class="count" aria-live="polite">슬라이드 @((Active + 1).ToString(CultureInfo.InvariantCulture))/@Count.ToString(CultureInfo.InvariantCulture)</span>
    <button type="button" class="sb-btn @(NotesOpen ? "on" : null)" aria-pressed="@(NotesOpen ? "true" : "false")" @onclick="OnToggleNotes">노트</button>
    <span class="divider" aria-hidden="true"></span>
    <button type="button" class="sb-btn @(!Sorter ? "on" : null)" aria-pressed="@(!Sorter ? "true" : "false")" @onclick="() => OnSetSorter.InvokeAsync(false)">기본</button>
    <button type="button" class="sb-btn @(Sorter ? "on" : null)" aria-pressed="@(Sorter ? "true" : "false")" @onclick="() => OnSetSorter.InvokeAsync(true)">여러 슬라이드</button>
    <span class="spacer"></span>
    <button type="button" class="sb-btn icon" aria-label="축소" @onclick="() => OnZoom.InvokeAsync(Zoom - Step)">−</button>
    <input type="range" class="zoom" min="50" max="200" step="10" value="@Zoom.ToString(CultureInfo.InvariantCulture)" aria-label="확대 비율" @onchange="OnZoomSlider" />
    <button type="button" class="sb-btn icon" aria-label="확대" @onclick="() => OnZoom.InvokeAsync(Zoom + Step)">+</button>
    <button type="button" class="sb-btn percent" aria-label="배율 100%로 되돌리기" @onclick="() => OnZoom.InvokeAsync(100)">@Zoom.ToString(CultureInfo.InvariantCulture)%</button>
</footer>

@code {
    private const int Step = 10;

    [Parameter]
    public int Active { get; set; }

    [Parameter]
    public int Count { get; set; }

    [Parameter]
    public bool NotesOpen { get; set; }

    [Parameter]
    public bool Sorter { get; set; }

    [Parameter]
    public int Zoom { get; set; } = 100;

    [Parameter]
    public EventCallback OnToggleNotes { get; set; }

    [Parameter]
    public EventCallback<bool> OnSetSorter { get; set; }

    [Parameter]
    public EventCallback<int> OnZoom { get; set; }

    private Task OnZoomSlider(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value)
            ? OnZoom.InvokeAsync(value)
            : Task.CompletedTask;
}
