@using DocuHelperEditor.State.Papers

@if (Slide != null)
{
    var slide = Slide;
    <div class="notes" data-change="@LiveChange" @onclick="FocusText">
        @if (LiveChange != null)
        {
            <span class="change-bar" aria-hidden="true"></span>
        }
        <span class="label" id="@_labelId">발표 메모</span>
        <SlideTextBox @ref="_text" @key="slide.Id" Tag="p" Class="note" data-placeholder="발표할 때 볼 메모를 적어 주세요" Lines="slide.Notes" Highlighted="IsLit" ChangeId="@ShownChangeId" Editable="!Locked" OnFocus="OnFocus" OnEdit="lines => EditNotes(slide, lines)" OnCommit="lines => CommitNotes(slide, lines)" role="textbox" aria-multiline="true" aria-readonly="@(Locked ? "true" : null)" aria-labelledby="@_labelId" />
    </div>
}

@code {
    private readonly string _labelId = "slide-notes-" + Guid.NewGuid().ToString("N");
    private SlideTextBox _text;

    [Parameter]
    public SlideModel Slide { get; set; }

    [Parameter]
    public string HighlightId { get; set; }

    [Parameter]
    public HashSet<string> LiveChanges { get; set; }

    [Parameter]
    public bool Locked { get; set; }

    [Parameter]
    public EventCallback OnFocus { get; set; }

    [Parameter]
    public EventCallback<SlideModel> OnEdited { get; set; }

    [Parameter]
    public EventCallback<SlideModel> OnCommitted { get; set; }

    private string LiveChange
    {
        get
        {
            if (Slide == null || LiveChanges == null)
                return null;

            if (Slide.HasNotesChange(HighlightId) && LiveChanges.Contains(HighlightId))
                return HighlightId;

            var ids = (Slide.NotesChangeIds ?? new List<string>()).Append(Slide.NotesChangeId);
            return ids.LastOrDefault(id => !string.IsNullOrEmpty(id) && LiveChanges.Contains(id));
        }
    }

    private bool IsLit => Slide != null && Slide.HasNotesChange(HighlightId) && !Slide.NotesMarkCleared;

    private string ShownChangeId => IsLit ? HighlightId : Slide?.NotesChangeId;

    private Task FocusText() => _text == null || Locked ? Task.CompletedTask : _text.FocusAsync();

    private Task EditNotes(SlideModel slide, List<string> lines)
    {
        slide.Notes = lines;
        return OnEdited.InvokeAsync(slide);
    }

    private Task CommitNotes(SlideModel slide, List<string> lines)
    {
        if (lines != null)
            slide.Notes = lines;

        return OnCommitted.InvokeAsync(slide);
    }
}
