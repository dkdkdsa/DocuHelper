@using DocuHelperEditor.State.Papers
@inject IJSRuntime JS

<nav class="strip" aria-label="슬라이드">
    <ol class="list">
        @for (var i = 0; i < Count; i++)
        {
            var index = i;
            var slide = Slides[index];
            var active = index == ActiveIndex;
            var changed = IsChanged(slide);
            <li @key="slide.Id" class="item">
                @if (changed)
                {
                    <span class="bar" aria-hidden="true"></span>
                }
                <button type="button" id="@ThumbId(index)" class="th @(active ? "on" : null)" aria-label="@ThumbLabel(index, changed)" aria-pressed="@(active ? "true" : "false")" tabindex="@(active ? 0 : -1)" @onclick="() => SelectSlide(index)" @onkeydown="e => HandleKey(e, index)">
                    <span class="num" aria-hidden="true">@(index + 1)</span>
                    <span class="mini" aria-hidden="true">
                        <SlideCanvas Slide="slide" AspectRatio="AspectRatio" Locked="true" ShowFit="false" HighlightId="@HighlightId" LiveChanges="LiveChanges" />
                    </span>
                </button>
            </li>
        }
    </ol>
</nav>

@code {
    private readonly string _uid = "slide-thumb-" + Guid.NewGuid().ToString("N").Substring(0, 8);
    private int _focusIndex = -1;
    private int _shownIndex = -1;

    [Parameter]
    public List<SlideModel> Slides { get; set; }

    [Parameter]
    public int ActiveIndex { get; set; }

    [Parameter]
    public double AspectRatio { get; set; } = 16.0 / 9.0;

    [Parameter]
    public string HighlightId { get; set; }

    [Parameter]
    public HashSet<string> LiveChanges { get; set; }

    [Parameter]
    public EventCallback<int> OnSelect { get; set; }


    private int Count => Slides?.Count ?? 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var focus = _focusIndex;
        _focusIndex = -1;
        var moved = firstRender ? ActiveIndex > 0 : ActiveIndex != _shownIndex;
        _shownIndex = ActiveIndex;

        if (focus >= 0 && focus < Count)
            await JS.InvokeVoidAsync("docuHelper.focus", "#" + ThumbId(focus));
        else if (moved && ActiveIndex >= 0 && ActiveIndex < Count)
            await JS.InvokeVoidAsync("docuHelper.scrollIntoView", "#" + ThumbId(ActiveIndex));
    }

    private string ThumbId(int index) => $"{_uid}-{index}";

    private static string ThumbLabel(int index, bool changed) =>
        changed ? $"{index + 1}번 슬라이드, 도우미가 고침" : $"{index + 1}번 슬라이드";

    private bool IsChanged(SlideModel slide) => LiveChanges != null && slide.ChangeIds().Any(id => LiveChanges.Contains(id));

    private Task SelectSlide(int index) => OnSelect.InvokeAsync(index);

    private Task HandleKey(KeyboardEventArgs e, int index)
    {
        var target = e.Key switch
        {
            "ArrowUp" => index - 1,
            "ArrowDown" => index + 1,
            "Home" => 0,
            "End" => Count - 1,
            _ => -1,
        };

        if (target < 0 || target >= Count || target == index)
            return Task.CompletedTask;

        _focusIndex = target;
        return OnSelect.InvokeAsync(target);
    }
}
