@using DocuHelperEditor.Components.Ribbon
@using DocuHelperEditor.State.Papers
@using DocuHelperEditor.State.Ribbon
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

<nav class="strip" aria-label="슬라이드">
    <button type="button" class="sorter-toggle @(Sorter ? "on" : null)" aria-pressed="@(Sorter ? "true" : "false")" @onclick="OnToggleSorter">정렬 보기</button>
    <ol class="list">
        @for (var i = 0; i < Count; i++)
        {
            var index = i;
            var slide = Slides[index];
            var active = index == ActiveIndex;
            var changed = IsChanged(slide);
            <li @key="slide.Id" class="item">
                @if (changed)
                {
                    <span class="bar" aria-hidden="true"></span>
                }
                <button type="button" id="@ThumbId(index)" class="th @(active ? "on" : null)" aria-label="@ThumbLabel(index, changed)" aria-pressed="@(active ? "true" : "false")" tabindex="@(active ? 0 : -1)" @onclick="() => SelectSlide(index)" @onkeydown="e => HandleKey(e, index)" style="@(_menuIndex == index ? "anchor-name: --ribbon-anchor" : null)" @oncontextmenu="e => OpenMenu(e, index)" @oncontextmenu:preventDefault="true">
                    <span class="num" aria-hidden="true">@(index + 1)</span>
                    <span class="mini" aria-hidden="true">
                        <SlideCanvas Slide="slide" AspectRatio="AspectRatio" Locked="true" ShowFit="false" HighlightId="@HighlightId" LiveChanges="LiveChanges" />
                    </span>
                </button>
            </li>
        }
    </ol>
    @if (_menuIndex >= 0 && _menuIndex < Count)
    {
        <RibbonMenu Items="MenuItems(_menuIndex)" Label="@($"{_menuIndex + 1}번 슬라이드 메뉴")" OnPick="PickMenuAsync" OnClose="CloseMenu" />
    }
</nav>

@code {
    private readonly string _uid = "slide-thumb-" + Guid.NewGuid().ToString("N").Substring(0, 8);
    private int _focusIndex = -1;
    private int _shownIndex = -1;

    [Parameter]
    public List<SlideModel> Slides { get; set; }

    [Parameter]
    public int ActiveIndex { get; set; }

    [Parameter]
    public double AspectRatio { get; set; } = 16.0 / 9.0;

    [Parameter]
    public string HighlightId { get; set; }

    [Parameter]
    public HashSet<string> LiveChanges { get; set; }

    [Parameter]
    public EventCallback<int> OnSelect { get; set; }

    [Parameter]
    public bool Sorter { get; set; }

    [Parameter]
    public EventCallback OnToggleSorter { get; set; }

    private int Count => Slides?.Count ?? 0;

    private int _menuIndex = -1;

    [Parameter]
    public EventCallback<(string Action, int Index)> OnSlideAction { get; set; }

    private IReadOnlyList<RibbonMenuItem> MenuItems(int index) => new[]
    {
        RibbonMenus.Item("new", "새 슬라이드"),
        RibbonMenus.Separator(),
        RibbonMenus.Item("duplicate", "복제"),
        RibbonMenus.Item("up", "위로 이동", disabled: index == 0, reason: "맨 위 슬라이드예요."),
        RibbonMenus.Item("down", "아래로 이동", disabled: index >= Count - 1, reason: "맨 아래 슬라이드예요."),
        RibbonMenus.Separator(),
        RibbonMenus.Item("delete", "삭제", disabled: Count <= 1, reason: "슬라이드를 하나는 남겨 두어야 해요."),
    };

    private void OpenMenu(MouseEventArgs e, int index)
    {
        _menuIndex = index;
    }

    private Task CloseMenu(bool _)
    {
        _menuIndex = -1;
        return Task.CompletedTask;
    }

    private async Task PickMenuAsync(string action)
    {
        var index = _menuIndex;
        _menuIndex = -1;
        if (index >= 0 && index < Count && action != null)
            await OnSlideAction.InvokeAsync((action, index));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var focus = _focusIndex;
        _focusIndex = -1;
        var moved = firstRender ? ActiveIndex > 0 : ActiveIndex != _shownIndex;
        _shownIndex = ActiveIndex;

        if (focus >= 0 && focus < Count)
            await JS.InvokeVoidAsync("docuHelper.focus", "#" + ThumbId(focus));
        else if (moved && ActiveIndex >= 0 && ActiveIndex < Count)
            await JS.InvokeVoidAsync("docuHelper.scrollIntoView", "#" + ThumbId(ActiveIndex));
    }

    private string ThumbId(int index) => $"{_uid}-{index}";

    private static string ThumbLabel(int index, bool changed) =>
        changed ? $"{index + 1}번 슬라이드, 도우미가 고침" : $"{index + 1}번 슬라이드";

    private bool IsChanged(SlideModel slide) => LiveChanges != null && slide.ChangeIds().Any(id => LiveChanges.Contains(id));

    private Task SelectSlide(int index) => OnSelect.InvokeAsync(index);

    private Task HandleKey(KeyboardEventArgs e, int index)
    {
        if (e.Key == "Delete" && Count > 1)
            return OnSlideAction.InvokeAsync(("delete", index));

        if (e.AltKey && e.Key == "ArrowUp" && index > 0)
            return OnSlideAction.InvokeAsync(("up", index));

        if (e.AltKey && e.Key == "ArrowDown" && index < Count - 1)
            return OnSlideAction.InvokeAsync(("down", index));

        var target = e.Key switch
        {
            "ArrowUp" => index - 1,
            "ArrowDown" => index + 1,
            "Home" => 0,
            "End" => Count - 1,
            _ => -1,
        };

        if (target < 0 || target >= Count || target == index)
            return Task.CompletedTask;

        _focusIndex = target;
        return OnSelect.InvokeAsync(target);
    }
}
