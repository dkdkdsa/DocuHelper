@inherits StoreComponentBase
@inject IJSRuntime JS

<div class="composer" inert="@IsCovered">
    <div class="limit-live" aria-live="polite">
        @if (IsBlocked)
        {
            <div class="limit">
                <Icon Name="pause-circle" Size="18" Stroke="2.4" />
                <span class="limit-text">
                    <b>이번 달 쓸 수 있는 양을 다 썼어요</b>
                    <span>@(Usage.NextResetText)에 다시 부탁할 수 있어요. 파일은 그대로 고치고 저장할 수 있어요.</span>
                </span>
            </div>
        }
    </div>
    @if (Chips.Count > 0)
    {
        <div class="chips">
            @foreach (var chip in Chips)
            {
                <ContextChip Model="chip" Variant="composer" />
            }
        </div>
    }
    <div class="wrap" @onkeydown="OnWrapKeyDownAsync">
        @if (OpenMenu == ModelMenu)
        {
            <div class="menu-scrim" @onclick="CloseMenuAsync"></div>
            <section id="composer-model-pop" class="pop" aria-labelledby="composer-model-h">
                <div class="pop-head">
                    <h3 id="composer-model-h">모델</h3>
                    <span class="pop-sub">다음 부탁부터 바뀌어요. 비용은 Sonnet 5.5 기준이에요</span>
                </div>
                @foreach (var provider in s_modelGroups)
                {
                    if (Settings.HasKey(provider))
                    {
                        <p class="group-label @(provider == DocuHelper.Agents.AgentProvider.OpenAi ? "gpt" : null)">@GroupName(provider)</p>
                        <ul class="options">
                            @foreach (var option in AssistantModels.For(provider))
                            {
                                var on = option.Id == Settings.Model.Id;
                                <li @key="option.Id">
                                    <button type="button" class="option @(provider == DocuHelper.Agents.AgentProvider.Claude ? "claude" : null) @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @onclick="() => PickModelAsync(option)">
                                        <span class="radio" aria-hidden="true"><span class="dot"></span></span>
                                        <span class="option-text">
                                            <span class="option-top">
                                                <span class="option-name">@option.Name</span>
                                                @if (option.IsDefault)
                                                {
                                                    <span class="default-tag">기본</span>
                                                }
                                                <span class="option-cost">@option.Cost</span>
                                            </span>
                                            <span class="option-desc">@option.Description</span>
                                        </span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                }
            </section>
        }
        @if (OpenMenu == EffortMenu)
        {
            <div class="menu-scrim" @onclick="CloseMenuAsync"></div>
            <section id="composer-effort-pop" class="pop" aria-labelledby="composer-effort-h">
                <div class="pop-head">
                    <h3 id="composer-effort-h">노력</h3>
                    <span class="pop-sub">도우미가 얼마나 깊이 생각할지예요. 다음 부탁부터 바뀌어요</span>
                </div>
                <ul class="options">
                    @foreach (var option in AssistantModels.Efforts)
                    {
                        var on = option.Id == Settings.EffortId;
                        <li @key="option.Id">
                            <button type="button" class="option @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @onclick="() => PickEffortAsync(option)">
                                <span class="radio" aria-hidden="true"><span class="dot"></span></span>
                                <span class="option-text">
                                    <span class="option-top">
                                        <span class="option-name">@option.Name</span>
                                        @if (option.IsDefault)
                                        {
                                            <span class="default-tag">기본</span>
                                        }
                                    </span>
                                    <span class="option-desc">@option.Description</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }
        @if (Assistant.IsDashMode && !IsWorking)
        {
            <div class="dash-pick">
                <div class="dash-sources">
                    <span class="dash-label">읽을 엑셀</span>
                    @foreach (var name in Assistant.DashSources)
                    {
                        <span class="dash-file" @key="name"><Icon Name="sheet" Size="14" Stroke="2" />@name</span>
                    }
                    <button type="button" class="dash-link" aria-expanded="@(_sourcesOpen ? "true" : "false")" @onclick="() => _sourcesOpen = !_sourcesOpen">바꾸기</button>
                </div>
                @if (_sourcesOpen)
                {
                    <fieldset class="dash-files">
                        <legend>대시보드가 읽을 엑셀</legend>
                        <p class="dash-hint">읽기만 하고 바꾸지 않아요.</p>
                        @foreach (var name in Assistant.ExcelFiles)
                        {
                            var on = Assistant.DashSources.Contains(name);
                            <label class="dash-check" @key="name">
                                <input type="checkbox" checked="@on" @onchange="() => Assistant.ToggleDashSource(name)" />
                                <span>@name</span>
                            </label>
                        }
                        <button type="button" class="dash-done" @onclick="() => _sourcesOpen = false">다 골랐어요</button>
                    </fieldset>
                }
                @if (Assistant.DashSources.Count == 0)
                {
                    <p class="dash-warn">읽을 엑셀을 하나 이상 골라 주세요.</p>
                }
                <fieldset class="dash-shapes">
                    <legend>어떤 모양으로 만들까요?</legend>
                    <div class="dash-grid">
                        @foreach (var template in DocuHelper.Dash.DashTemplates.All)
                        {
                            var on = template.Id == Assistant.DashTemplateId;
                            <label class="dash-shape @(on ? "on" : null)" @key="template.Id">
                                <input type="radio" name="dash-template" class="sr-only" checked="@on" @onchange="() => Assistant.PickDashTemplate(template.Id)" />
                                <DashTemplateThumb Template="@template.Id" />
                                <span>@template.Title</span>
                                @if (on)
                                {
                                    <span class="dash-mark" aria-hidden="true"><Icon Name="check" Size="11" Stroke="3" /></span>
                                }
                            </label>
                        }
                    </div>
                    <p class="dash-desc">@(DocuHelper.Dash.DashTemplates.Find(Assistant.DashTemplateId)?.Description)</p>
                </fieldset>
                <div class="dash-extras" role="group" aria-labelledby="dash-extras-h">
                    <span id="dash-extras-h" class="dash-label">바꿔 볼 것 더하기</span>
                    @foreach (var extra in AssistantStore.DashExtras)
                    {
                        var on = Assistant.HasDashExtra(extra.Sentence);
                        <button type="button" class="dash-extra @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" @onclick="() => Assistant.ToggleDashExtra(extra.Sentence)">
                            <Icon Name="@(on ? "check" : "plus")" Size="14" Stroke="2.4" />@extra.Label
                        </button>
                    }
                </div>
            </div>
        }
        <div class="box @(IsBlocked ? "off" : null) @(Assistant.IsDashMode ? "dm" : null)">
            @if (Assistant.Attachments.Count > 0)
            {
                <ul class="attachments" aria-label="붙인 파일">
                    @foreach (var item in Assistant.Attachments)
                    {
                        <li @key="item.Id"><AttachmentTile Model="item" OnRemove="() => RemoveAttachmentAsync(item)" /></li>
                    }
                </ul>
            }
            <label class="sr-only" for="composer-input">도우미에게 보낼 말</label>
            <textarea id="composer-input" class="input" rows="2" placeholder="@Placeholder" disabled="@(IsWorking || IsBlocked)" data-region-focus="@RegionFocus" @ref="_input" @oninput="OnInput" @onkeydown="OnKeyDownAsync"></textarea>
            <div class="bar">
                <IconButton Icon="paperclip" Label="파일 더하기" Title="파일 더하기 · 그림은 Ctrl+V로 붙여 넣어도 돼요" IconSize="18" OnClick="AddFilesAsync" />
                @if (Assistant.ShowsDashButton)
                {
                    <button type="button" class="dash-toggle @(Assistant.IsDashMode ? "on" : null)" aria-pressed="@(Assistant.IsDashMode ? "true" : "false")" title="@DashTitle" disabled="@(!Assistant.IsDashMode && Assistant.DashBlocker != null)" @onclick="ToggleDash">
                        <Icon Name="dashboard" Size="18" Stroke="2" />대시보드
                    </button>
                }
                @if (Assistant.IsDashMode)
                {
                    <ActionButton Kind="ButtonKind.Primary" Icon="dashboard" IconSize="15" IconStroke="2.2" Class="send" Disabled="@(!Assistant.CanSendDashboard)" OnClick="SendDashboardAsync">대시보드 만들기</ActionButton>
                }
                else
                {
                    <ActionButton Kind="ButtonKind.Primary" Icon="send" IconSize="15" IconStroke="2.2" Class="send" Disabled="@(!Assistant.CanSend)" OnClick="SendAsync">보내기</ActionButton>
                }
            </div>
        </div>
        <div class="under">
            <button type="button" id="composer-model-btn" class="pick" aria-label="@($"모델 {Settings.Model.Name}")" aria-expanded="@(OpenMenu == ModelMenu ? "true" : "false")" aria-controls="composer-model-pop" disabled="@PickDisabled" @onclick="ToggleModel">
                @Settings.Model.Name
                <Icon Name="chevron-down" Size="14" Stroke="2.2" Class="@(OpenMenu == ModelMenu ? "flip" : null)" />
            </button>
            <button type="button" id="composer-effort-btn" class="pick" aria-label="@($"노력 {Settings.Effort.Name}")" aria-expanded="@(OpenMenu == EffortMenu ? "true" : "false")" aria-controls="composer-effort-pop" disabled="@PickDisabled" @onclick="ToggleEffort">
                <span class="pick-label">노력</span>
                @Settings.Effort.Name
                <Icon Name="chevron-down" Size="14" Stroke="2.2" Class="@(OpenMenu == EffortMenu ? "flip" : null)" />
            </button>
        </div>
    </div>
</div>

@code {
    private const string ModulePath = "./Components/Assistant/Composer.razor.js";
    private const string FilesModulePath = "./js/attachments.js";
    private const string WorkingPlaceholder = "도우미가 일하는 중이에요";
    private const string RevisePlaceholder = "어떻게 고칠지 적어 주세요. 예: 합계 줄은 빼 줘";
    private const string DashPlaceholder = "더 넣을 걸 적어 주세요. 비워 두면 이 모양에 이야기한 내용만 채워요";
    private const string ModelMenu = "model";
    private const string EffortMenu = "effort";
    private static readonly DocuHelper.Agents.AgentProvider[] s_modelGroups = { DocuHelper.Agents.AgentProvider.Claude, DocuHelper.Agents.AgentProvider.OpenAi };

    private ElementReference _input;
    private IJSObjectReference _module;
    private IJSObjectReference _files;
    private bool _enterGuarded;
    private bool _dropNextInput;
    private string _shownDraft = string.Empty;
    private string _menu;
    private bool _sourcesOpen;

    private string DashTitle => Assistant.IsDashMode
        ? "대시보드 만들기 끄기 (Esc)"
        : Assistant.DashBlocker ?? "지금까지 이야기한 내용으로 대시보드 만들기";

    private IReadOnlyList<ContextChipModel> Chips => Assistant.ContextChips;

    private bool IsWorking => Assistant.Status == AssistantStatus.Working;

    private bool IsCovered => Assistant.IsPopupOpen && Assistant.PendingQuestion != null;

    private bool IsBlocked => Assistant.IsUsageBlocked && !Assistant.IsBusy;

    private bool PickDisabled => Assistant.IsBusy || Assistant.IsRunning;

    private string OpenMenu => PickDisabled ? null : _menu;

    private string Placeholder
    {
        get
        {
            if (IsWorking)
                return WorkingPlaceholder;

            if (Assistant.IsDashMode)
                return DashPlaceholder;

            if (Assistant.IsRevising && Assistant.Status != AssistantStatus.Asking)
                return RevisePlaceholder;

            return Assistant.ComposerPlaceholder;
        }
    }

    private string RegionFocus => IsWorking || Assistant.IsPopupOpen ? null : string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
                await _module.InvokeVoidAsync("guardEnter", _input);
                _enterGuarded = true;
            }
            catch (JSException)
            {
                _enterGuarded = false;
            }
        }

        await ShowDraftAsync();
    }

    private async Task ShowDraftAsync()
    {
        var draft = Assistant.Draft ?? string.Empty;
        if (_module == null || draft == _shownDraft)
            return;

        _shownDraft = draft;
        try
        {
            await _module.InvokeVoidAsync("setValue", _input, draft);
        }
        catch (JSException e)
        {
            AppLog.Write("Could not show the draft", e);
        }
    }

    private static string GroupName(DocuHelper.Agents.AgentProvider provider) => provider == DocuHelper.Agents.AgentProvider.OpenAi ? "ChatGPT" : "Claude";

    private void ToggleModel() => _menu = _menu == ModelMenu ? null : ModelMenu;

    private void ToggleEffort() => _menu = _menu == EffortMenu ? null : EffortMenu;

    private async Task PickModelAsync(ModelOption option)
    {
        Settings.SetModel(option.Id);
        _menu = null;
        await FocusAsync("#composer-model-btn");
    }

    private async Task PickEffortAsync(EffortOption option)
    {
        Settings.SetEffort(option.Id);
        _menu = null;
        await FocusAsync("#composer-effort-btn");
    }

    private async Task CloseMenuAsync()
    {
        var menu = _menu;
        _menu = null;
        if (menu != null)
            await FocusAsync(menu == ModelMenu ? "#composer-model-btn" : "#composer-effort-btn");
    }

    private async Task OnWrapKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _menu != null)
            await CloseMenuAsync();
        else if (e.Key == "Escape" && Assistant.IsDashMode)
            Assistant.StopDashMode();
    }

    private void ToggleDash()
    {
        _sourcesOpen = false;
        Assistant.ToggleDashMode();
    }

    private async Task SendDashboardAsync()
    {
        _menu = null;
        _sourcesOpen = false;
        await Assistant.SendDashboardAsync();
        await JS.InvokeVoidAsync("docuHelper.focus", "#composer-input");
    }

    private void OnInput(ChangeEventArgs e)
    {
        if (_dropNextInput)
        {
            _dropNextInput = false;
            return;
        }

        _shownDraft = e.Value?.ToString() ?? string.Empty;
        Assistant.SetDraft(_shownDraft);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        var plainEnter = e.Key == "Enter" && !e.ShiftKey && !e.CtrlKey && !e.AltKey && !e.MetaKey && !e.IsComposing;
        if (!plainEnter)
        {
            _dropNextInput = false;
            return;
        }

        if (Assistant.IsDashMode)
        {
            if (!Assistant.CanSendDashboard)
                return;

            _dropNextInput = !_enterGuarded;
            await Assistant.SendDashboardAsync();
            return;
        }

        if (!Assistant.CanSend)
            return;

        _dropNextInput = !_enterGuarded;
        await SubmitAsync();
    }

    private async Task SendAsync()
    {
        await SubmitAsync();
        await JS.InvokeVoidAsync("docuHelper.focus", "#composer-input");
    }

    private async Task SubmitAsync()
    {
        _menu = null;
        await Assistant.SendAsync();
        Assistant.StopRevising();
    }

    private async Task AddFilesAsync()
    {
        try
        {
            _files ??= await JS.InvokeAsync<IJSObjectReference>("import", FilesModulePath);
            await _files.InvokeVoidAsync("pick");
        }
        catch (JSException e)
        {
            AppLog.Write("File picker failed", e);
        }
    }

    private async Task RemoveAttachmentAsync(AttachmentModel item)
    {
        Assistant.RemoveAttachment(item.Id);
        await FocusAsync("#composer-input");
    }

    private async Task FocusAsync(string selector)
    {
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("docuHelper.focus", selector);
        }
        catch (JSException)
        {
        }
    }

    protected override void OnDispose()
    {
        if (_module != null)
            _ = ReleaseModuleAsync(_module);

        if (_files != null)
            _ = ReleaseModuleAsync(_files);
    }

    private static async Task ReleaseModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
