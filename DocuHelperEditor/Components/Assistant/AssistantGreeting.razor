@inherits StoreComponentBase
@inject IJSRuntime JS

<div class="greeting" inert="@IsCovered">
    <div class="hello">
        <div class="who">
            <AssistantAvatar Size="24" />
            <span class="name">도우미</span>
        </div>
        <p class="hello-text">안녕하세요. 파일을 넣으시면 같이 볼게요. 파일 없이 새 문서를 만들어 달라고 하셔도 돼요.</p>
    </div>
    @if (Assistant.Examples.Count > 0)
    {
        <div class="examples">
            <h3 class="examples-title">이렇게 부탁해 보세요</h3>
            @for (var i = 0; i < Assistant.Examples.Count; i++)
            {
                var index = i;
                var text = Assistant.Examples[i];
                <button type="button" class="example" @onclick="() => UseExampleAsync(text)">
                    @if (index < 3)
                    {
                        <FileTypeIcon Type="@TypeAt(index)" Size="28" Variant="chat" />
                    }
                    else
                    {
                        <span class="new-icon" aria-hidden="true">
                            <Icon Name="plus" Size="15" Stroke="2.2" />
                        </span>
                    }
                    @text
                </button>
            }
        </div>
    }
</div>

@code {
    private bool IsCovered => Assistant.IsPopupOpen && Assistant.PendingQuestion != null;

    private static DocuType TypeAt(int index) => index switch
    {
        0 => DocuType.Excel,
        1 => DocuType.Word,
        _ => DocuType.Ppt,
    };

    private async Task UseExampleAsync(string text)
    {
        Assistant.UseExample(text);
        await JS.InvokeVoidAsync("docuHelper.focus", "#composer-input");
    }
}
