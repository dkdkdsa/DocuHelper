<svg class="thumb" viewBox="0 0 64 45" width="@Width" height="@(Width * 45 / 64)" aria-hidden="true" focusable="false">
    <rect x="0.75" y="0.75" width="62.5" height="43.5" rx="3" fill="#FFFFFF" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.5" />
    <rect x="5" y="5" width="16" height="2.5" rx="1" fill="currentColor" fill-opacity="0.5" />
    @switch (Template)
    {
        case "chart":
            @for (var i = 0; i < 11; i++)
            {
                var h = s_chartBars[i];
                <rect x="@(5 + i * 5)" y="@(25.6 - h)" width="3" height="@h" fill="currentColor" />
            }
            <rect x="5" y="25.6" width="54" height="0.8" fill="currentColor" fill-opacity="0.5" />
            @for (var i = 0; i < 3; i++)
            {
                <rect x="5" y="@(29 + i * 4.5)" width="@(22 - i * 6)" height="2.5" fill="currentColor" fill-opacity="@(i == 0 ? 1 : 0.55)" />
                <rect x="34" y="@(29 + i * 4.5)" width="@(20 - i * 5)" height="2.5" fill="currentColor" fill-opacity="@(i == 0 ? 1 : 0.55)" />
            }
            break;
        case "cards":
            @for (var i = 0; i < 8; i++)
            {
                var x = 5 + i % 4 * 13.6;
                var y = 10 + i / 4 * 16.5;
                <rect x="@x" y="@y" width="12" height="14.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="0.8" />
                <rect x="@x" y="@y" width="12" height="5.5" rx="1.2" fill="currentColor" fill-opacity="0.22" />
                <rect x="@(x + 1.6)" y="@(y + 7.3)" width="7" height="1.6" fill="currentColor" />
                <rect x="@(x + 1.6)" y="@(y + 10.6)" width="5" height="2" rx="0.6" fill="currentColor" fill-opacity="0.45" />
            }
            break;
        case "table":
            <rect x="5" y="10" width="54" height="4" fill="currentColor" fill-opacity="0.25" />
            @for (var i = 0; i < 3; i++)
            {
                var y = 16.5 + i * 6.5;
                <rect x="7" y="@y" width="14" height="2" fill="currentColor" fill-opacity="0.7" />
                <rect x="40" y="@y" width="17" height="2" fill="currentColor" fill-opacity="0.7" />
                <rect x="5" y="@(y + 4.5)" width="54" height="0.5" fill="currentColor" fill-opacity="0.35" />
            }
            <rect x="5" y="35.6" width="54" height="0.8" fill="currentColor" />
            <rect x="5" y="40.6" width="54" height="0.8" fill="currentColor" />
            <rect x="7" y="37.6" width="10" height="2" fill="currentColor" />
            <rect x="40" y="37.6" width="17" height="2" fill="currentColor" />
            break;
        default:
            <rect x="5" y="10" width="21" height="5.5" fill="currentColor" />
            <rect x="5" y="18.5" width="23" height="2" fill="currentColor" fill-opacity="0.25" />
            <rect x="5" y="18.5" width="16" height="2" fill="currentColor" />
            @for (var i = 0; i < 7; i++)
            {
                var h = s_summaryBars[i];
                <rect x="@(5 + i * 3.4)" y="@(40 - h)" width="2.4" height="@h" fill="currentColor" />
            }
            @for (var i = 0; i < 5; i++)
            {
                <rect x="33" y="@(10 + i * 6)" width="@s_rankBars[i]" height="2.5" fill="currentColor" fill-opacity="@(i == 0 ? 1 : 0.55)" />
            }
            break;
    }
</svg>

@code {
    private static readonly double[] s_chartBars = { 8, 11, 6, 13, 9, 15, 10, 7, 12, 9, 14 };
    private static readonly double[] s_summaryBars = { 9, 13, 7, 11, 15, 10, 6 };
    private static readonly double[] s_rankBars = { 26, 20, 13, 10, 7 };

    [Parameter]
    public string Template { get; set; }

    [Parameter]
    public double Width { get; set; } = 64;
}
