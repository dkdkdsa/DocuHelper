<li class="msg">
    <div class="who">
        <AssistantAvatar Size="24" />
        <span class="name">도우미</span>
    </div>
    @if (Entry.Progress != null && Entry.Progress.IsFinished)
    {
        <TaskSteps Entry="Entry" />
    }
    @if (!string.IsNullOrEmpty(Entry.Text))
    {
        <div class="text">@((MarkupString)Html())</div>
    }
    @if (!string.IsNullOrEmpty(Entry.AskedQuestion))
    {
        <div class="asked">
            <span class="asked-glyph" aria-hidden="true">?</span>
            <span class="asked-body">
                <span class="asked-title">여쭤본 것</span>
                <span>@Entry.AskedQuestion</span>
            </span>
        </div>
    }
    @if (Entry.Progress != null && !Entry.Progress.IsFinished)
    {
        <TaskSteps Entry="Entry" />
    }
    @if (Entry.Result != null)
    {
        <ResultCard Result="Entry.Result" />
    }
    @if (Entry.Error != null)
    {
        <ErrorNotice Error="Entry.Error" />
    }
</li>

@code {
    [Parameter]
    public ChatEntry Entry { get; set; }

    private string _source;
    private string _html;

    private string Html()
    {
        if (_source != Entry.Text)
        {
            _source = Entry.Text;
            _html = MarkdownRenderer.ToHtml(_source);
        }
        return _html;
    }
}
